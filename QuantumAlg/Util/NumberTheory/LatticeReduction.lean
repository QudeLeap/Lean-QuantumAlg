  have hdenominatorPos : 1 ≤ basis.secondReductionDenominator := by
    have hareaOne : 1 ≤ integerPointAreaSquared basis.first basis.second :=
      Nat.one_le_iff_ne_zero.mpr hareaNe
    simpa [IntegerBasis3.secondReductionDenominator] using
      (show (1 : Int) ≤ (integerPointAreaSquared basis.first basis.second : Int) by
        exact_mod_cast hareaOne)
  have hsecondCoefficient : secondCoefficient.natAbs ≤
      24 * (bound + 1) ^ 4 := by
    dsimp only [secondCoefficient]
    calc
      (nearestIntegerCoefficient basis.secondReductionNumerator
