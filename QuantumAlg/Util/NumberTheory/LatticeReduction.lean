  have hthirdFirstEvents : ∀ event ∈ thirdFirst.events,
      event.OperandsLe envelope := by
    have hraw := integerPointDotExecution_events_operandsLe hbthird hbfirst
    apply arithmeticEventsOperandsLe_mono hraw
    simpa only [Y, pow_two, Nat.mul_assoc] using hthreeYSquaredEnvelope
  have hthirdFirstSecondFirstEvents :
      ∀ event ∈ thirdFirstSecondFirst.events,
        event.OperandsLe envelope :=
    intMulExecution_events_operandsLe
      (hthirdFirst.trans hthreeYSquaredEnvelope)
      (hsecondFirst.trans hthreeYSquaredEnvelope)
  have hsecondReductionNumeratorEvents :
      ∀ event ∈ secondReductionNumerator.events,
        event.OperandsLe envelope :=
    intSubExecution_events_operandsLe
      (hnormThirdSecond.trans
        (hbasisMonomial (by norm_num) (by norm_num)))
      (hthirdFirstSecondFirst.trans
        (hbasisMonomial (by norm_num) (by norm_num)))
  have hscaledSecondReductionEvents :
      ∀ event ∈ scaledSecondReduction.events,
        event.OperandsLe envelope :=
    intMulExecution_events_operandsLe
      (hthirdCoefficient.trans (hmonomial (by norm_num) (by norm_num)))
      (hsecondReductionNumerator.trans
        (hbasisMonomial (by norm_num) (by norm_num)))
  have hsecondNumeratorEvents : ∀ event ∈ secondNumerator.events,
      event.OperandsLe envelope :=
    intSubExecution_events_operandsLe
      (hsecondCoordinateNumerator.trans
        (hmonomial (by norm_num) (by norm_num)))
      (hscaledSecondReduction.trans
        (hmonomial (by norm_num) (by norm_num)))
  have hfirstSecondAreaEvents : ∀ event ∈ firstSecondArea.events,
      event.OperandsLe envelope := by
    have hraw := integerPointSquaredNormExecution_events_operandsLe
      hcrossCoordinates
    apply arithmeticEventsOperandsLe_mono hraw
    calc
      3 * (2 * Y ^ 2 + 1) ^ 2 ≤ 3 * (3 * Y ^ 2) ^ 2 :=
        Nat.mul_le_mul_left 3
          (Nat.pow_le_pow_left hcrossCoordinateSucc 2)
      _ = 27 * Y ^ 4 := by ring
      _ ≤ envelope := hbasisMonomial (by norm_num) (by norm_num)
  have hsecondCoefficientEvents : ∀ event ∈ secondCoefficient.events,
      event.OperandsLe envelope := by
    exact roundedDivExecution_events_operandsLe
      (hsecondNumerator.trans (hmonomial (by norm_num) (by norm_num)))
      (by simpa using hfirstSecondAreaEnvelope)
  have hscaledSecondFirstEvents : ∀ event ∈ scaledSecondFirst.events,
      event.OperandsLe envelope :=
    intMulExecution_events_operandsLe
      (hsecondCoefficient.trans (hmonomial (by norm_num) (by norm_num)))
      (hsecondFirst.trans hthreeYSquaredEnvelope)
  have hscaledThirdFirstEvents : ∀ event ∈ scaledThirdFirst.events,
      event.OperandsLe envelope :=
    intMulExecution_events_operandsLe
      (hthirdCoefficient.trans (hmonomial (by norm_num) (by norm_num)))
      (hthirdFirst.trans hthreeYSquaredEnvelope)
  have hafterSecondEvents : ∀ event ∈ afterSecond.events,
      event.OperandsLe envelope :=
    intSubExecution_events_operandsLe
      htargetFirstEnvelope
      (hscaledSecondFirst.trans
        (hmonomial (by norm_num) (by norm_num)))
  have hfirstNumeratorEvents : ∀ event ∈ firstNumerator.events,
      event.OperandsLe envelope :=
    intSubExecution_events_operandsLe
      (hafterSecond.trans (hmonomial (by norm_num) (by norm_num)))
      (hscaledThirdFirst.trans
        (hmonomial (by norm_num) (by norm_num)))
  have hfirstCoefficientEvents : ∀ event ∈ firstCoefficient.events,
      event.OperandsLe envelope := by
    exact roundedDivExecution_events_operandsLe
      (hfirstNumerator.trans (hmonomial (by norm_num) (by norm_num)))
      (by simpa using hnormFirstEnvelope)

  have hall01 := arithmeticEventsOperandsLe_append
    hcrossEvents hthirdNumeratorEvents
  have hall02 := arithmeticEventsOperandsLe_append
    hall01 hthirdDenominatorEvents
  have hall03 := arithmeticEventsOperandsLe_append
    hall02 hthirdCoefficientEvents
  have hall04 := arithmeticEventsOperandsLe_append hall03 hnormFirstEvents
  have hall05 := arithmeticEventsOperandsLe_append hall04 htargetSecondEvents
  have hall06 := arithmeticEventsOperandsLe_append
    hall05 hnormTargetSecondEvents
  have hall07 := arithmeticEventsOperandsLe_append hall06 hsecondFirstEvents
  have hall08 := arithmeticEventsOperandsLe_append hall07 htargetFirstEvents
  have hall09 := arithmeticEventsOperandsLe_append
    hall08 hsecondFirstTargetFirstEvents
  have hall10 := arithmeticEventsOperandsLe_append
    hall09 hsecondCoordinateNumeratorEvents
  have hall11 := arithmeticEventsOperandsLe_append hall10 hthirdSecondEvents
  have hall12 := arithmeticEventsOperandsLe_append
    hall11 hnormThirdSecondEvents
  have hall13 := arithmeticEventsOperandsLe_append hall12 hthirdFirstEvents
  have hall14 := arithmeticEventsOperandsLe_append
    hall13 hthirdFirstSecondFirstEvents
  have hall15 := arithmeticEventsOperandsLe_append
    hall14 hsecondReductionNumeratorEvents
  have hall16 := arithmeticEventsOperandsLe_append
    hall15 hscaledSecondReductionEvents
  have hall17 := arithmeticEventsOperandsLe_append hall16 hsecondNumeratorEvents
  have hall18 := arithmeticEventsOperandsLe_append
    hall17 hfirstSecondAreaEvents
  have hall19 := arithmeticEventsOperandsLe_append
    hall18 hsecondCoefficientEvents
  have hall20 := arithmeticEventsOperandsLe_append
    hall19 hscaledSecondFirstEvents
  have hall21 := arithmeticEventsOperandsLe_append
    hall20 hscaledThirdFirstEvents
  have hall22 := arithmeticEventsOperandsLe_append hall21 hafterSecondEvents
  have hall23 := arithmeticEventsOperandsLe_append
    hall22 hfirstNumeratorEvents
  have hall24 := arithmeticEventsOperandsLe_append
    hall23 hfirstCoefficientEvents

  change
    (∀ event ∈ firstSecondCross.events ++ thirdNumerator.events ++
        thirdDenominator.events ++ thirdCoefficient.events ++
        normFirst.events ++ targetSecond.events ++
        normTargetSecond.events ++ secondFirst.events ++ targetFirst.events ++
        secondFirstTargetFirst.events ++ secondCoordinateNumerator.events ++
        thirdSecond.events ++ normThirdSecond.events ++ thirdFirst.events ++
        thirdFirstSecondFirst.events ++ secondReductionNumerator.events ++
        scaledSecondReduction.events ++ secondNumerator.events ++
        firstSecondArea.events ++ secondCoefficient.events ++
        scaledSecondFirst.events ++ scaledThirdFirst.events ++
        afterSecond.events ++ firstNumerator.events ++ firstCoefficient.events,
      event.OperandsLe envelope) ∧
      IntegerPoint3.CoordinatesLe
        (firstCoefficient.value, secondCoefficient.value,
          thirdCoefficient.value) envelope
  constructor
  · exact hall24
  · exact ⟨hfirstCoefficient.trans
        (hmonomial (by norm_num) (by norm_num)),
      hsecondCoefficient.trans (hmonomial (by norm_num) (by norm_num)),
      hthirdCoefficient.trans (hmonomial (by norm_num) (by norm_num))⟩

/-- Magnitude bounds for the six operands given to the three rounded divisions
in the exact three-dimensional nearest-plane calculation. -/
structure NearestPlaneDivisionOperandsLe
    (basis : IntegerBasis3) (target : IntegerPoint3) (bound : Nat) : Prop where
  thirdNumerator :
    (integerPointDot target
      (integerPointCross basis.first basis.second)).natAbs ≤ bound
  thirdDenominator :
    (integerPointDot basis.third
      (integerPointCross basis.first basis.second)).natAbs ≤ bound
  secondNumerator :
    ((integerPointSquaredNorm basis.first : Int) *
          integerPointDot target basis.second -
        integerPointDot basis.second basis.first *
          integerPointDot target basis.first -
        basis.nearestPlaneThirdCoefficient target *
          basis.secondReductionNumerator).natAbs ≤ bound
  secondDenominator : basis.secondReductionDenominator.natAbs ≤ bound
  firstNumerator :
    (integerPointDot target basis.first -
      basis.nearestPlaneSecondCoefficient target *
        integerPointDot basis.second basis.first -
      basis.nearestPlaneThirdCoefficient target *
        integerPointDot basis.third basis.first).natAbs ≤ bound
  firstDenominator : (integerPointSquaredNorm basis.first : Int).natAbs ≤ bound

/-- Binary-width bounds for the six operands given to the three rounded
divisions in the exact three-dimensional nearest-plane calculation. -/
structure NearestPlaneDivisionOperandWidthsLe
    (basis : IntegerBasis3) (target : IntegerPoint3) (width : Nat) : Prop where
  thirdNumerator :
    Nat.size (integerPointDot target
      (integerPointCross basis.first basis.second)).natAbs ≤ width
  thirdDenominator :
    Nat.size (integerPointDot basis.third
      (integerPointCross basis.first basis.second)).natAbs ≤ width
  secondNumerator :
    Nat.size ((integerPointSquaredNorm basis.first : Int) *
          integerPointDot target basis.second -
        integerPointDot basis.second basis.first *
          integerPointDot target basis.first -
        basis.nearestPlaneThirdCoefficient target *
          basis.secondReductionNumerator).natAbs ≤ width
  secondDenominator : Nat.size basis.secondReductionDenominator.natAbs ≤ width
  firstNumerator :
    Nat.size (integerPointDot target basis.first -
      basis.nearestPlaneSecondCoefficient target *
        integerPointDot basis.second basis.first -
      basis.nearestPlaneThirdCoefficient target *
        integerPointDot basis.third basis.first).natAbs ≤ width
  firstDenominator :
    Nat.size (integerPointSquaredNorm basis.first : Int).natAbs ≤ width

/-- A common magnitude envelope yields the corresponding binary-width
envelope for all nearest-plane division operands. -/
theorem NearestPlaneDivisionOperandsLe.toWidths
    {basis : IntegerBasis3} {target : IntegerPoint3} {bound width : Nat}
    (hoperands : NearestPlaneDivisionOperandsLe basis target bound)
    (hwidth : Nat.size bound ≤ width) :
    NearestPlaneDivisionOperandWidthsLe basis target width := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (Nat.size_le_size hoperands.thirdNumerator).trans hwidth
  · exact (Nat.size_le_size hoperands.thirdDenominator).trans hwidth
  · exact (Nat.size_le_size hoperands.secondNumerator).trans hwidth
  · exact (Nat.size_le_size hoperands.secondDenominator).trans hwidth
  · exact (Nat.size_le_size hoperands.firstNumerator).trans hwidth
  · exact (Nat.size_le_size hoperands.firstDenominator).trans hwidth

/-- The audited nearest-plane execution bounds every operand passed to its
three literal rounded divisions by the common arithmetic envelope. -/
theorem nearestPlaneDivisionOperandsLe_of_bounds
    (basis : IntegerBasis3) (target : IntegerPoint3)
    (basisBound targetBound : Nat)
    (hfull : basis.FullRank)
    (hbasis : basis.SquaredNormsLe basisBound)
    (htarget : integerPointSquaredNorm target ≤ targetBound) :
    NearestPlaneDivisionOperandsLe basis target
      (nearestPlaneArithmeticEnvelope3 basisBound targetBound) := by
  let envelope := nearestPlaneArithmeticEnvelope3 basisBound targetBound
  change NearestPlaneDivisionOperandsLe basis target envelope
  have hevents : ∀ event ∈ (nearestPlaneExecution3 basis target).events,
      event.OperandsLe envelope := by
    simpa only [envelope] using
      (nearestPlaneExecution3_bounds basis target basisBound targetBound
        hfull hbasis htarget).1
  have hthirdOperands :
      (ArithmeticEvent.roundedDiv
        (integerPointDot target
          (integerPointCross basis.first basis.second))
        (integerPointDot basis.third
          (integerPointCross basis.first basis.second))).OperandsLe envelope := by
    apply hevents
    simp only [nearestPlaneExecution3, integerPointCrossExecution_value,
      integerPointDotExecution_value, integerPointSquaredNormExecution_value,
      intMulExecution_value, intSubExecution_value, roundedDivExecution,
      List.mem_append, List.mem_singleton]
    aesop
  have hsecondOperands :
      (ArithmeticEvent.roundedDiv
        ((integerPointSquaredNorm basis.first : Int) *
              integerPointDot target basis.second -
            integerPointDot basis.second basis.first *
              integerPointDot target basis.first -
            basis.clearedNearestPlaneThirdCoefficient target *
              basis.secondReductionNumerator)
        basis.secondReductionDenominator).OperandsLe envelope := by
    apply hevents
    simp only [nearestPlaneExecution3, integerPointCrossExecution_value,
      integerPointDotExecution_value, integerPointSquaredNormExecution_value,
      intMulExecution_value, intSubExecution_value, roundedDivExecution,
      IntegerBasis3.clearedNearestPlaneThirdCoefficient,
      IntegerBasis3.secondReductionNumerator,
      IntegerBasis3.secondReductionDenominator, integerPointAreaSquared,
      List.mem_append, List.mem_singleton]
    aesop
  have hfirstOperands :
      (ArithmeticEvent.roundedDiv
        (integerPointDot target basis.first -
          basis.clearedNearestPlaneSecondCoefficient target
              (basis.clearedNearestPlaneThirdCoefficient target) *
            integerPointDot basis.second basis.first -
          basis.clearedNearestPlaneThirdCoefficient target *
            integerPointDot basis.third basis.first)
        (integerPointSquaredNorm basis.first : Int)).OperandsLe envelope := by
    apply hevents
    simp only [nearestPlaneExecution3, integerPointCrossExecution_value,
      integerPointDotExecution_value, integerPointSquaredNormExecution_value,
      intMulExecution_value, intSubExecution_value, roundedDivExecution,
      IntegerBasis3.clearedNearestPlaneThirdCoefficient,
      IntegerBasis3.clearedNearestPlaneSecondCoefficient,
      IntegerBasis3.secondReductionNumerator,
      IntegerBasis3.secondReductionDenominator, integerPointAreaSquared,
      List.mem_append, List.mem_singleton]
    aesop
  have hthird :
      (integerPointDot target
        (integerPointCross basis.first basis.second)).natAbs ≤ envelope ∧
      (integerPointDot basis.third
        (integerPointCross basis.first basis.second)).natAbs ≤ envelope := by
    simpa only [ArithmeticEvent.OperandsLe] using hthirdOperands
  have hsecond :
      ((integerPointSquaredNorm basis.first : Int) *
            integerPointDot target basis.second -
          integerPointDot basis.second basis.first *
            integerPointDot target basis.first -
          basis.clearedNearestPlaneThirdCoefficient target *
            basis.secondReductionNumerator).natAbs ≤ envelope ∧
        basis.secondReductionDenominator.natAbs ≤ envelope := by
    simpa only [ArithmeticEvent.OperandsLe] using hsecondOperands
  have hfirst :
      (integerPointDot target basis.first -
        basis.clearedNearestPlaneSecondCoefficient target
            (basis.clearedNearestPlaneThirdCoefficient target) *
          integerPointDot basis.second basis.first -
        basis.clearedNearestPlaneThirdCoefficient target *
          integerPointDot basis.third basis.first).natAbs ≤ envelope ∧
        (integerPointSquaredNorm basis.first : Int).natAbs ≤ envelope := by
    simpa only [ArithmeticEvent.OperandsLe] using hfirstOperands
  refine ⟨hthird.1, hthird.2, ?_, hsecond.2, ?_, hfirst.2⟩
  · simpa only [IntegerBasis3.clearedNearestPlaneThirdCoefficient_eq] using
      hsecond.1
  · have hfirstNumerator := hfirst.1
    rw [basis.clearedNearestPlaneSecondCoefficient_eq target] at hfirstNumerator
    rw [basis.clearedNearestPlaneThirdCoefficient_eq target] at hfirstNumerator
    exact hfirstNumerator

/-- A sealed exact nearest-plane center and the arithmetic events emitted by
that same shared execution. -/
structure NearestPlaneTrace3 (basis : IntegerBasis3)
    (target : IntegerPoint3) where
  private mk ::
  /-- Exact Babai coefficient center. -/
  center : IntegerPoint3
  /-- Operand-derived arithmetic emitted by the shared center calculation. -/
  arithmetic : List ArithmeticEvent

/-- Execute and seal one exact nearest-plane center calculation. -/
def nearestPlaneTrace3 (basis : IntegerBasis3) (target : IntegerPoint3) :
    NearestPlaneTrace3 basis target :=
  let final := nearestPlaneExecution3 basis target
  .mk final.value final.events

/-- The sealed center is the mathematical nearest-plane center. -/
theorem nearestPlaneTrace3_center (basis : IntegerBasis3)
    (target : IntegerPoint3) :
    (nearestPlaneTrace3 basis target).center =
      basis.nearestPlaneCoefficientCenter target :=
  nearestPlaneExecution3_value basis target

/-- Exact schoolbook charge projected from the sealed nearest-plane trace. -/
def NearestPlaneTrace3.schoolbookCharge {basis : IntegerBasis3}
    {target : IntegerPoint3} (trace : NearestPlaneTrace3 basis target) : Nat :=
  arithmeticEventListCharge trace.arithmetic

/-- Largest operand width encountered by the sealed nearest-plane execution. -/
def NearestPlaneTrace3.maxOperandWidth {basis : IntegerBasis3}
    {target : IntegerPoint3} (trace : NearestPlaneTrace3 basis target) : Nat :=
  arithmeticEventListMaxOperandWidth trace.arithmetic

/-- The shared three-coordinate execution emits exactly 69 primitive
arithmetic events. -/
@[simp]
theorem nearestPlaneTrace3_arithmetic_length (basis : IntegerBasis3)
    (target : IntegerPoint3) :
    (nearestPlaneTrace3 basis target).arithmetic.length = 69 := by
  simp [nearestPlaneTrace3, nearestPlaneExecution3,
    roundedDivExecution, intMulExecution, intSubExecution]

/-- Every actual operand in the sealed nearest-plane execution has binary
width controlled by the input norm envelopes. -/
theorem nearestPlaneTrace3_maxOperandWidth_le
    (basis : IntegerBasis3) (target : IntegerPoint3)
    (basisBound targetBound : Nat)
    (hfull : basis.FullRank)
    (hbasis : basis.SquaredNormsLe basisBound)
    (htarget : integerPointSquaredNorm target ≤ targetBound) :
    (nearestPlaneTrace3 basis target).maxOperandWidth ≤
      Nat.size
        (4096 * (targetBound + 1) * (basisBound + 1) ^ 8) := by
  change arithmeticEventListMaxOperandWidth
      (nearestPlaneExecution3 basis target).events ≤ _
  exact arithmeticEventListMaxOperandWidth_le_size_of_operandsLe
    (nearestPlaneExecution3_bounds basis target basisBound targetBound
      hfull hbasis htarget).1

/-- The three center coefficients emitted by the same nearest-plane execution
are bounded by its input-derived arithmetic envelope. -/
theorem nearestPlaneTrace3_center_coordinates_le
    (basis : IntegerBasis3) (target : IntegerPoint3)
    (basisBound targetBound : Nat)
    (hfull : basis.FullRank)
    (hbasis : basis.SquaredNormsLe basisBound)
    (htarget : integerPointSquaredNorm target ≤ targetBound) :
    (nearestPlaneTrace3 basis target).center.1.natAbs ≤
        4096 * (targetBound + 1) * (basisBound + 1) ^ 8 ∧
      (nearestPlaneTrace3 basis target).center.2.1.natAbs ≤
        4096 * (targetBound + 1) * (basisBound + 1) ^ 8 ∧
      (nearestPlaneTrace3 basis target).center.2.2.natAbs ≤
        4096 * (targetBound + 1) * (basisBound + 1) ^ 8 := by
  change
    (nearestPlaneExecution3 basis target).value.1.natAbs ≤ _ ∧
      (nearestPlaneExecution3 basis target).value.2.1.natAbs ≤ _ ∧
      (nearestPlaneExecution3 basis target).value.2.2.natAbs ≤ _
  simpa only [IntegerPoint3.CoordinatesLe,
    nearestPlaneArithmeticEnvelope3] using
    (nearestPlaneExecution3_bounds basis target basisBound targetBound
      hfull hbasis htarget).2

/-- The exact 69-event nearest-plane trace has a quadratic schoolbook charge
at the input-derived operand width. -/
theorem nearestPlaneTrace3_schoolbookCharge_le
    (basis : IntegerBasis3) (target : IntegerPoint3)
    (basisBound targetBound : Nat)
    (hfull : basis.FullRank)
    (hbasis : basis.SquaredNormsLe basisBound)
    (htarget : integerPointSquaredNorm target ≤ targetBound) :
    (nearestPlaneTrace3 basis target).schoolbookCharge ≤
      276 *
        (Nat.size
          (4096 * (targetBound + 1) * (basisBound + 1) ^ 8) + 1) ^ 2 := by
  let trace := nearestPlaneTrace3 basis target
  have hwidth : trace.maxOperandWidth ≤
      Nat.size
        (4096 * (targetBound + 1) * (basisBound + 1) ^ 8) := by
    exact nearestPlaneTrace3_maxOperandWidth_le basis target
      basisBound targetBound hfull hbasis htarget
  have hlength : trace.arithmetic.length = 69 := by
    exact nearestPlaneTrace3_arithmetic_length basis target
  calc
    trace.schoolbookCharge ≤
        4 * trace.arithmetic.length *
          (trace.maxOperandWidth + 1) ^ 2 :=
      arithmeticEventListCharge_le trace.arithmetic
    _ = 276 * (trace.maxOperandWidth + 1) ^ 2 := by
      rw [hlength]
    _ ≤ 276 *
        (Nat.size
          (4096 * (targetBound + 1) * (basisBound + 1) ^ 8) + 1) ^ 2 :=
      Nat.mul_le_mul_left 276
        (Nat.pow_le_pow_left (Nat.add_le_add_right hwidth 1) 2)

/-- The third orthogonal coordinate of a basis combination is its third
integer coefficient. -/
theorem IntegerBasis3.thirdOrthogonalCoordinate_linearCombination
    (basis : IntegerBasis3) (coefficients : IntegerPoint3)
    (hdet : basis.determinant ≠ 0) :
    basis.thirdOrthogonalCoordinate
        (basis.linearCombination coefficients) = coefficients.2.2 := by
  have hdot : integerPointDot (basis.linearCombination coefficients)
      (integerPointCross basis.first basis.second) =
      coefficients.2.2 * basis.determinant := by
    rcases basis with ⟨first, second, third⟩
    rcases first with ⟨f₁, f₂, f₃⟩
    rcases second with ⟨s₁, s₂, s₃⟩
    rcases third with ⟨t₁, t₂, t₃⟩
    rcases coefficients with ⟨c₁, c₂, c₃⟩
    simp [IntegerBasis3.linearCombination, IntegerBasis3.determinant,
      integerPointDot, integerPointCross, IntegerPoint3.add,
      IntegerPoint3.smul]
    ring
  unfold IntegerBasis3.thirdOrthogonalCoordinate
  rw [hdot]
  push_cast
  rw [mul_div_cancel_right₀]
  exact_mod_cast hdet

/-- The second orthogonal coordinate of a basis combination is the second
integer coefficient plus the third coefficient times `μ₃₂`. -/
theorem IntegerBasis3.secondOrthogonalCoordinate_linearCombination
    (basis : IntegerBasis3) (coefficients : IntegerPoint3)
    (harea : integerPointAreaSquared basis.first basis.second ≠ 0) :
    basis.secondOrthogonalCoordinate
        (basis.linearCombination coefficients) =
      coefficients.2.1 +
        coefficients.2.2 * basis.secondGramSchmidtCoefficient := by
  have hnumerator :
      (integerPointSquaredNorm basis.first : Int) *
            integerPointDot (basis.linearCombination coefficients) basis.second -
          integerPointDot basis.second basis.first *
            integerPointDot (basis.linearCombination coefficients) basis.first =
        coefficients.2.1 *
            (integerPointAreaSquared basis.first basis.second : Int) +
          coefficients.2.2 * basis.secondReductionNumerator := by
    rw [basis.integerPointDot_linearCombination,
      basis.integerPointDot_linearCombination,
      integerPointDot_self, integerPointDot_self,
      integerPointDot_comm basis.first basis.second,
      show (integerPointAreaSquared basis.first basis.second : Int) =
          (integerPointSquaredNorm basis.first : Int) *
              (integerPointSquaredNorm basis.second : Int) -
            integerPointDot basis.first basis.second ^ 2 by
        exact integerPointAreaSquared_eq_gram basis.first basis.second]
    unfold IntegerBasis3.secondReductionNumerator
    rw [integerPointDot_comm basis.second basis.first,
      integerPointDot_comm basis.third basis.second,
      integerPointDot_comm basis.third basis.first]
    ring
  unfold IntegerBasis3.secondOrthogonalCoordinate
    IntegerBasis3.secondGramSchmidtCoefficient
    IntegerBasis3.secondReductionDenominator
  rw [hnumerator]
  push_cast
  field_simp

/-- The first orthogonal coordinate of a basis combination records the first
coefficient and the two first-direction Gram–Schmidt couplings. -/
theorem IntegerBasis3.firstOrthogonalCoordinate_linearCombination
    (basis : IntegerBasis3) (coefficients : IntegerPoint3)
    (hnorm : integerPointSquaredNorm basis.first ≠ 0) :
    basis.firstOrthogonalCoordinate
        (basis.linearCombination coefficients) =
      coefficients.1 +
        coefficients.2.1 * basis.firstGramSchmidtCoefficient +
        coefficients.2.2 * basis.thirdFirstGramSchmidtCoefficient := by
  have hdot := basis.integerPointDot_linearCombination coefficients basis.first
  rw [integerPointDot_self] at hdot
  unfold IntegerBasis3.firstOrthogonalCoordinate
    IntegerBasis3.firstGramSchmidtCoefficient
    IntegerBasis3.thirdFirstGramSchmidtCoefficient
  rw [hdot, integerPointDot_comm basis.second basis.first,
    integerPointDot_comm basis.third basis.first]
  push_cast
  field_simp

/-- Exact integer Cauchy–Schwarz inequality in dimension three. -/
theorem integerPointDot_sq_le (left right : IntegerPoint3) :
    integerPointDot left right ^ 2 ≤
      (integerPointSquaredNorm left : Int) *
        (integerPointSquaredNorm right : Int) := by
  have harea : 0 ≤ (integerPointAreaSquared left right : Int) := by
    exact_mod_cast (Nat.zero_le (integerPointAreaSquared left right))
  rw [integerPointAreaSquared_eq_gram] at harea
  omega

/-- The second Gram–Schmidt direction with its denominator cleared. -/
def IntegerBasis3.secondOrthogonalVectorNumerator
    (basis : IntegerBasis3) : IntegerPoint3 :=
  (basis.second.smul (integerPointSquaredNorm basis.first)).sub
    (basis.first.smul (integerPointDot basis.second basis.first))

/-- Dotting against the cleared second direction gives the numerator used by
the exact second orthogonal coordinate. -/
theorem IntegerBasis3.integerPointDot_secondOrthogonalVectorNumerator
    (basis : IntegerBasis3) (point : IntegerPoint3) :
    integerPointDot point basis.secondOrthogonalVectorNumerator =
      (integerPointSquaredNorm basis.first : Int) *
          integerPointDot point basis.second -
        integerPointDot basis.second basis.first *
          integerPointDot point basis.first := by
  rcases basis with ⟨first, second, third⟩
  rcases first with ⟨f₁, f₂, f₃⟩
  rcases second with ⟨s₁, s₂, s₃⟩
  rcases point with ⟨p₁, p₂, p₃⟩
  simp [IntegerBasis3.secondOrthogonalVectorNumerator,
    integerPointDot, integerPointSquaredNorm, IntegerPoint3.sub,
    IntegerPoint3.smul]
  ring

/-- Squared norm of the cleared second orthogonal direction. -/
theorem IntegerBasis3.secondOrthogonalVectorNumerator_squaredNorm
    (basis : IntegerBasis3) :
    (integerPointSquaredNorm basis.secondOrthogonalVectorNumerator : Int) =
      (integerPointSquaredNorm basis.first : Int) *
        (integerPointAreaSquared basis.first basis.second : Int) := by
  rw [← integerPointDot_self]
  unfold IntegerBasis3.secondOrthogonalVectorNumerator
  rw [show integerPointDot
      ((basis.second.smul (integerPointSquaredNorm basis.first)).sub
        (basis.first.smul (integerPointDot basis.second basis.first)))
      ((basis.second.smul (integerPointSquaredNorm basis.first)).sub
        (basis.first.smul (integerPointDot basis.second basis.first))) =
      (integerPointSquaredNorm basis.first : Int) ^ 2 *
          (integerPointSquaredNorm basis.second : Int) -
        (integerPointSquaredNorm basis.first : Int) *
          integerPointDot basis.second basis.first ^ 2 by
    rcases basis with ⟨first, second, third⟩
    rcases first with ⟨f₁, f₂, f₃⟩
    rcases second with ⟨s₁, s₂, s₃⟩
    simp [integerPointDot, integerPointSquaredNorm, IntegerPoint3.sub,
      IntegerPoint3.smul]
    ring]
  rw [integerPointAreaSquared_eq_gram,
    integerPointDot_comm basis.first basis.second]
  ring

/-- Squared length of the first Gram–Schmidt direction. -/
def IntegerBasis3.firstOrthogonalSquaredNorm
    (basis : IntegerBasis3) : Rat :=
  integerPointSquaredNorm basis.first

/-- Squared length of the second Gram–Schmidt direction. -/
def IntegerBasis3.secondOrthogonalSquaredNorm
    (basis : IntegerBasis3) : Rat :=
  (integerPointAreaSquared basis.first basis.second : Rat) /
    (integerPointSquaredNorm basis.first : Rat)

/-- Squared length of the third Gram–Schmidt direction. -/
def IntegerBasis3.thirdOrthogonalSquaredNorm
    (basis : IntegerBasis3) : Rat :=
  (basis.determinant : Rat) ^ 2 /
    (integerPointAreaSquared basis.first basis.second : Rat)

/-- Integer point subtraction computes the same squared norm as the public
squared-distance function. -/
theorem integerPointSquaredNorm_sub (left right : IntegerPoint3) :
    integerPointSquaredNorm (left.sub right) =
      squaredDistance left.toVector right.toVector := by
  rcases left with ⟨l₁, l₂, l₃⟩
  rcases right with ⟨r₁, r₂, r₃⟩
  simp [integerPointSquaredNorm, IntegerPoint3.sub,
    squaredDistance_point3]

/-- First orthogonal coordinates respect point subtraction. -/
theorem IntegerBasis3.firstOrthogonalCoordinate_sub
    (basis : IntegerBasis3) (left right : IntegerPoint3) :
    basis.firstOrthogonalCoordinate left -
        basis.firstOrthogonalCoordinate right =
      basis.firstOrthogonalCoordinate (left.sub right) := by
  rcases basis with ⟨first, second, third⟩
  rcases first with ⟨f₁, f₂, f₃⟩
  rcases left with ⟨l₁, l₂, l₃⟩
  rcases right with ⟨r₁, r₂, r₃⟩
  simp [IntegerBasis3.firstOrthogonalCoordinate,
    integerPointDot, integerPointSquaredNorm, IntegerPoint3.sub]
  ring

/-- Second orthogonal coordinates respect point subtraction. -/
theorem IntegerBasis3.secondOrthogonalCoordinate_sub
    (basis : IntegerBasis3) (left right : IntegerPoint3) :
    basis.secondOrthogonalCoordinate left -
        basis.secondOrthogonalCoordinate right =
      basis.secondOrthogonalCoordinate (left.sub right) := by
  rcases basis with ⟨first, second, third⟩
  rcases first with ⟨f₁, f₂, f₃⟩
  rcases second with ⟨s₁, s₂, s₃⟩
  rcases left with ⟨l₁, l₂, l₃⟩
  rcases right with ⟨r₁, r₂, r₃⟩
  simp [IntegerBasis3.secondOrthogonalCoordinate,
    integerPointDot, integerPointSquaredNorm, integerPointAreaSquared,
    integerPointCross, IntegerPoint3.sub]
  ring

/-- Third orthogonal coordinates respect point subtraction. -/
theorem IntegerBasis3.thirdOrthogonalCoordinate_sub
    (basis : IntegerBasis3) (left right : IntegerPoint3) :
    basis.thirdOrthogonalCoordinate left -
        basis.thirdOrthogonalCoordinate right =
      basis.thirdOrthogonalCoordinate (left.sub right) := by
  rcases basis with ⟨first, second, third⟩
  rcases first with ⟨f₁, f₂, f₃⟩
  rcases second with ⟨s₁, s₂, s₃⟩
  rcases third with ⟨t₁, t₂, t₃⟩
  rcases left with ⟨l₁, l₂, l₃⟩
  rcases right with ⟨r₁, r₂, r₃⟩
  simp [IntegerBasis3.thirdOrthogonalCoordinate,
    IntegerBasis3.determinant, integerPointDot, integerPointCross,
    IntegerPoint3.sub]
  ring

/-- Squared error in the first orthogonal coordinate, weighted by the first
Gram–Schmidt squared length, is bounded by the full squared distance. -/
theorem IntegerBasis3.firstOrthogonalProjection_sq_le_distance
    (basis : IntegerBasis3) (hfull : basis.FullRank)
    (left right : IntegerPoint3) :
    (basis.firstOrthogonalCoordinate left -
        basis.firstOrthogonalCoordinate right) ^ 2 *
        basis.firstOrthogonalSquaredNorm ≤
      (squaredDistance left.toVector right.toVector : Rat) := by
  let error := left.sub right
  let norm : Rat := integerPointSquaredNorm basis.first
  have hnormNat : 0 < integerPointSquaredNorm basis.first :=
    Nat.pos_of_ne_zero hfull.firstSquaredNorm_ne_zero
  have hnorm : 0 < norm := by
    dsimp [norm]
    exact_mod_cast hnormNat
  have hcauchy := integerPointDot_sq_le error basis.first
  have herror : integerPointSquaredNorm error =
      squaredDistance left.toVector right.toVector :=
    integerPointSquaredNorm_sub left right
  have hcauchyRat :
      (integerPointDot error basis.first : Rat) ^ 2 ≤
        (squaredDistance left.toVector right.toVector : Rat) * norm := by
    rw [← herror]
    dsimp [norm]
    exact_mod_cast hcauchy
  rw [basis.firstOrthogonalCoordinate_sub]
  unfold IntegerBasis3.firstOrthogonalCoordinate
    IntegerBasis3.firstOrthogonalSquaredNorm
  change
    ((integerPointDot error basis.first : Rat) / norm) ^ 2 * norm ≤ _
  rw [show ((integerPointDot error basis.first : Rat) / norm) ^ 2 * norm =
      (integerPointDot error basis.first : Rat) ^ 2 / norm by
    field_simp]
  exact (div_le_iff₀ hnorm).2 hcauchyRat

/-- Squared error in the second orthogonal coordinate, weighted by the second
Gram–Schmidt squared length, is bounded by the full squared distance. -/
theorem IntegerBasis3.secondOrthogonalProjection_sq_le_distance
    (basis : IntegerBasis3) (hfull : basis.FullRank)
    (left right : IntegerPoint3) :
    (basis.secondOrthogonalCoordinate left -
        basis.secondOrthogonalCoordinate right) ^ 2 *
        basis.secondOrthogonalSquaredNorm ≤
      (squaredDistance left.toVector right.toVector : Rat) := by
  let error := left.sub right
  let norm : Rat := integerPointSquaredNorm basis.first
  let area : Rat := integerPointAreaSquared basis.first basis.second
  have hnormNat : 0 < integerPointSquaredNorm basis.first :=
    Nat.pos_of_ne_zero hfull.firstSquaredNorm_ne_zero
  have hnorm : 0 < norm := by
    dsimp [norm]
    exact_mod_cast hnormNat
  have hareaNat : 0 < integerPointAreaSquared basis.first basis.second := by
    exact Nat.pos_of_ne_zero (by
      intro hzero
      apply hfull.secondReductionDenominator_ne_zero
      simp [IntegerBasis3.secondReductionDenominator, hzero])
  have harea : 0 < area := by
    dsimp [area]
    exact_mod_cast hareaNat
  have hcauchy := integerPointDot_sq_le error
    basis.secondOrthogonalVectorNumerator
  rw [basis.integerPointDot_secondOrthogonalVectorNumerator,
    basis.secondOrthogonalVectorNumerator_squaredNorm] at hcauchy
  have hcauchy' :
      ((integerPointSquaredNorm basis.first : Int) *
            integerPointDot error basis.second -
          integerPointDot basis.second basis.first *
            integerPointDot error basis.first) ^ 2 ≤
        (integerPointSquaredNorm error : Int) *
            (integerPointSquaredNorm basis.first : Int) *
          (integerPointAreaSquared basis.first basis.second : Int) := by
    simpa [mul_assoc] using hcauchy
  have herror : integerPointSquaredNorm error =
      squaredDistance left.toVector right.toVector :=
    integerPointSquaredNorm_sub left right
  have hcauchyRat :
      (((integerPointSquaredNorm basis.first : Int) *
            integerPointDot error basis.second -
          integerPointDot basis.second basis.first *
            integerPointDot error basis.first : Int) : Rat) ^ 2 ≤
        (squaredDistance left.toVector right.toVector : Rat) * norm * area := by
    rw [← herror]
    dsimp [norm, area]
    exact_mod_cast hcauchy'
  rw [basis.secondOrthogonalCoordinate_sub]
  unfold IntegerBasis3.secondOrthogonalCoordinate
    IntegerBasis3.secondOrthogonalSquaredNorm
  let numerator : Rat :=
    ((integerPointSquaredNorm basis.first : Int) *
          integerPointDot error basis.second -
        integerPointDot basis.second basis.first *
          integerPointDot error basis.first : Int)
  change (numerator / area) ^ 2 * (area / norm) ≤ _
  rw [show (numerator / area) ^ 2 * (area / norm) =
      numerator ^ 2 / (area * norm) by
    field_simp]
  rw [div_le_iff₀ (mul_pos harea hnorm)]
  simpa [numerator, mul_assoc, mul_left_comm, mul_comm] using hcauchyRat

/-- Squared error in the third orthogonal coordinate, weighted by the third
Gram–Schmidt squared length, is bounded by the full squared distance. -/
theorem IntegerBasis3.thirdOrthogonalProjection_sq_le_distance
    (basis : IntegerBasis3) (hfull : basis.FullRank)
    (left right : IntegerPoint3) :
    (basis.thirdOrthogonalCoordinate left -
        basis.thirdOrthogonalCoordinate right) ^ 2 *
        basis.thirdOrthogonalSquaredNorm ≤
      (squaredDistance left.toVector right.toVector : Rat) := by
  let error := left.sub right
  let area : Rat := integerPointAreaSquared basis.first basis.second
  have hareaNat : 0 < integerPointAreaSquared basis.first basis.second := by
    exact Nat.pos_of_ne_zero (by
      intro hzero
      apply hfull.secondReductionDenominator_ne_zero
      simp [IntegerBasis3.secondReductionDenominator, hzero])
  have harea : 0 < area := by
    dsimp [area]
    exact_mod_cast hareaNat
  have hdet : (basis.determinant : Rat) ≠ 0 := by
    exact_mod_cast hfull
  have hcauchy := integerPointDot_sq_le error
    (integerPointCross basis.first basis.second)
  have herror : integerPointSquaredNorm error =
      squaredDistance left.toVector right.toVector :=
    integerPointSquaredNorm_sub left right
  have hcauchyRat :
      (integerPointDot error
          (integerPointCross basis.first basis.second) : Rat) ^ 2 ≤
        (squaredDistance left.toVector right.toVector : Rat) * area := by
    rw [← herror]
    dsimp [area]
    simp only [integerPointAreaSquared]
    exact_mod_cast hcauchy
  rw [basis.thirdOrthogonalCoordinate_sub]
  unfold IntegerBasis3.thirdOrthogonalCoordinate
    IntegerBasis3.thirdOrthogonalSquaredNorm
  let numerator : Rat := integerPointDot error
    (integerPointCross basis.first basis.second)
  let determinant : Rat := basis.determinant
  have hdeterminant : determinant ≠ 0 := by
    simpa [determinant] using hdet
  change (numerator / determinant) ^ 2 * (determinant ^ 2 / area) ≤ _
  rw [show (numerator / determinant) ^ 2 *
      (determinant ^ 2 / area) = numerator ^ 2 / area by
    field_simp [hdeterminant]]
  exact (div_le_iff₀ harea).2 hcauchyRat

/-- Cleared three-dimensional Gram determinant identity.  It decomposes the
first/third squared area into the second-direction projection and the third
orthogonal determinant contribution. -/
theorem IntegerBasis3.gramDeterminantIdentity (basis : IntegerBasis3) :
    (integerPointAreaSquared basis.first basis.second : Int) *
        (integerPointAreaSquared basis.first basis.third : Int) =
      basis.secondReductionNumerator ^ 2 +
        (integerPointSquaredNorm basis.first : Int) *
          basis.determinant ^ 2 := by
  rcases basis with ⟨first, second, third⟩
  rcases first with ⟨f₁, f₂, f₃⟩
  rcases second with ⟨s₁, s₂, s₃⟩
  rcases third with ⟨t₁, t₂, t₃⟩
  simp [integerPointAreaSquared, integerPointSquaredNorm,
    integerPointCross, integerPointDot,
    IntegerBasis3.secondReductionNumerator, IntegerBasis3.determinant]
  ring

/-- The first Lovász test and first size-reduction bound force the second
Gram–Schmidt squared length to be at least one quarter of the first. -/
theorem IntegerBasis3.IsReduced.secondOrthogonalSquaredNorm_lower
    {basis : IntegerBasis3} (hreduced : basis.IsReduced)
    (hfull : basis.FullRank) :
    basis.firstOrthogonalSquaredNorm / 4 ≤
      basis.secondOrthogonalSquaredNorm := by
  let firstNorm : Rat := integerPointSquaredNorm basis.first
  let secondNorm : Rat := integerPointSquaredNorm basis.second
  let coefficient : Rat := basis.firstGramSchmidtCoefficient
  have hfirstNat : 0 < integerPointSquaredNorm basis.first :=
    Nat.pos_of_ne_zero hfull.firstSquaredNorm_ne_zero
  have hfirst : 0 < firstNorm := by
    dsimp [firstNorm]
    exact_mod_cast hfirstNat
  have hlovaszNat : integerPointSquaredNorm basis.first ≤
      2 * integerPointSquaredNorm basis.second := by
    simpa [IntegerBasis3.firstLovasz] using hreduced.firstLovasz
  have hlovasz : firstNorm ≤ 2 * secondNorm := by
    dsimp [firstNorm, secondNorm]
    exact_mod_cast hlovaszNat
  have hcoefficientSq : coefficient ^ 2 ≤ ((1 : Rat) / 2) ^ 2 := by
    rw [sq_le_sq]
    simpa [coefficient] using hreduced.firstSizeReduced
  have hcoefficientTerm :
      coefficient ^ 2 * firstNorm ≤ ((1 : Rat) / 2) ^ 2 * firstNorm :=
    mul_le_mul_of_nonneg_right hcoefficientSq hfirst.le
  have hdecomposition :
      basis.secondOrthogonalSquaredNorm =
        secondNorm - coefficient ^ 2 * firstNorm := by
    unfold IntegerBasis3.secondOrthogonalSquaredNorm
    dsimp [secondNorm, coefficient, firstNorm]
    unfold IntegerBasis3.firstGramSchmidtCoefficient
    have hgram :
        (integerPointAreaSquared basis.first basis.second : Rat) =
          (integerPointSquaredNorm basis.first : Rat) *
              (integerPointSquaredNorm basis.second : Rat) -
            (integerPointDot basis.second basis.first : Rat) ^ 2 := by
      rw [integerPointDot_comm basis.second basis.first]
      exact_mod_cast integerPointAreaSquared_eq_gram
        basis.first basis.second
    rw [hgram]
    field_simp
  unfold IntegerBasis3.firstOrthogonalSquaredNorm
  rw [hdecomposition]
  dsimp [firstNorm] at hfirst ⊢
  dsimp [secondNorm, coefficient] at hlovasz hcoefficientSq hcoefficientTerm ⊢
  norm_num at hcoefficientTerm ⊢
  linarith

/-- The second Lovász test and second size-reduction bound force the third
Gram–Schmidt squared length to be at least one quarter of the second. -/
theorem IntegerBasis3.IsReduced.thirdOrthogonalSquaredNorm_lower
    {basis : IntegerBasis3} (hreduced : basis.IsReduced)
    (hfull : basis.FullRank) :
    basis.secondOrthogonalSquaredNorm / 4 ≤
      basis.thirdOrthogonalSquaredNorm := by
  let firstNorm : Rat := integerPointSquaredNorm basis.first
  let firstSecondArea : Rat :=
    integerPointAreaSquared basis.first basis.second
  let firstThirdArea : Rat :=
    integerPointAreaSquared basis.first basis.third
  let coefficient : Rat := basis.secondGramSchmidtCoefficient
  have hfirstNat : 0 < integerPointSquaredNorm basis.first :=
    Nat.pos_of_ne_zero hfull.firstSquaredNorm_ne_zero
  have hfirst : 0 < firstNorm := by
    dsimp [firstNorm]
    exact_mod_cast hfirstNat
  have hareaNat : 0 < integerPointAreaSquared basis.first basis.second := by
    exact Nat.pos_of_ne_zero (by
      intro hzero
      apply hfull.secondReductionDenominator_ne_zero
      simp [IntegerBasis3.secondReductionDenominator, hzero])
  have harea : 0 < firstSecondArea := by
    dsimp [firstSecondArea]
    exact_mod_cast hareaNat
  have hlovaszNat : integerPointAreaSquared basis.first basis.second ≤
      2 * integerPointAreaSquared basis.first basis.third := by
    simpa [IntegerBasis3.secondLovasz] using hreduced.secondLovasz
  have hlovasz : firstSecondArea / firstNorm ≤
      2 * (firstThirdArea / firstNorm) := by
    have hlovaszRat : firstSecondArea ≤ 2 * firstThirdArea := by
      dsimp [firstSecondArea, firstThirdArea]
      exact_mod_cast hlovaszNat
    calc
      firstSecondArea / firstNorm ≤
          (2 * firstThirdArea) / firstNorm :=
        (div_le_div_iff_of_pos_right hfirst).2 hlovaszRat
      _ = 2 * (firstThirdArea / firstNorm) := by ring
  have hcoefficientSq : coefficient ^ 2 ≤ ((1 : Rat) / 2) ^ 2 := by
    rw [sq_le_sq]
    simpa [coefficient] using hreduced.secondSizeReduced
  have hsecondPos : 0 < basis.secondOrthogonalSquaredNorm := by
    unfold IntegerBasis3.secondOrthogonalSquaredNorm
    exact div_pos harea hfirst
  have hcoefficientTerm :
      coefficient ^ 2 * basis.secondOrthogonalSquaredNorm ≤
        ((1 : Rat) / 2) ^ 2 * basis.secondOrthogonalSquaredNorm :=
    mul_le_mul_of_nonneg_right hcoefficientSq hsecondPos.le
  have hdecomposition :
      firstThirdArea / firstNorm =
        coefficient ^ 2 * basis.secondOrthogonalSquaredNorm +
          basis.thirdOrthogonalSquaredNorm := by
    unfold IntegerBasis3.secondOrthogonalSquaredNorm
      IntegerBasis3.thirdOrthogonalSquaredNorm
    dsimp [firstThirdArea, firstSecondArea, firstNorm, coefficient]
    unfold IntegerBasis3.secondGramSchmidtCoefficient
      IntegerBasis3.secondReductionDenominator
    have hidentity :
        firstSecondArea * firstThirdArea =
          (basis.secondReductionNumerator : Rat) ^ 2 +
            firstNorm * (basis.determinant : Rat) ^ 2 := by
      dsimp [firstSecondArea, firstThirdArea, firstNorm]
      exact_mod_cast basis.gramDeterminantIdentity
    calc
      firstThirdArea / firstNorm =
          (firstSecondArea * firstThirdArea) /
            (firstSecondArea * firstNorm) := by
        field_simp
      _ = ((basis.secondReductionNumerator : Rat) ^ 2 +
            firstNorm * (basis.determinant : Rat) ^ 2) /
            (firstSecondArea * firstNorm) := by rw [hidentity]
      _ = ((basis.secondReductionNumerator : Rat) / firstSecondArea) ^ 2 *
              (firstSecondArea / firstNorm) +
            (basis.determinant : Rat) ^ 2 / firstSecondArea := by
        field_simp
  rw [hdecomposition] at hlovasz
  change basis.secondOrthogonalSquaredNorm ≤
    2 * (coefficient ^ 2 * basis.secondOrthogonalSquaredNorm +
      basis.thirdOrthogonalSquaredNorm) at hlovasz
  norm_num at hcoefficientTerm ⊢
  ring_nf at hlovasz hcoefficientTerm ⊢
  linarith

/-- Consequently, the third Gram–Schmidt direction is at least one sixteenth
of the first squared length. -/
theorem IntegerBasis3.IsReduced.thirdOrthogonalSquaredNorm_lower_first
    {basis : IntegerBasis3} (hreduced : basis.IsReduced)
    (hfull : basis.FullRank) :
    basis.firstOrthogonalSquaredNorm / 16 ≤
      basis.thirdOrthogonalSquaredNorm := by
  have hsecond := hreduced.secondOrthogonalSquaredNorm_lower hfull
  have hthird := hreduced.thirdOrthogonalSquaredNorm_lower hfull
  linarith

/-- An integral value whose rational absolute value is below the successor of
`bound` has natural absolute value at most `bound`. -/
private theorem intNatAbs_le_of_ratAbs_lt_succ
    (value : Int) (bound : Nat)
    (hvalue : |(value : Rat)| < bound + 1) :
    value.natAbs ≤ bound := by
  have hcast : (value.natAbs : Rat) = |(value : Rat)| := by
    simp [Nat.cast_natAbs, Int.cast_abs]
  rw [← hcast] at hvalue
  have hnat : value.natAbs < bound + 1 := by
    exact_mod_cast hvalue
  omega

/-- A point whose third orthogonal projection is within `34` of the target
has third integer coefficient within `35` of the nearest-plane center. -/
theorem IntegerBasis3.nearestPlaneThirdOffset_abs_lt
    (basis : IntegerBasis3) (hfull : basis.FullRank)
    (target : IntegerPoint3) (coefficients : IntegerPoint3)
    (hprojection :
      |basis.thirdOrthogonalCoordinate
          (basis.linearCombination coefficients) -
        basis.thirdOrthogonalCoordinate target| < 34) :
    |((coefficients.2.2 -
        basis.nearestPlaneThirdCoefficient target : Int) : Rat)| < 35 := by
  have hprojection' := hprojection
  rw [basis.thirdOrthogonalCoordinate_linearCombination coefficients hfull]
    at hprojection'
  let coordinate := basis.thirdOrthogonalCoordinate target
  let center := basis.nearestPlaneThirdCoefficient target
  have hround : |coordinate - (center : Rat)| ≤ (1 : Rat) / 2 := by
    simpa [coordinate, center, IntegerBasis3.nearestPlaneThirdCoefficient] using
      (abs_sub_round coordinate)
  have hoffset :
      ((coefficients.2.2 - center : Int) : Rat) =
        ((coefficients.2.2 : Rat) - coordinate) +
          (coordinate - (center : Rat)) := by
    push_cast
    ring
  rw [hoffset]
  calc
    |((coefficients.2.2 : Rat) - coordinate) +
        (coordinate - (center : Rat))| ≤
        |(coefficients.2.2 : Rat) - coordinate| +
          |coordinate - (center : Rat)| := abs_add_le _ _
    _ < 34 + (1 : Rat) / 2 :=
      add_lt_add_of_lt_of_le (by simpa [coordinate] using hprojection') hround
    _ < 35 := by norm_num

/-- Under exact size reduction, a point whose second and third orthogonal
projections lie in the corrected source bounds has second integer coefficient
within `35` of the nearest-plane center. -/
theorem IntegerBasis3.nearestPlaneSecondOffset_abs_lt
    (basis : IntegerBasis3) (hfull : basis.FullRank)
    (hreduced : basis.IsReduced) (target : IntegerPoint3)
    (coefficients : IntegerPoint3)
    (hsecondProjection :
      |basis.secondOrthogonalCoordinate
          (basis.linearCombination coefficients) -
        basis.secondOrthogonalCoordinate target| < 17)
    (hthirdProjection :
      |basis.thirdOrthogonalCoordinate
          (basis.linearCombination coefficients) -
        basis.thirdOrthogonalCoordinate target| < 34) :
    |((coefficients.2.1 -
        basis.nearestPlaneSecondCoefficient target : Int) : Rat)| < 35 := by
  have harea : integerPointAreaSquared basis.first basis.second ≠ 0 := by
    intro hzero
    apply hfull.secondReductionDenominator_ne_zero
    simp [IntegerBasis3.secondReductionDenominator, hzero]
  have hsecondProjection' := hsecondProjection
  rw [basis.secondOrthogonalCoordinate_linearCombination coefficients harea]
    at hsecondProjection'
  let coordinate := basis.secondOrthogonalCoordinate target
  let coefficient := basis.secondGramSchmidtCoefficient
  let thirdCenter := basis.nearestPlaneThirdCoefficient target
  let secondCenter := basis.nearestPlaneSecondCoefficient target
  let thirdOffset : Rat := coefficients.2.2 - thirdCenter
  have hthirdOffset : |thirdOffset| < 35 := by
    simpa [thirdOffset, thirdCenter] using
      basis.nearestPlaneThirdOffset_abs_lt hfull target coefficients
        hthirdProjection
  have hcoefficient : |coefficient| ≤ (1 : Rat) / 2 := by
    simpa [coefficient] using hreduced.secondSizeReduced
  have hthirdProduct : |thirdOffset * coefficient| < (35 : Rat) / 2 := by
    rw [abs_mul]
    calc
      |thirdOffset| * |coefficient| ≤
          |thirdOffset| * ((1 : Rat) / 2) :=
        mul_le_mul_of_nonneg_left hcoefficient (abs_nonneg _)
      _ < 35 * ((1 : Rat) / 2) :=
        mul_lt_mul_of_pos_right hthirdOffset (by norm_num)
      _ = (35 : Rat) / 2 := by ring
  have hround :
      |(coordinate - (thirdCenter : Rat) * coefficient) -
        (secondCenter : Rat)| ≤ (1 : Rat) / 2 := by
    simpa [coordinate, coefficient, thirdCenter, secondCenter,
      IntegerBasis3.nearestPlaneSecondCoefficient] using
      (abs_sub_round
        (coordinate - (thirdCenter : Rat) * coefficient))
  have hoffset :
      ((coefficients.2.1 - secondCenter : Int) : Rat) =
        ((coefficients.2.1 : Rat) +
            (coefficients.2.2 : Rat) * coefficient - coordinate) -
          thirdOffset * coefficient +
          ((coordinate - (thirdCenter : Rat) * coefficient) -
            (secondCenter : Rat)) := by
    dsimp [thirdOffset]
    push_cast
    ring
  rw [hoffset]
  calc
    |((coefficients.2.1 : Rat) +
          (coefficients.2.2 : Rat) * coefficient - coordinate) -
        thirdOffset * coefficient +
        ((coordinate - (thirdCenter : Rat) * coefficient) -
          (secondCenter : Rat))| ≤
        |(coefficients.2.1 : Rat) +
          (coefficients.2.2 : Rat) * coefficient - coordinate| +
        |thirdOffset * coefficient| +
        |(coordinate - (thirdCenter : Rat) * coefficient) -
          (secondCenter : Rat)| := by
      calc
        _ ≤ |((coefficients.2.1 : Rat) +
                (coefficients.2.2 : Rat) * coefficient - coordinate) -
              thirdOffset * coefficient| +
              |(coordinate - (thirdCenter : Rat) * coefficient) -
                (secondCenter : Rat)| := abs_add_le _ _
        _ ≤ (|(coefficients.2.1 : Rat) +
                (coefficients.2.2 : Rat) * coefficient - coordinate| +
              |thirdOffset * coefficient|) +
              |(coordinate - (thirdCenter : Rat) * coefficient) -
              (secondCenter : Rat)| := by
          exact add_le_add
            (by
              simpa [sub_eq_add_neg] using
                (abs_add_le
                  ((coefficients.2.1 : Rat) +
                    (coefficients.2.2 : Rat) * coefficient - coordinate)
                  (-(thirdOffset * coefficient))))
            (le_refl _)
    _ < 17 + (35 : Rat) / 2 + (1 : Rat) / 2 := by
      apply add_lt_add_of_lt_of_le
      · exact add_lt_add
          (by simpa [coordinate, coefficient] using hsecondProjection')
          hthirdProduct
      · exact hround
    _ = 35 := by norm_num

/-- Under exact size reduction, corrected source projection errors put the
first integer coefficient within `43` of the nearest-plane center. -/
theorem IntegerBasis3.nearestPlaneFirstOffset_abs_lt
    (basis : IntegerBasis3) (hfull : basis.FullRank)
    (hreduced : basis.IsReduced) (target : IntegerPoint3)
    (coefficients : IntegerPoint3)
    (hfirstProjection :
      |basis.firstOrthogonalCoordinate
          (basis.linearCombination coefficients) -
        basis.firstOrthogonalCoordinate target| < (17 : Rat) / 2)
    (hsecondProjection :
      |basis.secondOrthogonalCoordinate
          (basis.linearCombination coefficients) -
        basis.secondOrthogonalCoordinate target| < 17)
    (hthirdProjection :
      |basis.thirdOrthogonalCoordinate
          (basis.linearCombination coefficients) -
        basis.thirdOrthogonalCoordinate target| < 34) :
    |((coefficients.1 -
        basis.nearestPlaneFirstCoefficient target : Int) : Rat)| < 43 := by
  have hfirstProjection' := hfirstProjection
  rw [basis.firstOrthogonalCoordinate_linearCombination coefficients
    hfull.firstSquaredNorm_ne_zero] at hfirstProjection'
  let coordinate := basis.firstOrthogonalCoordinate target
  let secondCoefficient := basis.firstGramSchmidtCoefficient
  let thirdCoefficient := basis.thirdFirstGramSchmidtCoefficient
  let thirdCenter := basis.nearestPlaneThirdCoefficient target
  let secondCenter := basis.nearestPlaneSecondCoefficient target
  let firstCenter := basis.nearestPlaneFirstCoefficient target
  let secondOffsetInt : Int := coefficients.2.1 - secondCenter
  let thirdOffsetInt : Int := coefficients.2.2 - thirdCenter
  let secondOffset : Rat := secondOffsetInt
  let thirdOffset : Rat := thirdOffsetInt
  have hsecondOffset : |secondOffset| < 35 := by
    simpa [secondOffset, secondOffsetInt, secondCenter] using
      basis.nearestPlaneSecondOffset_abs_lt hfull hreduced target coefficients
        hsecondProjection hthirdProjection
  have hthirdOffset : |thirdOffset| < 35 := by
    simpa [thirdOffset, thirdOffsetInt, thirdCenter] using
      basis.nearestPlaneThirdOffset_abs_lt hfull target coefficients
        hthirdProjection
  have hsecondOffsetNat : secondOffsetInt.natAbs ≤ 34 := by
    refine intNatAbs_le_of_ratAbs_lt_succ secondOffsetInt 34 ?_
    convert hsecondOffset using 1
    all_goals norm_num [secondOffset]
  have hthirdOffsetNat : thirdOffsetInt.natAbs ≤ 34 := by
    refine intNatAbs_le_of_ratAbs_lt_succ thirdOffsetInt 34 ?_
    convert hthirdOffset using 1
    all_goals norm_num [thirdOffset]
  have hsecondOffsetLe : |secondOffset| ≤ (34 : Rat) := by
    have hcast : (secondOffsetInt.natAbs : Rat) =
        |(secondOffsetInt : Rat)| := by
      simp [Nat.cast_natAbs, Int.cast_abs]
    simpa [secondOffset, hcast] using
      (show (secondOffsetInt.natAbs : Rat) ≤ 34 by
        exact_mod_cast hsecondOffsetNat)
  have hthirdOffsetLe : |thirdOffset| ≤ (34 : Rat) := by
    have hcast : (thirdOffsetInt.natAbs : Rat) =
        |(thirdOffsetInt : Rat)| := by
      simp [Nat.cast_natAbs, Int.cast_abs]
    simpa [thirdOffset, hcast] using
      (show (thirdOffsetInt.natAbs : Rat) ≤ 34 by
        exact_mod_cast hthirdOffsetNat)
  have hsecondCoefficient : |secondCoefficient| ≤ (1 : Rat) / 2 := by
    simpa [secondCoefficient] using hreduced.firstSizeReduced
  have hthirdCoefficient : |thirdCoefficient| ≤ (1 : Rat) / 2 := by
    simpa [thirdCoefficient] using hreduced.thirdFirstSizeReduced
  have hsecondProduct :
      |secondOffset * secondCoefficient| ≤ (34 : Rat) / 2 := by
    rw [abs_mul]
    calc
      |secondOffset| * |secondCoefficient| ≤
          |secondOffset| * ((1 : Rat) / 2) :=
        mul_le_mul_of_nonneg_left hsecondCoefficient (abs_nonneg _)
      _ ≤ 34 * ((1 : Rat) / 2) :=
        mul_le_mul_of_nonneg_right hsecondOffsetLe (by norm_num)
      _ = (34 : Rat) / 2 := by ring
  have hthirdProduct :
      |thirdOffset * thirdCoefficient| ≤ (34 : Rat) / 2 := by
    rw [abs_mul]
    calc
      |thirdOffset| * |thirdCoefficient| ≤
          |thirdOffset| * ((1 : Rat) / 2) :=
        mul_le_mul_of_nonneg_left hthirdCoefficient (abs_nonneg _)
      _ ≤ 34 * ((1 : Rat) / 2) :=
        mul_le_mul_of_nonneg_right hthirdOffsetLe (by norm_num)
      _ = (34 : Rat) / 2 := by ring
  have hround :
      |(coordinate - (secondCenter : Rat) * secondCoefficient -
          (thirdCenter : Rat) * thirdCoefficient) -
        (firstCenter : Rat)| ≤ (1 : Rat) / 2 := by
    simpa [coordinate, secondCoefficient, thirdCoefficient, thirdCenter,
      secondCenter, firstCenter,
      IntegerBasis3.nearestPlaneFirstCoefficient] using
      (abs_sub_round
        (coordinate - (secondCenter : Rat) * secondCoefficient -
          (thirdCenter : Rat) * thirdCoefficient))
  have hoffset :
      ((coefficients.1 - firstCenter : Int) : Rat) =
        ((coefficients.1 : Rat) +
            (coefficients.2.1 : Rat) * secondCoefficient +
            (coefficients.2.2 : Rat) * thirdCoefficient - coordinate) -
          secondOffset * secondCoefficient -
          thirdOffset * thirdCoefficient +
          ((coordinate - (secondCenter : Rat) * secondCoefficient -
              (thirdCenter : Rat) * thirdCoefficient) -
          (firstCenter : Rat)) := by
    dsimp [secondOffset, thirdOffset, secondOffsetInt, thirdOffsetInt]
    push_cast
    ring
  rw [hoffset]
  let projectionError : Rat :=
    (coefficients.1 : Rat) +
      (coefficients.2.1 : Rat) * secondCoefficient +
      (coefficients.2.2 : Rat) * thirdCoefficient - coordinate
  let roundingError : Rat :=
    (coordinate - (secondCenter : Rat) * secondCoefficient -
        (thirdCenter : Rat) * thirdCoefficient) -
      (firstCenter : Rat)
  have htriangle :
      |projectionError - secondOffset * secondCoefficient -
          thirdOffset * thirdCoefficient + roundingError| ≤
        |projectionError| + |secondOffset * secondCoefficient| +
          |thirdOffset * thirdCoefficient| + |roundingError| := by
    calc
      _ ≤ |projectionError - secondOffset * secondCoefficient -
            thirdOffset * thirdCoefficient| + |roundingError| :=
        abs_add_le _ _
      _ ≤ (|projectionError - secondOffset * secondCoefficient| +
            |thirdOffset * thirdCoefficient|) + |roundingError| :=
        add_le_add
          (by
            simpa [sub_eq_add_neg] using
              (abs_add_le
                (projectionError - secondOffset * secondCoefficient)
                (-(thirdOffset * thirdCoefficient))))
          (le_refl _)
      _ ≤ ((|projectionError| + |secondOffset * secondCoefficient|) +
            |thirdOffset * thirdCoefficient|) + |roundingError| :=
        add_le_add
          (add_le_add
            (by
              simpa [sub_eq_add_neg] using
                (abs_add_le projectionError
                  (-(secondOffset * secondCoefficient))))
            (le_refl _))
          (le_refl _)
  calc
    |((coefficients.1 : Rat) +
          (coefficients.2.1 : Rat) * secondCoefficient +
          (coefficients.2.2 : Rat) * thirdCoefficient - coordinate) -
        secondOffset * secondCoefficient -
        thirdOffset * thirdCoefficient +
        ((coordinate - (secondCenter : Rat) * secondCoefficient -
            (thirdCenter : Rat) * thirdCoefficient) -
          (firstCenter : Rat))| ≤
        |projectionError| + |secondOffset * secondCoefficient| +
          |thirdOffset * thirdCoefficient| + |roundingError| := by
      simpa [projectionError, roundingError] using htriangle
    _ < (17 : Rat) / 2 + (34 : Rat) / 2 +
        (34 : Rat) / 2 + (1 : Rat) / 2 := by
      apply add_lt_add_of_lt_of_le
      · exact add_lt_add_of_lt_of_le
          (add_lt_add_of_lt_of_le
            (by simpa [coordinate, secondCoefficient, thirdCoefficient]
              using hfirstProjection')
            hsecondProduct)
          hthirdProduct
      · simpa [roundingError] using hround
    _ = 43 := by norm_num

/-! ### Fixed-dimensional nearby-point enumeration -/

/-!
Fixed-dimensional rational-polytope projections admit algorithms polynomial in
the bit encoding of the polytope and projection
[BW02, main.tex:179-232].  The executable specialization below does not assume
that general algorithm: it directly enumerates a concrete three-dimensional
coefficient box and proves its cardinality and work bound in Lean.
-/

/-- Canonical increasing list of integer offsets in `[-radius, radius]`.
Unlike converting a `Finset` to a list, this order is computational data and
does not depend on a quotient representative. -/
def centeredIntegerList (radius : Nat) : List Int :=
  List.ofFn fun index : Fin (2 * radius + 1) =>
    (index.val : Int) - (radius : Int)

@[simp]
theorem length_centeredIntegerList (radius : Nat) :
    (centeredIntegerList radius).length = 2 * radius + 1 := by
  simp [centeredIntegerList]

/-- The canonical centered interval contains no duplicate offsets. -/
theorem nodup_centeredIntegerList (radius : Nat) :
    (centeredIntegerList radius).Nodup := by
  rw [centeredIntegerList, List.nodup_ofFn]
  intro first second heq
  have hcast : (first.val : Int) = (second.val : Int) := by
    have hadd := congrArg (fun value : Int => value + (radius : Int)) heq
    simpa using hadd
  apply Fin.ext
  exact_mod_cast hcast

@[simp]
theorem mem_centeredIntegerList {radius : Nat} {offset : Int} :
    offset ∈ centeredIntegerList radius ↔
      -(radius : Int) ≤ offset ∧ offset ≤ (radius : Int) := by
  rw [centeredIntegerList, List.mem_ofFn]
  constructor
  · rintro ⟨index, rfl⟩
    have hindexLt := index.isLt
    omega
  · intro hoffset
    have hnonneg : 0 ≤ offset + (radius : Int) := by omega
    have hindexLt : (offset + radius).toNat < 2 * radius + 1 := by
      rw [← Int.ofNat_lt]
      rw [Int.toNat_of_nonneg hnonneg]
      push_cast
      omega
    refine ⟨⟨(offset + radius).toNat, hindexLt⟩, ?_⟩
    rw [Int.toNat_of_nonneg hnonneg]
    omega

/-- Integer offsets in the closed interval `[-radius, radius]`. -/
def centeredIntegerInterval (radius : Nat) : Finset Int :=
  Finset.Icc (-(radius : Int)) (radius : Int)

@[simp]
theorem mem_centeredIntegerInterval {radius : Nat} {offset : Int} :
    offset ∈ centeredIntegerInterval radius ↔
      -(radius : Int) ≤ offset ∧ offset ≤ (radius : Int) := by
  simp [centeredIntegerInterval]

/-- Exact work count of a centered integer interval. -/
theorem card_centeredIntegerInterval (radius : Nat) :
    (centeredIntegerInterval radius).card = 2 * radius + 1 := by
  rw [centeredIntegerInterval, Int.card_Icc]
  norm_num
  omega

/-- Independent coefficient-offset bounds in dimension three. -/
abbrev CoefficientBounds3 : Type := Nat × Nat × Nat

/-- Coefficient window derived from the corrected `s = 2` short-logarithm
search radius and the exact nearest-plane rounding bounds. -/
def nearestPlaneCoefficientBounds3 : CoefficientBounds3 :=
  (42, 34, 34)

/-- Cartesian box of integer coefficient offsets. -/
def coefficientOffsetBox3 (bounds : CoefficientBounds3) :
    Finset IntegerPoint3 :=
  (centeredIntegerInterval bounds.1).product <|
    (centeredIntegerInterval bounds.2.1).product <|
      centeredIntegerInterval bounds.2.2

@[simp]
theorem mem_coefficientOffsetBox3
    {bounds : CoefficientBounds3} {offset : IntegerPoint3} :
    offset ∈ coefficientOffsetBox3 bounds ↔
      -(bounds.1 : Int) ≤ offset.1 ∧
        offset.1 ≤ (bounds.1 : Int) ∧
      -(bounds.2.1 : Int) ≤ offset.2.1 ∧
        offset.2.1 ≤ (bounds.2.1 : Int) ∧
      -(bounds.2.2 : Int) ≤ offset.2.2 ∧
        offset.2.2 ≤ (bounds.2.2 : Int) := by
  simp [coefficientOffsetBox3, and_assoc]

/-- Direct coefficient-error bounds imply membership in the fixed executable
nearest-plane offset box. -/
theorem IntegerBasis3.coefficientOffset_mem_nearestPlaneBox_of_abs_lt
    (basis : IntegerBasis3) (target coefficients : IntegerPoint3)
    (hfirst :
      |((coefficients.1 -
          basis.nearestPlaneFirstCoefficient target : Int) : Rat)| < 43)
    (hsecond :
      |((coefficients.2.1 -
          basis.nearestPlaneSecondCoefficient target : Int) : Rat)| < 35)
    (hthird :
      |((coefficients.2.2 -
          basis.nearestPlaneThirdCoefficient target : Int) : Rat)| < 35) :
    coefficients.sub (basis.nearestPlaneCoefficientCenter target) ∈
      coefficientOffsetBox3 nearestPlaneCoefficientBounds3 := by
  let firstOffset : Int :=
    coefficients.1 - basis.nearestPlaneFirstCoefficient target
  let secondOffset : Int :=
    coefficients.2.1 - basis.nearestPlaneSecondCoefficient target
  let thirdOffset : Int :=
    coefficients.2.2 - basis.nearestPlaneThirdCoefficient target
  have hfirstNat : firstOffset.natAbs ≤ 42 := by
    refine intNatAbs_le_of_ratAbs_lt_succ firstOffset 42 ?_
    convert hfirst using 1
    all_goals norm_num [firstOffset]
  have hsecondNat : secondOffset.natAbs ≤ 34 := by
    refine intNatAbs_le_of_ratAbs_lt_succ secondOffset 34 ?_
    convert hsecond using 1
    all_goals norm_num [secondOffset]
  have hthirdNat : thirdOffset.natAbs ≤ 34 := by
    refine intNatAbs_le_of_ratAbs_lt_succ thirdOffset 34 ?_
    convert hthird using 1
    all_goals norm_num [thirdOffset]
  have coordinateBounds (value : Int) (radius : Nat)
      (hvalue : value.natAbs ≤ radius) :
      -(radius : Int) ≤ value ∧ value ≤ (radius : Int) := by
    have hvalueInt : (value.natAbs : Int) ≤ (radius : Int) := by
      exact_mod_cast hvalue
    by_cases hnonneg : 0 ≤ value
    · rw [Int.natAbs_of_nonneg hnonneg] at hvalueInt
      constructor <;> omega
    · have hnonpos : value ≤ 0 := by omega
      rw [Int.ofNat_natAbs_of_nonpos hnonpos] at hvalueInt
      constructor <;> omega
  have hfirstBounds := coordinateBounds firstOffset 42 hfirstNat
  have hsecondBounds := coordinateBounds secondOffset 34 hsecondNat
  have hthirdBounds := coordinateBounds thirdOffset 34 hthirdNat
  rw [mem_coefficientOffsetBox3]
  change -(42 : Int) ≤ firstOffset ∧ firstOffset ≤ 42 ∧
    -(34 : Int) ≤ secondOffset ∧ secondOffset ≤ 34 ∧
    -(34 : Int) ≤ thirdOffset ∧ thirdOffset ≤ 34
  exact ⟨hfirstBounds.1, hfirstBounds.2,
    hsecondBounds.1, hsecondBounds.2,
    hthirdBounds.1, hthirdBounds.2⟩

/-- Number of coefficient tuples inspected by a three-dimensional box. -/
def coefficientOffsetBoxWork3 (bounds : CoefficientBounds3) : Nat :=
  (2 * bounds.1 + 1) *
    (2 * bounds.2.1 + 1) *
      (2 * bounds.2.2 + 1)

/-- Canonical lexicographic list of all coefficient offsets in a bounded
three-dimensional box.  Runtime recovery scans this list in full. -/
def coefficientOffsetList3 (bounds : CoefficientBounds3) :
    List IntegerPoint3 :=
  (((centeredIntegerList bounds.1).product
      (centeredIntegerList bounds.2.1)).product
    (centeredIntegerList bounds.2.2)).map fun entry =>
      (entry.1.1, entry.1.2, entry.2)

@[simp]
theorem mem_coefficientOffsetList3
    {bounds : CoefficientBounds3} {offset : IntegerPoint3} :
    offset ∈ coefficientOffsetList3 bounds ↔
      offset ∈ coefficientOffsetBox3 bounds := by
  rcases offset with ⟨first, second, third⟩
  simp [coefficientOffsetList3, mem_coefficientOffsetBox3, and_assoc]

/-- Every coefficient tuple occurs exactly once in the canonical scan. -/
theorem nodup_coefficientOffsetList3 (bounds : CoefficientBounds3) :
    (coefficientOffsetList3 bounds).Nodup := by
  have hfirst := nodup_centeredIntegerList bounds.1
  have hsecond := nodup_centeredIntegerList bounds.2.1
  have hthird := nodup_centeredIntegerList bounds.2.2
  have hproduct := (hfirst.product hsecond).product hthird
  exact hproduct.map (f := fun entry =>
      (entry.1.1, entry.1.2, entry.2)) (by
    intro left right heq
    rcases left with ⟨⟨leftFirst, leftSecond⟩, leftThird⟩
    rcases right with ⟨⟨rightFirst, rightSecond⟩, rightThird⟩
    simp only [Prod.mk.injEq] at heq
    simp [heq])

/-- The canonical list has one unique scan slot for every coefficient tuple
and the exact cardinality of the three-dimensional box. -/
theorem length_coefficientOffsetList3 (bounds : CoefficientBounds3) :
  (coefficientOffsetList3 bounds).length =
      coefficientOffsetBoxWork3 bounds := by
  simp [coefficientOffsetList3, coefficientOffsetBoxWork3, List.product,
    Nat.mul_assoc]

/-- Canonical offset enumeration with its exact work cardinality in the type. -/
def coefficientOffsetVector3 (bounds : CoefficientBounds3) :
    List.Vector IntegerPoint3 (coefficientOffsetBoxWork3 bounds) :=
  ⟨coefficientOffsetList3 bounds, length_coefficientOffsetList3 bounds⟩

/-- Map the canonical coefficient offsets without pattern-matching on the
concrete vector.  This preserves the exact length index while avoiding kernel
normalization of a large bounded offset list merely to expose its constructor. -/
@[noinline]
def mapCoefficientOffsetVector3 {α : Type} (bounds : CoefficientBounds3)
    (f : IntegerPoint3 → α) :
    List.Vector α (coefficientOffsetBoxWork3 bounds) :=
  ⟨(coefficientOffsetList3 bounds).map f, by
    rw [List.length_map, length_coefficientOffsetList3]⟩

/-- Forgetting the mapped vector's length index recovers the canonical list
map definitionally. -/
@[simp]
theorem toList_mapCoefficientOffsetVector3 (bounds : CoefficientBounds3)
    {α : Type} (f : IntegerPoint3 → α) :
    (mapCoefficientOffsetVector3 bounds f).toList =
      (coefficientOffsetList3 bounds).map f :=
  rfl

/-- Forgetting the length index recovers the canonical offset list. -/
@[simp]
theorem toList_coefficientOffsetVector3 (bounds : CoefficientBounds3) :
    (coefficientOffsetVector3 bounds).toList = coefficientOffsetList3 bounds :=
  rfl

/-- Exact number of coefficient tuples inspected by the fixed
three-dimensional nearest-plane window. -/
theorem nearestPlaneCoefficientBounds3_work :
    coefficientOffsetBoxWork3 nearestPlaneCoefficientBounds3 = 85 * 69 ^ 2 := by
  norm_num [coefficientOffsetBoxWork3, nearestPlaneCoefficientBounds3]

/-- Enumerate the lattice points represented by a bounded coefficient box
around a supplied nearest-plane center, retaining exactly those inside the
requested squared Euclidean ball.  This is an executable coefficient-space
search; it never scans an ambient coordinate cube. -/
def enumerateNearbyPoints3 (basis : IntegerBasis3)
    (target : IntegerPoint3) (radiusSquared : Nat)
    (coefficientCenter : IntegerPoint3) (bounds : CoefficientBounds3) :
    Finset IntegerPoint3 :=
  ((coefficientOffsetBox3 bounds).image fun offset =>
    basis.linearCombination (coefficientCenter.add offset)).filter fun point =>
      squaredDistance point.toVector target.toVector < radiusSquared

/-- Exact extensional contract of the executable coefficient-space nearby
point enumeration. -/
theorem mem_enumerateNearbyPoints3
    {basis : IntegerBasis3} {target point : IntegerPoint3}
    {radiusSquared : Nat} {coefficientCenter : IntegerPoint3}
    {bounds : CoefficientBounds3} :
    point ∈ enumerateNearbyPoints3 basis target radiusSquared
        coefficientCenter bounds ↔
      IsInsideSquaredBall target.toVector radiusSquared point.toVector ∧
        ∃ offset ∈ coefficientOffsetBox3 bounds,
          basis.linearCombination (coefficientCenter.add offset) = point := by
  classical
  simp only [enumerateNearbyPoints3, Finset.mem_filter, Finset.mem_image,
    IsInsideSquaredBall]
  aesop

/-- The enumeration work is bounded by the exact size of its independent
coefficient-offset box. -/
theorem enumerateNearbyPoints3_work_le
    (basis : IntegerBasis3) (target : IntegerPoint3)
    (radiusSquared : Nat) (coefficientCenter : IntegerPoint3)
    (bounds : CoefficientBounds3) :
    (enumerateNearbyPoints3 basis target radiusSquared
      coefficientCenter bounds).card ≤ coefficientOffsetBoxWork3 bounds := by
  classical
  unfold enumerateNearbyPoints3
  calc
    (((coefficientOffsetBox3 bounds).image fun offset =>
        basis.linearCombination (coefficientCenter.add offset)).filter fun point =>
          squaredDistance point.toVector target.toVector < radiusSquared).card ≤
        ((coefficientOffsetBox3 bounds).image fun offset =>
          basis.linearCombination (coefficientCenter.add offset)).card :=
      Finset.card_filter_le _ _
    _ ≤ (coefficientOffsetBox3 bounds).card := Finset.card_image_le
    _ = coefficientOffsetBoxWork3 bounds := by
      simp [coefficientOffsetBox3, coefficientOffsetBoxWork3,
        Finset.card_product, card_centeredIntegerInterval,
        Nat.mul_assoc]

end NumberTheory
