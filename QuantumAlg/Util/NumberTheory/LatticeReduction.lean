      htargetSecondEnvelope
  have hsecondFirstEvents : ∀ event ∈ secondFirst.events,
      event.OperandsLe envelope := by
    have hraw := integerPointDotExecution_events_operandsLe hbsecond hbfirst
    apply arithmeticEventsOperandsLe_mono hraw
    simpa only [Y, pow_two, Nat.mul_assoc] using hthreeYSquaredEnvelope
  have htargetFirstEvents : ∀ event ∈ targetFirst.events,
      event.OperandsLe envelope := by
    have hraw := integerPointDotExecution_events_operandsLe
