/-- The scalar inputs and comparisons of both literal LLL pair reductions fit
the common magnitude used by the sealed arithmetic audit. -/
theorem lllPairScalarBounds_of_reduced
    (basis : IntegerBasis3) (bound : Nat) (hfull : basis.FullRank)
    (hcurrent : basis.SquaredNormsLe bound)
    (hfirst : basis.sizeReduceFirstPair.1.SquaredNormsLe bound)
    (hsecond : basis.sizeReduceSecondPair.1.SquaredNormsLe bound) :
    let magnitude := 256 * (bound + 1) ^ 8
    (integerPointDot basis.second basis.first).natAbs ≤ magnitude ∧
      integerPointSquaredNorm basis.first ≤ magnitude ∧
        2 * integerPointSquaredNorm basis.sizeReduceFirstPair.1.second ≤ magnitude ∧
          basis.secondReductionNumerator.natAbs ≤ magnitude ∧
            integerPointAreaSquared basis.first basis.second ≤ magnitude ∧
              (integerPointDot
                (basis.reduceThirdBySecond basis.sizeReduceSecondPair.2.1).third
                (basis.reduceThirdBySecond basis.sizeReduceSecondPair.2.1).first).natAbs ≤
                  magnitude ∧
                2 * integerPointAreaSquared basis.sizeReduceSecondPair.1.first
                    basis.sizeReduceSecondPair.1.third ≤ magnitude := by
  let magnitude := 256 * (bound + 1) ^ 8
  change
    (integerPointDot basis.second basis.first).natAbs ≤ magnitude ∧
      integerPointSquaredNorm basis.first ≤ magnitude ∧
        2 * integerPointSquaredNorm basis.sizeReduceFirstPair.1.second ≤ magnitude ∧
          basis.secondReductionNumerator.natAbs ≤ magnitude ∧
            integerPointAreaSquared basis.first basis.second ≤ magnitude ∧
              (integerPointDot
                (basis.reduceThirdBySecond basis.sizeReduceSecondPair.2.1).third
                (basis.reduceThirdBySecond basis.sizeReduceSecondPair.2.1).first).natAbs ≤
                  magnitude ∧
                2 * integerPointAreaSquared basis.sizeReduceSecondPair.1.first
                    basis.sizeReduceSecondPair.1.third ≤ magnitude
  have hbase : 1 ≤ bound + 1 := by omega
  have hpowTwoEight : (bound + 1) ^ 2 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  have hpowFourEight : (bound + 1) ^ 4 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  have hpowSixEight : (bound + 1) ^ 6 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  have hsmall : 3 * (bound + 1) ^ 2 ≤ magnitude := by
    dsimp only [magnitude]
    exact Nat.mul_le_mul (by norm_num) hpowTwoEight
  have hcoordinate : bound ≤ magnitude := by
    have hlinear : bound ≤ (bound + 1) ^ 2 := by
      nlinarith [Nat.zero_le bound]
    exact hlinear.trans
      (hpowTwoEight.trans (Nat.le_mul_of_pos_left _ (by norm_num)))
  have htwice : 2 * bound ≤ magnitude := by
    have hlinear : 2 * bound ≤ 2 * (bound + 1) ^ 2 := by
      nlinarith [Nat.zero_le bound]
    calc
      2 * bound ≤ 2 * (bound + 1) ^ 2 := hlinear
      _ ≤ 3 * (bound + 1) ^ 2 :=
        Nat.mul_le_mul_right _ (by norm_num)
      _ ≤ magnitude := hsmall
  have hareaMagnitude : 12 * (bound + 1) ^ 4 ≤ magnitude := by
    dsimp only [magnitude]
    exact Nat.mul_le_mul (by norm_num) hpowFourEight
  have htwiceAreaMagnitude : 24 * (bound + 1) ^ 4 ≤ magnitude := by
    dsimp only [magnitude]
    exact Nat.mul_le_mul (by norm_num) hpowFourEight
  have hdotAfterSecondMagnitude : 75 * (bound + 1) ^ 6 ≤ magnitude := by
    dsimp only [magnitude]
    exact Nat.mul_le_mul (by norm_num) hpowSixEight
  have hcurrentFirst :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.first hcurrent.1
  have hcurrentSecond :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.second hcurrent.2.1
  have hcurrentThird :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.third hcurrent.2.2
  have hreducedFirst :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le
      basis.sizeReduceSecondPair.1.first hsecond.1
  have hreducedThird :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le
      basis.sizeReduceSecondPair.1.third hsecond.2.2
  have hdot : (integerPointDot basis.second basis.first).natAbs ≤
      3 * bound ^ 2 := by
    simpa [pow_two, Nat.mul_assoc] using
      integerPointDot_natAbs_le_of_coordinatesLe hcurrentSecond hcurrentFirst
  have hdotMagnitude : 3 * bound ^ 2 ≤ magnitude := by
    exact (Nat.mul_le_mul_left 3
      (Nat.pow_le_pow_left (Nat.le_succ bound) 2)).trans hsmall
  have hscaledDot :
      ((integerPointSquaredNorm basis.first : Int) *
        integerPointDot basis.third basis.second).natAbs ≤
        3 * bound ^ 3 := by
    rw [Int.natAbs_mul, Int.natAbs_natCast]
    calc
      integerPointSquaredNorm basis.first *
          (integerPointDot basis.third basis.second).natAbs ≤
        bound * (3 * bound ^ 2) :=
          Nat.mul_le_mul hcurrent.1 (by
            simpa [pow_two, Nat.mul_assoc] using
              integerPointDot_natAbs_le_of_coordinatesLe
                hcurrentThird hcurrentSecond)
      _ = 3 * bound ^ 3 := by ring
  have hdotProduct :
      (integerPointDot basis.third basis.first *
        integerPointDot basis.second basis.first).natAbs ≤
        9 * bound ^ 4 := by
    rw [Int.natAbs_mul]
    calc
      (integerPointDot basis.third basis.first).natAbs *
          (integerPointDot basis.second basis.first).natAbs ≤
        (3 * bound ^ 2) * (3 * bound ^ 2) :=
          Nat.mul_le_mul
            (by
              simpa [pow_two, Nat.mul_assoc] using
                integerPointDot_natAbs_le_of_coordinatesLe
                  hcurrentThird hcurrentFirst)
            hdot
      _ = 9 * bound ^ 4 := by ring
  have hnumerator : basis.secondReductionNumerator.natAbs ≤
      12 * (bound + 1) ^ 4 := by
    calc
      basis.secondReductionNumerator.natAbs ≤
          ((integerPointSquaredNorm basis.first : Int) *
              integerPointDot basis.third basis.second).natAbs +
            (integerPointDot basis.third basis.first *
              integerPointDot basis.second basis.first).natAbs := by
        exact Int.natAbs_sub_le _ _
      _ ≤ 3 * bound ^ 3 + 9 * bound ^ 4 :=
        Nat.add_le_add hscaledDot hdotProduct
      _ ≤ 12 * (bound + 1) ^ 4 := by
        nlinarith [Nat.zero_le bound]
  have harea : integerPointAreaSquared basis.first basis.second ≤
      12 * (bound + 1) ^ 4 := by
    exact (integerPointAreaSquared_le_of_coordinatesLe
      hcurrentFirst hcurrentSecond).trans (by
        exact Nat.mul_le_mul_left 12
          (Nat.pow_le_pow_left (Nat.le_succ bound) 4))
  have hareaNe : integerPointAreaSquared basis.first basis.second ≠ 0 := by
    intro hzero
    have hcrossZero :=
      (integerPointSquaredNorm_eq_zero_iff_internal
        (integerPointCross basis.first basis.second)).mp hzero
    apply hfull
    rw [IntegerBasis3.determinant_eq_third_dot_cross]
    simp [integerPointDot, hcrossZero]
  have hdenominatorPos : 1 ≤ basis.secondReductionDenominator := by
    have hareaOne : 1 ≤ integerPointAreaSquared basis.first basis.second :=
      Nat.one_le_iff_ne_zero.mpr hareaNe
    simpa [IntegerBasis3.secondReductionDenominator] using
      (show (1 : Int) ≤ (integerPointAreaSquared basis.first basis.second : Int) by
        exact_mod_cast hareaOne)
  let secondCoefficient := nearestIntegerCoefficient
    basis.secondReductionNumerator basis.secondReductionDenominator
  let afterSecond := basis.reduceThirdBySecond secondCoefficient
  let afterSecondBound := 25 * (bound + 1) ^ 5
  have hsecondCoefficient : secondCoefficient.natAbs ≤
      24 * (bound + 1) ^ 4 := by
    dsimp only [secondCoefficient]
    calc
      (nearestIntegerCoefficient basis.secondReductionNumerator
          basis.secondReductionDenominator).natAbs ≤
          2 * basis.secondReductionNumerator.natAbs :=
        nearestIntegerCoefficient_natAbs_le_two_mul _ _ (by omega)
      _ ≤ 2 * (12 * (bound + 1) ^ 4) :=
        Nat.mul_le_mul_left 2 hnumerator
      _ = 24 * (bound + 1) ^ 4 := by ring
  have hboundLeFifth : bound ≤ (bound + 1) ^ 5 := by
    have hboundSucc : bound ≤ bound + 1 := Nat.le_succ _
    exact hboundSucc.trans (by
      simpa only [pow_one] using
        (pow_le_pow_right' hbase (show 1 ≤ 5 by norm_num)))
  have hafterSecond : afterSecond.third.CoordinatesLe afterSecondBound := by
    have hraw := reducePoint_coordinatesLe secondCoefficient
      hcurrentThird hcurrentSecond
    have hrawBound :
        bound + secondCoefficient.natAbs * bound ≤ afterSecondBound := by
      calc
        bound + secondCoefficient.natAbs * bound ≤
            (bound + 1) ^ 5 +
              (24 * (bound + 1) ^ 4) * (bound + 1) :=
          Nat.add_le_add hboundLeFifth
            (Nat.mul_le_mul hsecondCoefficient (Nat.le_succ bound))
        _ = 25 * (bound + 1) ^ 5 := by ring
        _ = afterSecondBound := rfl
    exact hraw.mono hrawBound
  have hafterSecondFirst : afterSecond.first.CoordinatesLe bound := by
    simpa [afterSecond, IntegerBasis3.reduceThirdBySecond] using hcurrentFirst
  have hdotAfterSecond :
      (integerPointDot afterSecond.third afterSecond.first).natAbs ≤
        75 * (bound + 1) ^ 6 := by
    calc
      (integerPointDot afterSecond.third afterSecond.first).natAbs ≤
          3 * afterSecondBound * bound :=
        integerPointDot_natAbs_le_of_coordinatesLe hafterSecond hafterSecondFirst
      _ ≤ 3 * afterSecondBound * (bound + 1) := by
        simpa [Nat.mul_assoc] using
          Nat.mul_le_mul_left 3
            (Nat.mul_le_mul_left afterSecondBound (Nat.le_succ bound))
      _ = 75 * (bound + 1) ^ 6 := by
        dsimp only [afterSecondBound]
        ring
  have hsecondArea : integerPointAreaSquared basis.sizeReduceSecondPair.1.first
      basis.sizeReduceSecondPair.1.third ≤ 12 * (bound + 1) ^ 4 :=
    (integerPointAreaSquared_le_of_coordinatesLe
      hreducedFirst hreducedThird).trans
        (Nat.mul_le_mul_left 12
          (Nat.pow_le_pow_left (Nat.le_succ bound) 4))
  refine ⟨hdot.trans hdotMagnitude, hcurrent.1.trans hcoordinate,
    (Nat.mul_le_mul_left 2 hfirst.2.1).trans htwice,
    hnumerator.trans hareaMagnitude, harea.trans hareaMagnitude, ?_, ?_⟩
  · simpa [afterSecond, secondCoefficient, IntegerBasis3.sizeReduceSecondPair] using
      hdotAfterSecond.trans hdotAfterSecondMagnitude
  · calc
      2 * integerPointAreaSquared basis.sizeReduceSecondPair.1.first
          basis.sizeReduceSecondPair.1.third ≤
          2 * (12 * (bound + 1) ^ 4) :=
        Nat.mul_le_mul_left 2 hsecondArea
      _ = 24 * (bound + 1) ^ 4 := by ring
      _ ≤ magnitude := htwiceAreaMagnitude

/-- One exact LLL iteration.  Replay padding and arithmetic work are separate
projections of the same sealed execution. -/
structure LLLStepExecution3 where
  private mk ::
  /-- Basis after this iteration. -/
  nextBasis : IntegerBasis3
  /-- State-machine phase after this iteration. -/
  nextPhase : LLLPhase3
  /-- Exactly three auditable replay slots. -/
  replay : List.Vector LatticeReductionStep3 3
  /-- Arithmetic events actually evaluated by this iteration. -/
  arithmetic : List ArithmeticEvent

/-- Attach the non-forgeable result of one iteration to the existing replay
prefix. -/
def LLLStepExecution3.toState (execution : LLLStepExecution3)
    (state : LLLState3) : LLLState3 :=
  { basis := execution.nextBasis
    phase := execution.nextPhase
    steps := state.steps ++ execution.replay.toList }

/-- Execute one LLL iteration and produce both its fixed replay slots and its
operand-audited arithmetic trace. -/
def lllStepExecution3 (state : LLLState3) : LLLStepExecution3 :=
  match state.phase with
  | .first =>
      let reduced := firstPairExecution3 state.basis
      if reduced.passes then
        { nextBasis := reduced.reduced
          nextPhase := .second
          replay := ⟨[.reduceSecond reduced.coefficient, .pad, .pad], by simp⟩
          arithmetic := reduced.arithmetic }
      else
        { nextBasis := reduced.reduced.swapFirstSecond
          nextPhase := .first
          replay :=
            ⟨[.reduceSecond reduced.coefficient, .swapFirstSecond, .pad], by simp⟩
          arithmetic := reduced.arithmetic }
  | .second =>
      let reduced := secondPairExecution3 state.basis
      if reduced.passes then
        { nextBasis := reduced.reduced
          nextPhase := .done
          replay :=
            ⟨[.reduceThirdBySecond reduced.secondCoefficient,
              .reduceThirdByFirst reduced.firstCoefficient, .pad], by simp⟩
          arithmetic := reduced.arithmetic }
      else
        { nextBasis := reduced.reduced.swapSecondThird
          nextPhase := .first
          replay :=
            ⟨[.reduceThirdBySecond reduced.secondCoefficient,
              .reduceThirdByFirst reduced.firstCoefficient,
              .swapSecondThird], by simp⟩
          arithmetic := reduced.arithmetic }
  | .done =>
      { nextBasis := state.basis
        nextPhase := .done
        replay := ⟨[.pad, .pad, .pad], by simp⟩
        arithmetic := [] }

/-- If the current basis and both exact size-reduction results stay inside one
squared-norm envelope, every arithmetic operand evaluated by this same sealed
LLL step has at most the bit width of `256 * (bound + 1)^8`. -/
theorem lllStepExecution3_maxOperandWidth_le_of_reduced
    (state : LLLState3) (bound : Nat)
    (hfull : state.basis.FullRank)
    (hcurrent : state.basis.SquaredNormsLe bound)
    (hfirst : state.basis.sizeReduceFirstPair.1.SquaredNormsLe bound)
    (hsecond : state.basis.sizeReduceSecondPair.1.SquaredNormsLe bound) :
    arithmeticEventListMaxOperandWidth
        (lllStepExecution3 state).arithmetic ≤
      Nat.size (256 * (bound + 1) ^ 8) := by
  apply arithmeticEventListMaxOperandWidth_le_size_of_operandsLe
  cases hphase : state.phase with
  | first =>
      intro event hevent
      have hoperands := firstPairExecution3_arithmetic_operandsLe
        state.basis bound hfull hcurrent hfirst
      simp only [lllStepExecution3, hphase] at hevent
      split at hevent <;> exact hoperands event hevent
  | second =>
      intro event hevent
      have hoperands := secondPairExecution3_arithmetic_operandsLe
        state.basis bound hfull hcurrent hsecond
      simp only [lllStepExecution3, hphase] at hevent
      split at hevent <;> exact hoperands event hevent
  | done =>
      simp [lllStepExecution3, hphase]

end SealedLLLExecution

/-- Phase-indexed reduction invariant.  The first phase carries no local
certificate; the second phase has certified the first pair; the terminal phase
carries the complete three-dimensional LLL certificate. -/
def LLLState3.ReductionInvariant (state : LLLState3) : Prop :=
  match state.phase with
  | .first => True
  | .second =>
      |state.basis.firstGramSchmidtCoefficient| ≤ (1 : Rat) / 2 ∧
        state.basis.firstLovasz = true
  | .done => state.basis.IsReduced

/-- Standard LLL potential with the invariant full determinant factor omitted.
It is the product of the first squared norm and the first-two squared area. -/
def lllPotential3 (basis : IntegerBasis3) : Nat :=
  integerPointSquaredNorm basis.first *
    integerPointAreaSquared basis.first basis.second

@[simp]
theorem integerPointSquaredNorm_eq_zero_iff (point : IntegerPoint3) :
    integerPointSquaredNorm point = 0 ↔ point = (0, 0, 0) := by
  rcases point with ⟨first, second, third⟩
  simp [integerPointSquaredNorm, Prod.ext_iff, and_assoc]

/-- A full-rank basis has strictly positive LLL potential. -/
theorem lllPotential3_pos_of_fullRank {basis : IntegerBasis3}
    (hfull : basis.FullRank) : 0 < lllPotential3 basis := by
  rw [Nat.pos_iff_ne_zero]
  intro hzero
  rcases Nat.mul_eq_zero.mp hzero with hfirst | harea
  · have hvector := (integerPointSquaredNorm_eq_zero_iff basis.first).mp hfirst
    apply hfull
    simp [IntegerBasis3.determinant, integerPointDot, hvector]
  · have hcross :=
      (integerPointSquaredNorm_eq_zero_iff
        (integerPointCross basis.first basis.second)).mp harea
    apply hfull
    rw [IntegerBasis3.determinant_eq_third_dot_cross]
    simp [integerPointDot, hcross]

/-- Full rank makes the first Gram–Schmidt denominator nonzero. -/
theorem IntegerBasis3.FullRank.firstSquaredNorm_ne_zero
    {basis : IntegerBasis3} (hfull : basis.FullRank) :
    integerPointSquaredNorm basis.first ≠ 0 := by
  have hpositive := lllPotential3_pos_of_fullRank hfull
  exact Nat.ne_of_gt (Nat.pos_of_mul_pos_right hpositive)

/-- Full rank makes the second Gram–Schmidt denominator nonzero. -/
theorem IntegerBasis3.FullRank.secondReductionDenominator_ne_zero
    {basis : IntegerBasis3} (hfull : basis.FullRank) :
    basis.secondReductionDenominator ≠ 0 := by
  have hpositive := lllPotential3_pos_of_fullRank hfull
  have harea : 0 < integerPointAreaSquared basis.first basis.second :=
    Nat.pos_of_mul_pos_left hpositive
  change (integerPointAreaSquared basis.first basis.second : Int) ≠ 0
  exact_mod_cast Nat.ne_of_gt harea

/-- First-pair size reduction leaves the LLL potential unchanged. -/
theorem lllPotential3_reduceSecond (basis : IntegerBasis3)
    (coefficient : Int) :
    lllPotential3 (basis.reduceSecond coefficient) = lllPotential3 basis := by
  simp only [lllPotential3, IntegerBasis3.reduceSecond]
  rw [show integerPointAreaSquared basis.first
      (basis.second.sub (basis.first.smul coefficient)) =
      integerPointAreaSquared basis.first basis.second by
    unfold integerPointAreaSquared
    rw [integerPointCross_sub_smul_self]]

/-- Operations on the third row leave the LLL potential unchanged. -/
theorem lllPotential3_reduceThirdBySecond (basis : IntegerBasis3)
    (coefficient : Int) :
    lllPotential3 (basis.reduceThirdBySecond coefficient) =
      lllPotential3 basis := rfl

/-- Operations on the third row leave the LLL potential unchanged. -/
theorem lllPotential3_reduceThirdByFirst (basis : IntegerBasis3)
    (coefficient : Int) :
    lllPotential3 (basis.reduceThirdByFirst coefficient) =
      lllPotential3 basis := rfl

/-- The first-pair size-reduction stage preserves full rank. -/
theorem IntegerBasis3.FullRank.sizeReduceFirstPair
    {basis : IntegerBasis3} (hfull : basis.FullRank) :
    basis.sizeReduceFirstPair.1.FullRank := by
  simpa [IntegerBasis3.sizeReduceFirstPair] using
    hfull.reduceSecond basis.firstReductionCoefficient

/-- The second-pair size-reduction stage preserves full rank. -/
theorem IntegerBasis3.FullRank.sizeReduceSecondPair
    {basis : IntegerBasis3} (hfull : basis.FullRank) :
    basis.sizeReduceSecondPair.1.FullRank := by
  simp only [IntegerBasis3.sizeReduceSecondPair]
  exact (hfull.reduceThirdBySecond _).reduceThirdByFirst _

/-- The first-pair size-reduction stage preserves the LLL potential. -/
theorem lllPotential3_sizeReduceFirstPair (basis : IntegerBasis3) :
    lllPotential3 basis.sizeReduceFirstPair.1 = lllPotential3 basis := by
  simpa [IntegerBasis3.sizeReduceFirstPair] using
    lllPotential3_reduceSecond basis basis.firstReductionCoefficient

/-- The second-pair size-reduction stage preserves the LLL potential. -/
theorem lllPotential3_sizeReduceSecondPair (basis : IntegerBasis3) :
    lllPotential3 basis.sizeReduceSecondPair.1 = lllPotential3 basis := by
  simp only [IntegerBasis3.sizeReduceSecondPair]
  rw [lllPotential3_reduceThirdByFirst,
    lllPotential3_reduceThirdBySecond]

/-- Swapping the first pair replaces the first norm factor by the former
second norm while preserving the area factor. -/
theorem lllPotential3_swapFirstSecond (basis : IntegerBasis3) :
    lllPotential3 basis.swapFirstSecond =
      integerPointSquaredNorm basis.second *
        integerPointAreaSquared basis.first basis.second := by
  simp [lllPotential3, IntegerBasis3.swapFirstSecond,
    integerPointAreaSquared_comm]

/-- Swapping the second pair replaces the area factor by the former
first/third area. -/
theorem lllPotential3_swapSecondThird (basis : IntegerBasis3) :
    lllPotential3 basis.swapSecondThird =
      integerPointSquaredNorm basis.first *
        integerPointAreaSquared basis.first basis.third := rfl

/-- A failed first Lovász test halves the integer LLL potential after the
corresponding swap. -/
theorem twice_lllPotential3_swapFirstSecond_lt (basis : IntegerBasis3)
    (hfull : basis.FullRank) (hfail : basis.firstLovasz = false) :
    2 * lllPotential3 basis.swapFirstSecond < lllPotential3 basis := by
  have harea : 0 < integerPointAreaSquared basis.first basis.second := by
    have hpotential := lllPotential3_pos_of_fullRank hfull
    simpa [lllPotential3] using
      (Nat.pos_of_mul_pos_left hpotential)
  have hnorm :
      2 * integerPointSquaredNorm basis.second <
        integerPointSquaredNorm basis.first := by
    simpa [IntegerBasis3.firstLovasz, Bool.not_eq_true] using hfail
  rw [lllPotential3_swapFirstSecond, lllPotential3]
  simpa [Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using
    Nat.mul_lt_mul_of_pos_right hnorm harea

/-- A failed second Lovász test halves the integer LLL potential after the
corresponding swap. -/
theorem twice_lllPotential3_swapSecondThird_lt (basis : IntegerBasis3)
    (hfull : basis.FullRank) (hfail : basis.secondLovasz = false) :
    2 * lllPotential3 basis.swapSecondThird < lllPotential3 basis := by
  have hnorm : 0 < integerPointSquaredNorm basis.first := by
    have hpotential := lllPotential3_pos_of_fullRank hfull
    simpa [lllPotential3] using
      (Nat.pos_of_mul_pos_right hpotential)
  have harea :
      2 * integerPointAreaSquared basis.first basis.third <
        integerPointAreaSquared basis.first basis.second := by
    simpa [IntegerBasis3.secondLovasz, Bool.not_eq_true] using hfail
  rw [lllPotential3_swapSecondThird, lllPotential3]
  simpa [Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using
    Nat.mul_lt_mul_of_pos_left harea hnorm

/-- Halving a positive natural-number potential strictly decreases its binary
logarithm. -/
theorem Nat.log2_lt_of_twice_lt {next current : Nat} (hnext : 0 < next)
    (hhalf : 2 * next < current) : Nat.log2 next < Nat.log2 current := by
  rw [Nat.log2_eq_log_two, Nat.log2_eq_log_two]
  have hmono := Nat.log_mono_right (b := 2) (Nat.le_of_lt hhalf)
  have hmul : Nat.log 2 (2 * next) = Nat.log 2 next + 1 := by
    rw [Nat.mul_comm]
    exact Nat.log_mul_base (by omega) (Nat.ne_of_gt hnext)
  omega

/-- A simpler well-founded potential used for the executable state machine. -/
def lllTerminationMeasure3 (basis : IntegerBasis3) : Nat :=
  integerPointSquaredNorm basis.first +
    integerPointAreaSquared basis.first basis.second

/-- Phase penalty used to turn the logarithmic LLL potential into a strict
single-step measure.  Passing the first adjacent pair consumes this penalty;
passing the second pair terminates, while either swap decreases the logarithmic
potential by at least one. -/
def lllPhasePenalty3 : LLLPhase3 → Nat
  | .first => 1
  | .second | .done => 0

/-- Strict state-machine measure away from the terminal phase. -/
def lllStateMeasure3 (state : LLLState3) : Nat :=
  2 * Nat.log2 (lllPotential3 state.basis) +
    lllPhasePenalty3 state.phase

/-- Mathematical specification of one machine iteration.  The executable
definition below is proved equal to this compact form so invariant proofs do
not duplicate the arithmetic ledger. -/
private def lllStep3Specification (state : LLLState3) : LLLState3 :=
  match state.phase with
  | .first =>
      let reduced := state.basis.sizeReduceFirstPair
      if reduced.1.firstLovasz then
        { basis := reduced.1
          phase := .second
          steps := state.steps ++
            [.reduceSecond reduced.2, .pad, .pad] }
      else
        { basis := reduced.1.swapFirstSecond
          phase := .first
          steps := state.steps ++
            [.reduceSecond reduced.2, .swapFirstSecond, .pad] }
  | .second =>
      let reduced := state.basis.sizeReduceSecondPair
      if reduced.1.secondLovasz then
        { basis := reduced.1
          phase := .done
          steps := state.steps ++
            [.reduceThirdBySecond reduced.2.1,
              .reduceThirdByFirst reduced.2.2, .pad] }
      else
        { basis := reduced.1.swapSecondThird
          phase := .first
          steps := state.steps ++
            [.reduceThirdBySecond reduced.2.1,
              .reduceThirdByFirst reduced.2.2, .swapSecondThird] }
  | .done =>
      { state with steps := state.steps ++ [.pad, .pad, .pad] }

/-- One machine iteration, projected from the sealed execution that generates
both replay slots and arithmetic events. -/
def lllStep3 (state : LLLState3) : LLLState3 :=
  (lllStepExecution3 state).toState state

/-- The audited execution implements the compact mathematical state-machine
specification exactly. -/
private theorem lllStep3_eq_specification (state : LLLState3) :
    lllStep3 state = lllStep3Specification state := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3, lllStepExecution3, lllStep3Specification,
        hphase, LLLStepExecution3.toState,
        firstPairExecution3_reduced, firstPairExecution3_coefficient,
        firstPairExecution3_passes]
      split <;> rfl
  | second =>
      simp only [lllStep3, lllStepExecution3, lllStep3Specification,
        hphase, LLLStepExecution3.toState,
        secondPairExecution3_reduced,
        secondPairExecution3_secondCoefficient,
        secondPairExecution3_firstCoefficient,
        secondPairExecution3_passes]
      split <;> rfl
  | done =>
      simp [lllStep3, lllStepExecution3, lllStep3Specification, hphase,
        LLLStepExecution3.toState]

/-- The basis and phase selected by one first-pair iteration. -/
theorem lllStep3_first_basis_phase (state : LLLState3)
    (hphase : state.phase = .first) :
    ((lllStep3 state).basis =
      if state.basis.sizeReduceFirstPair.1.firstLovasz then
        state.basis.sizeReduceFirstPair.1
      else state.basis.sizeReduceFirstPair.1.swapFirstSecond) ∧
    ((lllStep3 state).phase =
      if state.basis.sizeReduceFirstPair.1.firstLovasz then .second else .first) := by
  rw [lllStep3_eq_specification]
  simp only [lllStep3Specification, hphase]
  split <;> exact ⟨rfl, rfl⟩

/-- The basis and phase selected by one second-pair iteration. -/
theorem lllStep3_second_basis_phase (state : LLLState3)
    (hphase : state.phase = .second) :
    ((lllStep3 state).basis =
      if state.basis.sizeReduceSecondPair.1.secondLovasz then
        state.basis.sizeReduceSecondPair.1
      else state.basis.sizeReduceSecondPair.1.swapSecondThird) ∧
    ((lllStep3 state).phase =
      if state.basis.sizeReduceSecondPair.1.secondLovasz then .done else .first) := by
  rw [lllStep3_eq_specification]
  simp only [lllStep3Specification, hphase]
  split <;> exact ⟨rfl, rfl⟩

/-- A terminal iteration keeps its basis and terminal phase. -/
theorem lllStep3_done_basis_phase (state : LLLState3)
    (hphase : state.phase = .done) :
    (lllStep3 state).basis = state.basis ∧ (lllStep3 state).phase = .done := by
  rw [lllStep3_eq_specification]
  simp only [lllStep3Specification, hphase]
  exact ⟨True.intro, True.intro⟩

/-- A first-phase iteration evaluates exactly the 29 arithmetic events of its
size reduction and Lovász comparison, independently of the branch result. -/
theorem lllStepExecution3_arithmetic_length_first (state : LLLState3)
    (hphase : state.phase = .first) :
    (lllStepExecution3 state).arithmetic.length = 29 := by
  simp [lllStepExecution3, hphase]
  split <;> simp

/-- A second-phase iteration evaluates exactly the 91 arithmetic events of its
two reductions and Lovász comparison, independently of the branch result. -/
theorem lllStepExecution3_arithmetic_length_second (state : LLLState3)
    (hphase : state.phase = .second) :
    (lllStepExecution3 state).arithmetic.length = 91 := by
  simp [lllStepExecution3, hphase]
  split <;> simp

/-- A terminal padded iteration performs no integer arithmetic. -/
theorem lllStepExecution3_arithmetic_done (state : LLLState3)
    (hdone : state.phase = .done) :
    (lllStepExecution3 state).arithmetic = [] := by
  simp [lllStepExecution3, hdone]

/-- Every reducer iteration emits at most the 91 arithmetic events of the
second-pair branch. -/
theorem lllStepExecution3_arithmetic_length_le (state : LLLState3) :
    (lllStepExecution3 state).arithmetic.length ≤ 91 := by
  cases hphase : state.phase with
  | first =>
      rw [lllStepExecution3_arithmetic_length_first state hphase]
      decide
  | second =>
      rw [lllStepExecution3_arithmetic_length_second state hphase]
  | done => rw [lllStepExecution3_arithmetic_done state hphase]; decide

/-- One reducer iteration preserves full rank. -/
theorem lllStep3_fullRank (state : LLLState3)
    (hfull : state.basis.FullRank) : (lllStep3 state).basis.FullRank := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split <;>
        simp_all [IntegerBasis3.sizeReduceFirstPair,
          IntegerBasis3.FullRank]
  | second =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split <;>
        simp_all [IntegerBasis3.sizeReduceSecondPair,
          IntegerBasis3.FullRank]
  | done =>
      simpa [lllStep3_eq_specification, lllStep3Specification, hphase]
        using hfull

/-- One reducer iteration never increases the global LLL potential. -/
theorem lllStep3_potential_le (state : LLLState3)
    (hfull : state.basis.FullRank) :
    lllPotential3 (lllStep3 state).basis ≤
      lllPotential3 state.basis := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split
      next _ => rw [lllPotential3_sizeReduceFirstPair]
      next hfail =>
        have hfullReduced := hfull.sizeReduceFirstPair
        have hhalf := twice_lllPotential3_swapFirstSecond_lt
          state.basis.sizeReduceFirstPair.1 hfullReduced
          (Bool.eq_false_of_not_eq_true hfail)
        rw [lllPotential3_sizeReduceFirstPair] at hhalf
        change
          lllPotential3 state.basis.sizeReduceFirstPair.1.swapFirstSecond ≤
            lllPotential3 state.basis
        omega
  | second =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split
      next _ => rw [lllPotential3_sizeReduceSecondPair]
      next hfail =>
        have hfullReduced := hfull.sizeReduceSecondPair
        have hhalf := twice_lllPotential3_swapSecondThird_lt
          state.basis.sizeReduceSecondPair.1 hfullReduced
          (Bool.eq_false_of_not_eq_true hfail)
        rw [lllPotential3_sizeReduceSecondPair] at hhalf
        change
          lllPotential3 state.basis.sizeReduceSecondPair.1.swapSecondThird ≤
            lllPotential3 state.basis
        omega
  | done =>
      simp [lllStep3_eq_specification, lllStep3Specification, hphase]

/-- One reducer iteration preserves determinant magnitude. -/
theorem lllStep3_determinant_natAbs (state : LLLState3) :
    (lllStep3 state).basis.determinant.natAbs =
      state.basis.determinant.natAbs := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split <;> simp [IntegerBasis3.sizeReduceFirstPair]
  | second =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split <;> simp [IntegerBasis3.sizeReduceSecondPair]
  | done =>
      simp [lllStep3_eq_specification, lllStep3Specification, hphase]

/-- If the current basis and both possible size-reduced bases obey the same
squared-norm envelope, then every branch of one reducer iteration obeys it. -/
theorem lllStep3_squaredNormsLe_of_reduced
    (state : LLLState3) (bound : Nat)
    (hcurrent : state.basis.SquaredNormsLe bound)
    (hfirst : state.basis.sizeReduceFirstPair.1.SquaredNormsLe bound)
    (hsecond : state.basis.sizeReduceSecondPair.1.SquaredNormsLe bound) :
    (lllStep3 state).basis.SquaredNormsLe bound := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split <;>
        simp_all [IntegerBasis3.SquaredNormsLe,
          IntegerBasis3.swapFirstSecond]
  | second =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split <;>
        simp_all [IntegerBasis3.SquaredNormsLe,
          IntegerBasis3.swapSecondThird]
  | done =>
      simpa [lllStep3_eq_specification, lllStep3Specification, hphase]
        using hcurrent

/-- One reducer iteration preserves the phase-indexed reduction certificate. -/
theorem lllStep3_reductionInvariant (state : LLLState3)
    (hfull : state.basis.FullRank)
    (hinvariant : state.ReductionInvariant) :
    (lllStep3 state).ReductionInvariant := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split
      next hpass =>
        change
          |IntegerBasis3.firstGramSchmidtCoefficient
              state.basis.sizeReduceFirstPair.1| ≤ (1 : Rat) / 2 ∧
            state.basis.sizeReduceFirstPair.1.firstLovasz = true
        exact ⟨
          state.basis.firstGramSchmidtCoefficient_sizeReduceFirstPair
            hfull.firstSquaredNorm_ne_zero,
          hpass⟩
      next hfail =>
        trivial
  | second =>
      have hinvariant' :
          |state.basis.firstGramSchmidtCoefficient| ≤ (1 : Rat) / 2 ∧
            state.basis.firstLovasz = true := by
        simpa [LLLState3.ReductionInvariant, hphase] using hinvariant
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split
      next hpass =>
        change state.basis.sizeReduceSecondPair.1.IsReduced
        refine {
          firstSizeReduced := ?_
          secondSizeReduced := ?_
          thirdFirstSizeReduced := ?_
          firstLovasz := ?_
          secondLovasz := hpass }
        · rw [state.basis.firstGramSchmidtCoefficient_sizeReduceSecondPair]
          exact hinvariant'.1
        · exact
            IntegerBasis3.secondGramSchmidtCoefficient_sizeReduceSecondPair
              state.basis hfull.secondReductionDenominator_ne_zero
        · exact
            IntegerBasis3.thirdFirstGramSchmidtCoefficient_sizeReduceSecondPair
              state.basis hfull.firstSquaredNorm_ne_zero
        · exact hinvariant'.2
      next hfail =>
        trivial
  | done =>
      simpa [lllStep3_eq_specification, lllStep3Specification, hphase,
        LLLState3.ReductionInvariant] using hinvariant

/-- If one reducer iteration has not terminated, its logarithmic phase measure
strictly decreases. -/
theorem lllStep3_measure_lt (state : LLLState3)
    (hfull : state.basis.FullRank)
    (hnext : (lllStep3 state).phase ≠ .done) :
    lllStateMeasure3 (lllStep3 state) < lllStateMeasure3 state := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split
      next hpass =>
        simp only [lllStateMeasure3, lllPhasePenalty3, hphase]
        rw [lllPotential3_sizeReduceFirstPair]
        omega
      next hfail =>
        have hfullReduced := hfull.sizeReduceFirstPair
        have hhalf := twice_lllPotential3_swapFirstSecond_lt
          state.basis.sizeReduceFirstPair.1
          hfullReduced (Bool.eq_false_of_not_eq_true hfail)
        have hpositive := lllPotential3_pos_of_fullRank
          hfullReduced.swapFirstSecond
        have hlog := Nat.log2_lt_of_twice_lt hpositive hhalf
        rw [lllPotential3_sizeReduceFirstPair] at hlog
        simp only [lllStateMeasure3, lllPhasePenalty3, hphase]
        omega
  | second =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split
      next hpass =>
        exact (hnext (by
          simp [lllStep3_eq_specification, lllStep3Specification,
            hphase, hpass])).elim
      next hfail =>
        have hfullReduced := hfull.sizeReduceSecondPair
        have hhalf := twice_lllPotential3_swapSecondThird_lt
          state.basis.sizeReduceSecondPair.1
          hfullReduced (Bool.eq_false_of_not_eq_true hfail)
        have hpositive := lllPotential3_pos_of_fullRank
          hfullReduced.swapSecondThird
        have hlog := Nat.log2_lt_of_twice_lt hpositive hhalf
        rw [lllPotential3_sizeReduceSecondPair] at hlog
        simp only [lllStateMeasure3, lllPhasePenalty3, hphase]
        omega
  | done =>
      exact (hnext (by
        simp [lllStep3_eq_specification, lllStep3Specification,
          hphase])).elim

/-- Run a fixed number of padded reducer iterations. -/
def lllRun3 : Nat → LLLState3 → LLLState3
  | 0, state => state
  | fuel + 1, state => lllRun3 fuel (lllStep3 state)

/-- One extra reducer step commutes with any fixed-fuel reducer run. -/
theorem lllRun3_step_comm (fuel : Nat) (state : LLLState3) :
    lllRun3 fuel (lllStep3 state) = lllStep3 (lllRun3 fuel state) := by
  induction fuel generalizing state with
  | zero => rfl
  | succ fuel ih =>
      simpa only [lllRun3] using ih (lllStep3 state)

/-- A successor-fuel run performs its final mathematical step after the shorter run. -/
theorem lllRun3_succ_last (fuel : Nat) (state : LLLState3) :
    lllRun3 (fuel + 1) state = lllStep3 (lllRun3 fuel state) := by
  rw [lllRun3]
  exact lllRun3_step_comm fuel state

section SealedLLLRunExecution

/-- One complete fixed-fuel execution.  Its final state and arithmetic events
are accumulated by the same recursion. -/
structure LLLRunExecution3 where
  private mk ::
  /-- Final reducer state. -/
  state : LLLState3
  /-- Arithmetic events in execution order. -/
  arithmetic : List ArithmeticEvent

/-- Execute a fixed number of audited LLL iterations. -/
def lllRunExecution3 : Nat → LLLState3 → LLLRunExecution3
  | 0, state => { state := state, arithmetic := [] }
  | fuel + 1, state =>
      let step := lllStepExecution3 state
      let rest := lllRunExecution3 fuel (step.toState state)
      { state := rest.state
        arithmetic := step.arithmetic ++ rest.arithmetic }

/-- Forgetting the arithmetic ledger yields exactly the established reducer
state recursion. -/
theorem lllRunExecution3_state (fuel : Nat) (state : LLLState3) :
    (lllRunExecution3 fuel state).state = lllRun3 fuel state := by
  induction fuel generalizing state with
  | zero => rfl
  | succ fuel ih =>
      simp only [lllRunExecution3, lllRun3]
      rw [ih]
      rfl

/-- Once the reducer is terminal, any remaining padded iterations contribute
no arithmetic events. -/
theorem lllRunExecution3_arithmetic_done (fuel : Nat) (state : LLLState3)
    (hdone : state.phase = .done) :
    (lllRunExecution3 fuel state).arithmetic = [] := by
  induction fuel generalizing state with
  | zero => rfl
  | succ fuel ih =>
      simp only [lllRunExecution3]
      rw [lllStepExecution3_arithmetic_done state hdone]
      simp only [List.nil_append]
      apply ih
      simp [LLLStepExecution3.toState, lllStepExecution3, hdone]

/-- A fixed-fuel run emits at most 91 actual arithmetic events per machine
iteration; padded terminal iterations emit none. -/
theorem lllRunExecution3_arithmetic_length_le (fuel : Nat)
    (state : LLLState3) :
    (lllRunExecution3 fuel state).arithmetic.length ≤ 91 * fuel := by
  induction fuel generalizing state with
  | zero => simp [lllRunExecution3]
  | succ fuel ih =>
      simp only [lllRunExecution3, List.length_append]
      have hstep := lllStepExecution3_arithmetic_length_le state
      have hrest := ih ((lllStepExecution3 state).toState state)
      omega

end SealedLLLRunExecution

/-- The terminal phase is stable under every number of padded iterations. -/
theorem lllRun3_phase_done (fuel : Nat) (state : LLLState3)
    (hdone : state.phase = .done) :
    (lllRun3 fuel state).phase = .done := by
  induction fuel generalizing state with
  | zero => simpa [lllRun3] using hdone
  | succ fuel ih =>
      rw [lllRun3]
      apply ih
      simp [lllStep3_eq_specification, lllStep3Specification, hdone]

/-- Full rank is invariant under a fixed-fuel reducer run. -/
theorem lllRun3_fullRank (fuel : Nat) (state : LLLState3)
    (hfull : state.basis.FullRank) :
    (lllRun3 fuel state).basis.FullRank := by
  induction fuel generalizing state with
  | zero => simpa [lllRun3] using hfull
  | succ fuel ih =>
      rw [lllRun3]
      exact ih (lllStep3 state) (lllStep3_fullRank state hfull)

/-- The phase-indexed reduction certificate is invariant under a fixed-fuel
run. -/
theorem lllRun3_reductionInvariant (fuel : Nat) (state : LLLState3)
    (hfull : state.basis.FullRank)
    (hinvariant : state.ReductionInvariant) :
    (lllRun3 fuel state).ReductionInvariant := by
  induction fuel generalizing state with
  | zero => simpa [lllRun3] using hinvariant
  | succ fuel ih =>
      rw [lllRun3]
      exact ih (lllStep3 state) (lllStep3_fullRank state hfull)
        (lllStep3_reductionInvariant state hfull hinvariant)

/-- Any fuel strictly larger than the initial state measure is sufficient to
reach the terminal phase. -/
theorem lllRun3_done_of_measure_lt (fuel : Nat) (state : LLLState3)
    (hfull : state.basis.FullRank)
    (hfuel : lllStateMeasure3 state < fuel) :
    (lllRun3 fuel state).phase = .done := by
  induction fuel generalizing state with
  | zero => omega
  | succ fuel ih =>
      rw [lllRun3]
      by_cases hnext : (lllStep3 state).phase = .done
      · exact lllRun3_phase_done fuel (lllStep3 state) hnext
      · apply ih (lllStep3 state) (lllStep3_fullRank state hfull)
        have hdecrease := lllStep3_measure_lt state hfull hnext
        omega

/-- Input-dependent logarithmic-potential iteration budget. -/
def lllFuel3 (basis : IntegerBasis3) : Nat :=
  2 * (Nat.log2 (lllPotential3 basis + 1) + 1) + 2

/-- The public logarithmic budget dominates the initial machine measure. -/
theorem lllStateMeasure3_initial_lt_fuel (basis : IntegerBasis3) :
    lllStateMeasure3
        { basis := basis, phase := .first, steps := [] } <
      lllFuel3 basis := by
  have hlog : Nat.log2 (lllPotential3 basis) ≤
      Nat.log2 (lllPotential3 basis + 1) := by
    rw [Nat.log2_eq_log_two, Nat.log2_eq_log_two]
    exact Nat.log_mono_right (Nat.le_add_right _ _)
  simp only [lllStateMeasure3, lllPhasePenalty3, lllFuel3]
  omega

/-- Every full-rank input reaches the terminal phase within the public fuel. -/
theorem lllRun3_initial_phase_done (basis : IntegerBasis3)
    (hfull : basis.FullRank) :
    (lllRun3 (lllFuel3 basis)
      { basis := basis, phase := .first, steps := [] }).phase = .done :=
  lllRun3_done_of_measure_lt _ _ hfull
    (lllStateMeasure3_initial_lt_fuel basis)

/-- One machine iteration appends exactly three elementary trace steps. -/
theorem lllStep3_steps_length (state : LLLState3) :
    (lllStep3 state).steps.length = state.steps.length + 3 := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      by_cases hpass : state.basis.sizeReduceFirstPair.1.firstLovasz = true <;>
        simp [hpass]
  | second =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      by_cases hpass : state.basis.sizeReduceSecondPair.1.secondLovasz = true <;>
        simp [hpass]
  | done =>
      simp [lllStep3_eq_specification, lllStep3Specification, hphase]

/-- A reducer run appends exactly three steps per padded iteration. -/
theorem lllRun3_steps_length (fuel : Nat) (state : LLLState3) :
    (lllRun3 fuel state).steps.length = state.steps.length + 3 * fuel := by
  induction fuel generalizing state with
  | zero => simp [lllRun3]
  | succ fuel ih =>
      rw [lllRun3]
      rw [ih, lllStep3_steps_length]
      omega

/-- Replaying the three steps appended by one iteration produces its basis. -/
theorem replayLatticeReduction3_append
    (initialSteps finalSteps : List LatticeReductionStep3)
    (basis : IntegerBasis3) :
    replayLatticeReduction3 (initialSteps ++ finalSteps) basis =
      replayLatticeReduction3 finalSteps
        (replayLatticeReduction3 initialSteps basis) := by
  simp [replayLatticeReduction3, List.foldl_append]

/-- Extending a valid replay prefix by one machine iteration yields its new
current basis. -/
theorem lllStep3_replay (initial : IntegerBasis3) (state : LLLState3)
    (hstate : replayLatticeReduction3 state.steps initial = state.basis) :
    replayLatticeReduction3 (lllStep3 state).steps initial =
      (lllStep3 state).basis := by
  cases hphase : state.phase with
  | first =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split <;>
        simp_all [IntegerBasis3.sizeReduceFirstPair,
          replayLatticeReduction3, LatticeReductionStep3.apply]
  | second =>
      simp only [lllStep3_eq_specification, lllStep3Specification, hphase]
      split <;>
        simp_all [IntegerBasis3.sizeReduceSecondPair,
          replayLatticeReduction3, LatticeReductionStep3.apply]
  | done =>
      simpa [lllStep3_eq_specification, lllStep3Specification, hphase,
        replayLatticeReduction3_append,
        replayLatticeReduction3, LatticeReductionStep3.apply] using hstate

/-- The prefix replay invariant is preserved by every number of machine
iterations. -/
theorem lllRun3_replay_from (initial : IntegerBasis3) (fuel : Nat)
    (state : LLLState3)
    (hstate : replayLatticeReduction3 state.steps initial = state.basis) :
    replayLatticeReduction3 (lllRun3 fuel state).steps initial =
      (lllRun3 fuel state).basis := by
  induction fuel generalizing state with
  | zero => simpa [lllRun3] using hstate
  | succ fuel ih =>
      rw [lllRun3]
      exact ih (lllStep3 state) (lllStep3_replay initial state hstate)

/-- Replaying all steps generated from the initial basis yields the final
basis of the fixed-fuel run. -/
theorem lllRun3_replay (basis : IntegerBasis3) (fuel : Nat) :
    replayLatticeReduction3
        (lllRun3 fuel { basis := basis, phase := .first, steps := [] }).steps
        basis =
      (lllRun3 fuel
        { basis := basis, phase := .first, steps := [] }).basis := by
  exact lllRun3_replay_from basis fuel
    { basis := basis, phase := .first, steps := [] }
    (by simp [replayLatticeReduction3])

section SealedReducerBuilders

/-- Fixed-dimensional exact reducer with auditable padded replay and arithmetic
traces produced by one execution.  The public output is the basis already
computed by that execution; replay is retained only as a proof certificate. -/
def lllReduce3 (basis : IntegerBasis3) : LatticeReductionTrace3 :=
  let execution := lllRunExecution3 (lllFuel3 basis)
    { basis := basis, phase := .first, steps := [] }
  let final := execution.state
  { input := basis
    steps := final.steps
    arithmetic := execution.arithmetic
    output := final.basis
    output_eq := by
      change
        replayLatticeReduction3
            (lllRunExecution3 (lllFuel3 basis)
              { basis := basis, phase := .first, steps := [] }).state.steps
            basis =
          (lllRunExecution3 (lllFuel3 basis)
            { basis := basis, phase := .first, steps := [] }).state.basis
      rw [lllRunExecution3_state]
      exact lllRun3_replay basis (lllFuel3 basis) }

/-- Run the same padded reducer with a caller-independent public fuel budget.
Clients use this form after proving that a public bound dominates the input
state measure.  Every execution then has the same trace length, while the
output and lattice certificates still come from the actual input basis. -/
def lllReduce3WithFuel (fuel : Nat)
    (basis : IntegerBasis3) : LatticeReductionTrace3 :=
  let execution := lllRunExecution3 fuel
    { basis := basis, phase := .first, steps := [] }
  let final := execution.state
  { input := basis
    steps := final.steps
    arithmetic := execution.arithmetic
    output := final.basis
    output_eq := by
      change
        replayLatticeReduction3
            (lllRunExecution3 fuel
              { basis := basis, phase := .first, steps := [] }).state.steps
            basis =
          (lllRunExecution3 fuel
            { basis := basis, phase := .first, steps := [] }).state.basis
      rw [lllRunExecution3_state]
      exact lllRun3_replay basis fuel }

end SealedReducerBuilders

/-- A public-fuel reduction trace contains exactly three padded elementary
steps for every machine iteration. -/
theorem lllReduce3WithFuel_steps_length (fuel : Nat)
    (basis : IntegerBasis3) :
    (lllReduce3WithFuel fuel basis).steps.length = 3 * fuel := by
  change
    (lllRunExecution3 fuel
      { basis := basis, phase := .first, steps := [] }).state.steps.length = _
  rw [lllRunExecution3_state]
  rw [lllRun3_steps_length]
  simp

/-- The public-fuel trace output is the basis reached by the exact state
machine after that many padded iterations. -/
theorem lllReduce3WithFuel_output_eq_finalBasis (fuel : Nat)
    (basis : IntegerBasis3) :
    (lllReduce3WithFuel fuel basis).output =
      (lllRun3 fuel
        { basis := basis, phase := .first, steps := [] }).basis := by
  change
    (lllRunExecution3 fuel
      { basis := basis, phase := .first, steps := [] }).state.basis = _
  rw [lllRunExecution3_state]

/-- A public-fuel reduction preserves the represented integer lattice. -/
theorem lllReduce3WithFuel_spans (fuel : Nat) (basis : IntegerBasis3) :
    basis.SameLattice (lllReduce3WithFuel fuel basis).output :=
  (lllReduce3WithFuel fuel basis).spans

/-- A public-fuel reduction preserves full rank. -/
theorem lllReduce3WithFuel_fullRank (fuel : Nat) (basis : IntegerBasis3)
    (hfull : basis.FullRank) :
    (lllReduce3WithFuel fuel basis).output.FullRank := by
  rw [lllReduce3WithFuel_output_eq_finalBasis]
  exact lllRun3_fullRank fuel
    { basis := basis, phase := .first, steps := [] } hfull

/-- Any public fuel larger than the initial logarithmic state measure yields a
complete size-reduced and Lovász-reduced basis. -/
theorem lllReduce3WithFuel_isReduced (fuel : Nat) (basis : IntegerBasis3)
    (hfull : basis.FullRank)
    (hfuel : lllStateMeasure3
        { basis := basis, phase := .first, steps := [] } < fuel) :
    (lllReduce3WithFuel fuel basis).output.IsReduced := by
  rw [lllReduce3WithFuel_output_eq_finalBasis]
  let initial : LLLState3 :=
    { basis := basis, phase := .first, steps := [] }
  let final := lllRun3 fuel initial
  have hinitial : initial.ReductionInvariant := by
    simp [initial, LLLState3.ReductionInvariant]
  have hinvariant : final.ReductionInvariant :=
    lllRun3_reductionInvariant fuel initial hfull hinitial
  have hdone : final.phase = .done :=
    lllRun3_done_of_measure_lt fuel initial hfull (by simpa [initial] using hfuel)
  change final.basis.IsReduced
  simpa [LLLState3.ReductionInvariant, hdone] using hinvariant

/-- The sealed execution output is the basis reached by the state machine. -/
theorem lllReduce3_output_eq_finalBasis (basis : IntegerBasis3) :
    (lllReduce3 basis).output =
      (lllRun3 (lllFuel3 basis)
        { basis := basis, phase := .first, steps := [] }).basis := by
  change
    (lllRunExecution3 (lllFuel3 basis)
      { basis := basis, phase := .first, steps := [] }).state.basis = _
  rw [lllRunExecution3_state]

/-- The executable reducer preserves full rank as well as the represented
lattice. -/
theorem lllReduce3_fullRank (basis : IntegerBasis3)
    (hfull : basis.FullRank) : (lllReduce3 basis).output.FullRank := by
  rw [lllReduce3_output_eq_finalBasis]
  exact lllRun3_fullRank (lllFuel3 basis)
    { basis := basis, phase := .first, steps := [] } hfull

/-- Every full-rank input is transformed into an exact size-reduced,
Lovász-reduced basis. -/
theorem lllReduce3_isReduced (basis : IntegerBasis3)
    (hfull : basis.FullRank) : (lllReduce3 basis).output.IsReduced := by
  rw [lllReduce3_output_eq_finalBasis]
  let initial : LLLState3 :=
    { basis := basis, phase := .first, steps := [] }
  let final := lllRun3 (lllFuel3 basis) initial
  have hinitial : initial.ReductionInvariant := by
    simp [initial, LLLState3.ReductionInvariant]
  have hinvariant : final.ReductionInvariant :=
    lllRun3_reductionInvariant (lllFuel3 basis) initial hfull hinitial
  have hdone : final.phase = .done := by
    exact lllRun3_initial_phase_done basis hfull
  change final.basis.IsReduced
  simpa [LLLState3.ReductionInvariant, hdone] using hinvariant

/-- The executable reducer preserves the input integer lattice. -/
theorem lllReduce3_spans (basis : IntegerBasis3) :
    basis.SameLattice (lllReduce3 basis).output :=
  (lllReduce3 basis).spans

/-- The padded trace length is exactly the public work bound. -/
theorem lllReduce3_stepCount_le (basis : IntegerBasis3) :
    (lllReduce3 basis).steps.length ≤ 3 * lllFuel3 basis := by
  change
    (lllRunExecution3 (lllFuel3 basis)
      { basis := basis, phase := .first, steps := [] }).state.steps.length ≤ _
  rw [lllRunExecution3_state]
  rw [lllRun3_steps_length]
  simp

/-! ### Exact nearest-plane coordinates -/

/-- Symmetry of the exact integer dot product. -/
theorem integerPointDot_comm (left right : IntegerPoint3) :
    integerPointDot left right = integerPointDot right left := by
  simp [integerPointDot]
  ring

/-- Dotting a basis combination with a fixed point is integer-linear in its
three coefficients. -/
theorem IntegerBasis3.integerPointDot_linearCombination
    (basis : IntegerBasis3) (coefficients point : IntegerPoint3) :
    integerPointDot (basis.linearCombination coefficients) point =
      coefficients.1 * integerPointDot basis.first point +
        coefficients.2.1 * integerPointDot basis.second point +
          coefficients.2.2 * integerPointDot basis.third point := by
  rcases basis with ⟨first, second, third⟩
  rcases first with ⟨f₁, f₂, f₃⟩
  rcases second with ⟨s₁, s₂, s₃⟩
  rcases third with ⟨t₁, t₂, t₃⟩
  rcases coefficients with ⟨c₁, c₂, c₃⟩
  rcases point with ⟨p₁, p₂, p₃⟩
  simp [IntegerBasis3.linearCombination, integerPointDot,
    IntegerPoint3.add, IntegerPoint3.smul]
  ring

/-- Coordinate of a point along the first Gram–Schmidt direction. -/
def IntegerBasis3.firstOrthogonalCoordinate (basis : IntegerBasis3)
    (point : IntegerPoint3) : Rat :=
  (integerPointDot point basis.first : Rat) /
    (integerPointSquaredNorm basis.first : Rat)

/-- Coordinate of a point along the second Gram–Schmidt direction.  The
formula is cleared over the squared first-two area, so it remains exact over
the rationals. -/
def IntegerBasis3.secondOrthogonalCoordinate (basis : IntegerBasis3)
    (point : IntegerPoint3) : Rat :=
  (((integerPointSquaredNorm basis.first : Int) *
      integerPointDot point basis.second -
    integerPointDot basis.second basis.first *
      integerPointDot point basis.first : Int) : Rat) /
    (integerPointAreaSquared basis.first basis.second : Rat)

/-- Coordinate of a point along the third Gram–Schmidt direction.  In three
dimensions this is the corresponding determinant quotient. -/
def IntegerBasis3.thirdOrthogonalCoordinate (basis : IntegerBasis3)
    (point : IntegerPoint3) : Rat :=
  (integerPointDot point
      (integerPointCross basis.first basis.second) : Rat) /
    (basis.determinant : Rat)

/-- Third coefficient selected by exact nearest-plane rounding. -/
def IntegerBasis3.nearestPlaneThirdCoefficient (basis : IntegerBasis3)
    (target : IntegerPoint3) : Int :=
  round (basis.thirdOrthogonalCoordinate target)

/-- Second coefficient selected after removing the chosen third-direction
contribution. -/
def IntegerBasis3.nearestPlaneSecondCoefficient (basis : IntegerBasis3)
    (target : IntegerPoint3) : Int :=
  round (basis.secondOrthogonalCoordinate target -
    (basis.nearestPlaneThirdCoefficient target : Rat) *
      basis.secondGramSchmidtCoefficient)

/-- First coefficient selected after removing the chosen second and third
direction contributions. -/
def IntegerBasis3.nearestPlaneFirstCoefficient (basis : IntegerBasis3)
    (target : IntegerPoint3) : Int :=
  round (basis.firstOrthogonalCoordinate target -
    (basis.nearestPlaneSecondCoefficient target : Rat) *
      basis.firstGramSchmidtCoefficient -
    (basis.nearestPlaneThirdCoefficient target : Rat) *
      basis.thirdFirstGramSchmidtCoefficient)

/-- Exact three-dimensional Babai nearest-plane coefficient center. -/
def IntegerBasis3.nearestPlaneCoefficientCenter (basis : IntegerBasis3)
    (target : IntegerPoint3) : IntegerPoint3 :=
  (basis.nearestPlaneFirstCoefficient target,
    basis.nearestPlaneSecondCoefficient target,
    basis.nearestPlaneThirdCoefficient target)

/-! ### Audited nearest-plane execution -/

/-- Cleared integer formula for the rounded third coordinate. -/
private def IntegerBasis3.clearedNearestPlaneThirdCoefficient
    (basis : IntegerBasis3) (target : IntegerPoint3) : Int :=
  nearestIntegerCoefficient
    (integerPointDot target (integerPointCross basis.first basis.second))
    (integerPointDot basis.third
      (integerPointCross basis.first basis.second))

/-- Cleared integer formula for the rounded second coordinate after a supplied
third coefficient has been removed. -/
private def IntegerBasis3.clearedNearestPlaneSecondCoefficient
    (basis : IntegerBasis3) (target : IntegerPoint3) (third : Int) : Int :=
  nearestIntegerCoefficient
    ((integerPointSquaredNorm basis.first : Int) *
          integerPointDot target basis.second -
        integerPointDot basis.second basis.first *
          integerPointDot target basis.first -
        third * basis.secondReductionNumerator)
    basis.secondReductionDenominator

/-- Cleared integer formula for the rounded first coordinate after supplied
second and third coefficients have been removed. -/
private def IntegerBasis3.clearedNearestPlaneFirstCoefficient
    (basis : IntegerBasis3) (target : IntegerPoint3)
    (second third : Int) : Int :=
  nearestIntegerCoefficient
    (integerPointDot target basis.first -
      second * integerPointDot basis.second basis.first -
      third * integerPointDot basis.third basis.first)
    (integerPointSquaredNorm basis.first)

private theorem IntegerBasis3.clearedNearestPlaneThirdCoefficient_eq
    (basis : IntegerBasis3) (target : IntegerPoint3) :
    basis.clearedNearestPlaneThirdCoefficient target =
      basis.nearestPlaneThirdCoefficient target := by
  unfold IntegerBasis3.clearedNearestPlaneThirdCoefficient
    IntegerBasis3.nearestPlaneThirdCoefficient
    IntegerBasis3.thirdOrthogonalCoordinate nearestIntegerCoefficient
  rw [← basis.determinant_eq_third_dot_cross]

private theorem IntegerBasis3.clearedNearestPlaneSecondCoefficient_eq
    (basis : IntegerBasis3) (target : IntegerPoint3) :
    basis.clearedNearestPlaneSecondCoefficient target
        (basis.clearedNearestPlaneThirdCoefficient target) =
      basis.nearestPlaneSecondCoefficient target := by
  rw [basis.clearedNearestPlaneThirdCoefficient_eq]
  unfold IntegerBasis3.clearedNearestPlaneSecondCoefficient
    IntegerBasis3.nearestPlaneSecondCoefficient
    IntegerBasis3.secondOrthogonalCoordinate
    IntegerBasis3.secondGramSchmidtCoefficient
    IntegerBasis3.secondReductionNumerator
    IntegerBasis3.secondReductionDenominator nearestIntegerCoefficient
  congr 1
  push_cast
  ring

private theorem IntegerBasis3.clearedNearestPlaneFirstCoefficient_eq
    (basis : IntegerBasis3) (target : IntegerPoint3) :
    basis.clearedNearestPlaneFirstCoefficient target
        (basis.clearedNearestPlaneSecondCoefficient target
          (basis.clearedNearestPlaneThirdCoefficient target))
        (basis.clearedNearestPlaneThirdCoefficient target) =
      basis.nearestPlaneFirstCoefficient target := by
  rw [basis.clearedNearestPlaneSecondCoefficient_eq,
    basis.clearedNearestPlaneThirdCoefficient_eq]
  unfold IntegerBasis3.clearedNearestPlaneFirstCoefficient
    IntegerBasis3.nearestPlaneFirstCoefficient
    IntegerBasis3.firstOrthogonalCoordinate
    IntegerBasis3.firstGramSchmidtCoefficient
    IntegerBasis3.thirdFirstGramSchmidtCoefficient nearestIntegerCoefficient
  congr 1
  push_cast
  ring

/-- Execute the exact three-dimensional nearest-plane center once.  Common dot
products, norms, and the first-two-row cross product are shared by the three
coefficient calculations instead of recomputed per candidate offset. -/
private def nearestPlaneExecution3 (basis : IntegerBasis3)
    (target : IntegerPoint3) : ArithmeticExecution IntegerPoint3 :=
  let firstSecondCross := integerPointCrossExecution basis.first basis.second
  let thirdNumerator := integerPointDotExecution target firstSecondCross.value
  let thirdDenominator :=
    integerPointDotExecution basis.third firstSecondCross.value
  let thirdCoefficient :=
    roundedDivExecution thirdNumerator.value thirdDenominator.value

  let normFirst := integerPointSquaredNormExecution basis.first
  let targetSecond := integerPointDotExecution target basis.second
  let normTargetSecond :=
    intMulExecution (normFirst.value : Int) targetSecond.value
  let secondFirst := integerPointDotExecution basis.second basis.first
  let targetFirst := integerPointDotExecution target basis.first
  let secondFirstTargetFirst :=
    intMulExecution secondFirst.value targetFirst.value
  let secondCoordinateNumerator :=
    intSubExecution normTargetSecond.value secondFirstTargetFirst.value
  let thirdSecond := integerPointDotExecution basis.third basis.second
  let normThirdSecond :=
    intMulExecution (normFirst.value : Int) thirdSecond.value
  let thirdFirst := integerPointDotExecution basis.third basis.first
  let thirdFirstSecondFirst :=
    intMulExecution thirdFirst.value secondFirst.value
  let secondReductionNumerator :=
    intSubExecution normThirdSecond.value thirdFirstSecondFirst.value
  let scaledSecondReduction :=
    intMulExecution thirdCoefficient.value secondReductionNumerator.value
  let secondNumerator :=
    intSubExecution secondCoordinateNumerator.value scaledSecondReduction.value
  let firstSecondArea :=
    integerPointSquaredNormExecution firstSecondCross.value
  let secondCoefficient :=
    roundedDivExecution secondNumerator.value (firstSecondArea.value : Int)

  let scaledSecondFirst :=
    intMulExecution secondCoefficient.value secondFirst.value
  let scaledThirdFirst :=
    intMulExecution thirdCoefficient.value thirdFirst.value
  let afterSecond := intSubExecution targetFirst.value scaledSecondFirst.value
  let firstNumerator := intSubExecution afterSecond.value scaledThirdFirst.value
  let firstCoefficient :=
    roundedDivExecution firstNumerator.value (normFirst.value : Int)
  { value :=
      (firstCoefficient.value, secondCoefficient.value, thirdCoefficient.value)
    events :=
      firstSecondCross.events ++ thirdNumerator.events ++
      thirdDenominator.events ++ thirdCoefficient.events ++
      normFirst.events ++ targetSecond.events ++ normTargetSecond.events ++
      secondFirst.events ++ targetFirst.events ++
      secondFirstTargetFirst.events ++ secondCoordinateNumerator.events ++
      thirdSecond.events ++ normThirdSecond.events ++ thirdFirst.events ++
      thirdFirstSecondFirst.events ++ secondReductionNumerator.events ++
      scaledSecondReduction.events ++ secondNumerator.events ++
      firstSecondArea.events ++ secondCoefficient.events ++
      scaledSecondFirst.events ++ scaledThirdFirst.events ++
      afterSecond.events ++ firstNumerator.events ++ firstCoefficient.events }

private theorem nearestPlaneExecution3_value (basis : IntegerBasis3)
    (target : IntegerPoint3) :
    (nearestPlaneExecution3 basis target).value =
      basis.nearestPlaneCoefficientCenter target := by
  simp only [nearestPlaneExecution3, integerPointCrossExecution_value,
    integerPointDotExecution_value, integerPointSquaredNormExecution_value,
    roundedDivExecution_value, intMulExecution_value, intSubExecution_value]
  change
    (basis.clearedNearestPlaneFirstCoefficient target
        (basis.clearedNearestPlaneSecondCoefficient target
          (basis.clearedNearestPlaneThirdCoefficient target))
        (basis.clearedNearestPlaneThirdCoefficient target),
      basis.clearedNearestPlaneSecondCoefficient target
        (basis.clearedNearestPlaneThirdCoefficient target),
      basis.clearedNearestPlaneThirdCoefficient target) = _
  rw [basis.clearedNearestPlaneFirstCoefficient_eq,
    basis.clearedNearestPlaneSecondCoefficient_eq,
    basis.clearedNearestPlaneThirdCoefficient_eq]
  rfl

/-- Uniform magnitude envelope for every operand in the fixed-dimensional
nearest-plane execution. -/
def nearestPlaneArithmeticEnvelope3
    (basisBound targetBound : Nat) : Nat :=
  4096 * (targetBound + 1) * (basisBound + 1) ^ 8

private theorem nearestPlaneMonomial_le (basisBound targetBound : Nat)
    {coefficient exponent : Nat}
    (hcoefficient : coefficient ≤ 4096) (hexponent : exponent ≤ 8) :
    coefficient * (targetBound + 1) * (basisBound + 1) ^ exponent ≤
      nearestPlaneArithmeticEnvelope3 basisBound targetBound := by
  exact Nat.mul_le_mul
    (Nat.mul_le_mul hcoefficient (Nat.le_refl (targetBound + 1)))
    (pow_le_pow_right' (by omega) hexponent)

private theorem nearestPlaneBasisMonomial_le (basisBound targetBound : Nat)
    {coefficient exponent : Nat}
    (hcoefficient : coefficient ≤ 4096) (hexponent : exponent ≤ 8) :
    coefficient * (basisBound + 1) ^ exponent ≤
      nearestPlaneArithmeticEnvelope3 basisBound targetBound := by
  calc
    coefficient * (basisBound + 1) ^ exponent =
        coefficient * 1 * (basisBound + 1) ^ exponent := by ring
    _ ≤ coefficient * (targetBound + 1) * (basisBound + 1) ^ exponent :=
      Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (by omega))
    _ ≤ nearestPlaneArithmeticEnvelope3 basisBound targetBound :=
      nearestPlaneMonomial_le basisBound targetBound hcoefficient hexponent

set_option maxHeartbeats 1200000 in
-- The 25 execution segments share many nonlinear envelope facts; keep the
-- larger allowance local to this one composition proof.
private theorem nearestPlaneExecution3_bounds
    (basis : IntegerBasis3) (target : IntegerPoint3)
    (basisBound targetBound : Nat)
    (hfull : basis.FullRank)
    (hbasis : basis.SquaredNormsLe basisBound)
    (htarget : integerPointSquaredNorm target ≤ targetBound) :
    (∀ event ∈ (nearestPlaneExecution3 basis target).events,
      event.OperandsLe
        (nearestPlaneArithmeticEnvelope3 basisBound targetBound)) ∧
    (nearestPlaneExecution3 basis target).value.CoordinatesLe
      (nearestPlaneArithmeticEnvelope3 basisBound targetBound) := by
  let X := targetBound + 1
  let Y := basisBound + 1
  let envelope := nearestPlaneArithmeticEnvelope3 basisBound targetBound
  have hY : 1 ≤ Y := by simp [Y]
  have htargetLeX : targetBound ≤ X := by simp [X]
  have hbasisLeY : basisBound ≤ Y := by simp [Y]
  have hmonomial {coefficient exponent : Nat}
      (hcoefficient : coefficient ≤ 4096) (hexponent : exponent ≤ 8) :
      coefficient * X * Y ^ exponent ≤ envelope := by
    exact nearestPlaneMonomial_le basisBound targetBound
      hcoefficient hexponent
  have hbasisMonomial {coefficient exponent : Nat}
      (hcoefficient : coefficient ≤ 4096) (hexponent : exponent ≤ 8) :
      coefficient * Y ^ exponent ≤ envelope := by
    exact nearestPlaneBasisMonomial_le basisBound targetBound
      hcoefficient hexponent
  have hbfirst :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.first hbasis.1
  have hbsecond :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.second hbasis.2.1
  have hbthird :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.third hbasis.2.2
  have htargetCoordinates :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le target htarget

  let firstSecondCross := integerPointCrossExecution basis.first basis.second
  let thirdNumerator := integerPointDotExecution target firstSecondCross.value
  let thirdDenominator :=
    integerPointDotExecution basis.third firstSecondCross.value
  let thirdCoefficient :=
    roundedDivExecution thirdNumerator.value thirdDenominator.value
  let normFirst := integerPointSquaredNormExecution basis.first
  let targetSecond := integerPointDotExecution target basis.second
  let normTargetSecond :=
    intMulExecution (normFirst.value : Int) targetSecond.value
  let secondFirst := integerPointDotExecution basis.second basis.first
  let targetFirst := integerPointDotExecution target basis.first
  let secondFirstTargetFirst :=
    intMulExecution secondFirst.value targetFirst.value
  let secondCoordinateNumerator :=
    intSubExecution normTargetSecond.value secondFirstTargetFirst.value
  let thirdSecond := integerPointDotExecution basis.third basis.second
  let normThirdSecond :=
    intMulExecution (normFirst.value : Int) thirdSecond.value
  let thirdFirst := integerPointDotExecution basis.third basis.first
  let thirdFirstSecondFirst :=
    intMulExecution thirdFirst.value secondFirst.value
  let secondReductionNumerator :=
    intSubExecution normThirdSecond.value thirdFirstSecondFirst.value
  let scaledSecondReduction :=
    intMulExecution thirdCoefficient.value secondReductionNumerator.value
  let secondNumerator :=
    intSubExecution secondCoordinateNumerator.value scaledSecondReduction.value
  let firstSecondArea :=
    integerPointSquaredNormExecution firstSecondCross.value
  let secondCoefficient :=
    roundedDivExecution secondNumerator.value (firstSecondArea.value : Int)
  let scaledSecondFirst :=
    intMulExecution secondCoefficient.value secondFirst.value
  let scaledThirdFirst :=
    intMulExecution thirdCoefficient.value thirdFirst.value
  let afterSecond :=
    intSubExecution targetFirst.value scaledSecondFirst.value
  let firstNumerator :=
    intSubExecution afterSecond.value scaledThirdFirst.value
  let firstCoefficient :=
    roundedDivExecution firstNumerator.value (normFirst.value : Int)

  have hcrossCoordinates : firstSecondCross.value.CoordinatesLe
      (2 * Y ^ 2) := by
    have hraw := integerPointCross_coordinatesLe hbfirst hbsecond
    apply (show firstSecondCross.value.CoordinatesLe
      (2 * basisBound * basisBound) from by
        simpa [firstSecondCross] using hraw).mono
    dsimp only [Y]
    calc
      2 * basisBound * basisBound ≤
          2 * (basisBound + 1) * (basisBound + 1) :=
        Nat.mul_le_mul
          (Nat.mul_le_mul (Nat.le_refl 2) (Nat.le_succ basisBound))
          (Nat.le_succ basisBound)
      _ = 2 * (basisBound + 1) ^ 2 := by ring
  have hthirdNumerator : thirdNumerator.value.natAbs ≤
      6 * X * Y ^ 2 := by
    have hraw := integerPointDot_natAbs_le_of_coordinatesLe
      htargetCoordinates hcrossCoordinates
    change (integerPointDot target firstSecondCross.value).natAbs ≤ _
    calc
      (integerPointDot target firstSecondCross.value).natAbs ≤
          3 * targetBound * (2 * Y ^ 2) := hraw
      _ ≤ 3 * X * (2 * Y ^ 2) :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 3 htargetLeX)
      _ = 6 * X * Y ^ 2 := by ring
  have hthirdDenominator : thirdDenominator.value.natAbs ≤
      6 * Y ^ 3 := by
    have hraw := integerPointDot_natAbs_le_of_coordinatesLe
      hbthird hcrossCoordinates
    change (integerPointDot basis.third firstSecondCross.value).natAbs ≤ _
    calc
      (integerPointDot basis.third firstSecondCross.value).natAbs ≤
          3 * basisBound * (2 * Y ^ 2) := hraw
      _ ≤ 3 * Y * (2 * Y ^ 2) :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 3 hbasisLeY)
      _ = 6 * Y ^ 3 := by ring
  have hthirdDenominatorNe : thirdDenominator.value ≠ 0 := by
    change integerPointDot basis.third
      (integerPointCross basis.first basis.second) ≠ 0
    rw [← basis.determinant_eq_third_dot_cross]
    exact hfull
  have hthirdCoefficient : thirdCoefficient.value.natAbs ≤
      12 * X * Y ^ 2 := by
    change (nearestIntegerCoefficient thirdNumerator.value
      thirdDenominator.value).natAbs ≤ _
    calc
      (nearestIntegerCoefficient thirdNumerator.value
          thirdDenominator.value).natAbs ≤
          2 * thirdNumerator.value.natAbs :=
        nearestIntegerCoefficient_natAbs_le_two_mul _ _ hthirdDenominatorNe
      _ ≤ 2 * (6 * X * Y ^ 2) :=
        Nat.mul_le_mul_left 2 hthirdNumerator
      _ = 12 * X * Y ^ 2 := by ring
  have hnormFirst : normFirst.value ≤ Y := by
    simpa [normFirst] using hbasis.1.trans hbasisLeY
  have htargetSecond : targetSecond.value.natAbs ≤ 3 * X * Y := by
    change (integerPointDot target basis.second).natAbs ≤ _
    calc
      (integerPointDot target basis.second).natAbs ≤
          3 * targetBound * basisBound :=
        integerPointDot_natAbs_le_of_coordinatesLe
          htargetCoordinates hbsecond
      _ ≤ 3 * X * Y :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.le_refl 3) htargetLeX)
          hbasisLeY
  have hnormTargetSecond : normTargetSecond.value.natAbs ≤
      3 * X * Y ^ 2 := by
    change ((normFirst.value : Int) * targetSecond.value).natAbs ≤ _
    rw [Int.natAbs_mul, Int.natAbs_natCast]
    calc
      normFirst.value * targetSecond.value.natAbs ≤
          Y * (3 * X * Y) := Nat.mul_le_mul hnormFirst htargetSecond
      _ = 3 * X * Y ^ 2 := by ring
  have hsecondFirst : secondFirst.value.natAbs ≤ 3 * Y ^ 2 := by
    change (integerPointDot basis.second basis.first).natAbs ≤ _
    calc
      (integerPointDot basis.second basis.first).natAbs ≤
          3 * basisBound * basisBound :=
        integerPointDot_natAbs_le_of_coordinatesLe hbsecond hbfirst
      _ ≤ 3 * Y * Y :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.le_refl 3) hbasisLeY)
          hbasisLeY
      _ = 3 * Y ^ 2 := by ring
  have htargetFirst : targetFirst.value.natAbs ≤ 3 * X * Y := by
    change (integerPointDot target basis.first).natAbs ≤ _
    calc
      (integerPointDot target basis.first).natAbs ≤
          3 * targetBound * basisBound :=
        integerPointDot_natAbs_le_of_coordinatesLe htargetCoordinates hbfirst
      _ ≤ 3 * X * Y :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.le_refl 3) htargetLeX)
          hbasisLeY
  have hsecondFirstTargetFirst : secondFirstTargetFirst.value.natAbs ≤
      9 * X * Y ^ 3 := by
    change (secondFirst.value * targetFirst.value).natAbs ≤ _
    rw [Int.natAbs_mul]
    calc
      secondFirst.value.natAbs * targetFirst.value.natAbs ≤
          (3 * Y ^ 2) * (3 * X * Y) :=
        Nat.mul_le_mul hsecondFirst htargetFirst
      _ = 9 * X * Y ^ 3 := by ring
  have hsecondCoordinateNumerator :
      secondCoordinateNumerator.value.natAbs ≤ 12 * X * Y ^ 3 := by
    change (normTargetSecond.value - secondFirstTargetFirst.value).natAbs ≤ _
    calc
      (normTargetSecond.value - secondFirstTargetFirst.value).natAbs ≤
          normTargetSecond.value.natAbs +
            secondFirstTargetFirst.value.natAbs := Int.natAbs_sub_le _ _
      _ ≤ 3 * X * Y ^ 2 + 9 * X * Y ^ 3 :=
        Nat.add_le_add hnormTargetSecond hsecondFirstTargetFirst
      _ ≤ 12 * X * Y ^ 3 := by
        have hpow : Y ^ 2 ≤ Y ^ 3 :=
          pow_le_pow_right' hY (by norm_num)
        calc
          3 * X * Y ^ 2 + 9 * X * Y ^ 3 ≤
              3 * X * Y ^ 3 + 9 * X * Y ^ 3 :=
            Nat.add_le_add_right (Nat.mul_le_mul_left (3 * X) hpow) _
          _ = 12 * X * Y ^ 3 := by ring
  have hthirdSecond : thirdSecond.value.natAbs ≤ 3 * Y ^ 2 := by
    change (integerPointDot basis.third basis.second).natAbs ≤ _
    calc
      (integerPointDot basis.third basis.second).natAbs ≤
          3 * basisBound * basisBound :=
        integerPointDot_natAbs_le_of_coordinatesLe hbthird hbsecond
      _ ≤ 3 * Y * Y :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.le_refl 3) hbasisLeY)
          hbasisLeY
      _ = 3 * Y ^ 2 := by ring
  have hnormThirdSecond : normThirdSecond.value.natAbs ≤
      3 * Y ^ 3 := by
    change ((normFirst.value : Int) * thirdSecond.value).natAbs ≤ _
    rw [Int.natAbs_mul, Int.natAbs_natCast]
    calc
      normFirst.value * thirdSecond.value.natAbs ≤
          Y * (3 * Y ^ 2) := Nat.mul_le_mul hnormFirst hthirdSecond
      _ = 3 * Y ^ 3 := by ring
  have hthirdFirst : thirdFirst.value.natAbs ≤ 3 * Y ^ 2 := by
    change (integerPointDot basis.third basis.first).natAbs ≤ _
    calc
      (integerPointDot basis.third basis.first).natAbs ≤
          3 * basisBound * basisBound :=
        integerPointDot_natAbs_le_of_coordinatesLe hbthird hbfirst
      _ ≤ 3 * Y * Y :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.le_refl 3) hbasisLeY)
          hbasisLeY
      _ = 3 * Y ^ 2 := by ring
  have hthirdFirstSecondFirst : thirdFirstSecondFirst.value.natAbs ≤
      9 * Y ^ 4 := by
    change (thirdFirst.value * secondFirst.value).natAbs ≤ _
    rw [Int.natAbs_mul]
    calc
      thirdFirst.value.natAbs * secondFirst.value.natAbs ≤
          (3 * Y ^ 2) * (3 * Y ^ 2) :=
        Nat.mul_le_mul hthirdFirst hsecondFirst
      _ = 9 * Y ^ 4 := by ring
  have hsecondReductionNumerator :
      secondReductionNumerator.value.natAbs ≤ 12 * Y ^ 4 := by
    change (normThirdSecond.value - thirdFirstSecondFirst.value).natAbs ≤ _
    calc
      (normThirdSecond.value - thirdFirstSecondFirst.value).natAbs ≤
          normThirdSecond.value.natAbs +
            thirdFirstSecondFirst.value.natAbs := Int.natAbs_sub_le _ _
      _ ≤ 3 * Y ^ 3 + 9 * Y ^ 4 :=
        Nat.add_le_add hnormThirdSecond hthirdFirstSecondFirst
      _ ≤ 12 * Y ^ 4 := by
        have hpow : Y ^ 3 ≤ Y ^ 4 :=
          pow_le_pow_right' hY (by norm_num)
        calc
          3 * Y ^ 3 + 9 * Y ^ 4 ≤ 3 * Y ^ 4 + 9 * Y ^ 4 :=
            Nat.add_le_add_right (Nat.mul_le_mul_left 3 hpow) _
          _ = 12 * Y ^ 4 := by ring
  have hscaledSecondReduction : scaledSecondReduction.value.natAbs ≤
      144 * X * Y ^ 6 := by
    change (thirdCoefficient.value *
      secondReductionNumerator.value).natAbs ≤ _
    rw [Int.natAbs_mul]
    calc
      thirdCoefficient.value.natAbs *
          secondReductionNumerator.value.natAbs ≤
          (12 * X * Y ^ 2) * (12 * Y ^ 4) :=
        Nat.mul_le_mul hthirdCoefficient hsecondReductionNumerator
      _ = 144 * X * Y ^ 6 := by ring
  have hsecondNumerator : secondNumerator.value.natAbs ≤
      156 * X * Y ^ 6 := by
    change (secondCoordinateNumerator.value -
      scaledSecondReduction.value).natAbs ≤ _
    calc
      (secondCoordinateNumerator.value -
          scaledSecondReduction.value).natAbs ≤
          secondCoordinateNumerator.value.natAbs +
            scaledSecondReduction.value.natAbs := Int.natAbs_sub_le _ _
      _ ≤ 12 * X * Y ^ 3 + 144 * X * Y ^ 6 :=
        Nat.add_le_add hsecondCoordinateNumerator hscaledSecondReduction
      _ ≤ 156 * X * Y ^ 6 := by
        have hpow : Y ^ 3 ≤ Y ^ 6 :=
          pow_le_pow_right' hY (by norm_num)
        calc
          12 * X * Y ^ 3 + 144 * X * Y ^ 6 ≤
              12 * X * Y ^ 6 + 144 * X * Y ^ 6 :=
            Nat.add_le_add_right (Nat.mul_le_mul_left (12 * X) hpow) _
          _ = 156 * X * Y ^ 6 := by ring
  have hfirstSecondArea : firstSecondArea.value ≤ 12 * Y ^ 4 := by
    have hraw := integerPointSquaredNorm_le_of_coordinatesLe hcrossCoordinates
    have hbound : 3 * (2 * Y ^ 2) ^ 2 ≤ 12 * Y ^ 4 := by
      calc
        3 * (2 * Y ^ 2) ^ 2 = 12 * Y ^ 4 := by ring
        _ ≤ 12 * Y ^ 4 := Nat.le_refl _
    simpa [firstSecondArea] using hraw.trans hbound
  have hfirstSecondAreaNe : (firstSecondArea.value : Int) ≠ 0 := by
    have hareaNe : integerPointAreaSquared basis.first basis.second ≠ 0 := by
      intro hzero
      have hcrossZero :=
        (integerPointSquaredNorm_eq_zero_iff_internal
          (integerPointCross basis.first basis.second)).mp hzero
      apply hfull
      rw [basis.determinant_eq_third_dot_cross]
      simp [integerPointDot, hcrossZero]
    simpa [firstSecondArea, firstSecondCross, integerPointAreaSquared]
      using hareaNe
  have hsecondCoefficient : secondCoefficient.value.natAbs ≤
      312 * X * Y ^ 6 := by
    change (nearestIntegerCoefficient secondNumerator.value
      (firstSecondArea.value : Int)).natAbs ≤ _
    calc
      (nearestIntegerCoefficient secondNumerator.value
          (firstSecondArea.value : Int)).natAbs ≤
          2 * secondNumerator.value.natAbs :=
        nearestIntegerCoefficient_natAbs_le_two_mul _ _ hfirstSecondAreaNe
      _ ≤ 2 * (156 * X * Y ^ 6) :=
        Nat.mul_le_mul_left 2 hsecondNumerator
      _ = 312 * X * Y ^ 6 := by ring
  have hscaledSecondFirst : scaledSecondFirst.value.natAbs ≤
      936 * X * Y ^ 8 := by
    change (secondCoefficient.value * secondFirst.value).natAbs ≤ _
    rw [Int.natAbs_mul]
    calc
      secondCoefficient.value.natAbs * secondFirst.value.natAbs ≤
          (312 * X * Y ^ 6) * (3 * Y ^ 2) :=
        Nat.mul_le_mul hsecondCoefficient hsecondFirst
      _ = 936 * X * Y ^ 8 := by ring
  have hscaledThirdFirst : scaledThirdFirst.value.natAbs ≤
      36 * X * Y ^ 4 := by
    change (thirdCoefficient.value * thirdFirst.value).natAbs ≤ _
    rw [Int.natAbs_mul]
    calc
      thirdCoefficient.value.natAbs * thirdFirst.value.natAbs ≤
          (12 * X * Y ^ 2) * (3 * Y ^ 2) :=
        Nat.mul_le_mul hthirdCoefficient hthirdFirst
      _ = 36 * X * Y ^ 4 := by ring
  have hafterSecond : afterSecond.value.natAbs ≤ 939 * X * Y ^ 8 := by
    change (targetFirst.value - scaledSecondFirst.value).natAbs ≤ _
    calc
      (targetFirst.value - scaledSecondFirst.value).natAbs ≤
          targetFirst.value.natAbs + scaledSecondFirst.value.natAbs :=
        Int.natAbs_sub_le _ _
      _ ≤ 3 * X * Y + 936 * X * Y ^ 8 :=
        Nat.add_le_add htargetFirst hscaledSecondFirst
      _ ≤ 939 * X * Y ^ 8 := by
        have hpow : Y ≤ Y ^ 8 := by
          simpa only [pow_one] using
            (pow_le_pow_right' hY (show 1 ≤ 8 by norm_num))
        calc
          3 * X * Y + 936 * X * Y ^ 8 ≤
              3 * X * Y ^ 8 + 936 * X * Y ^ 8 :=
            Nat.add_le_add_right (Nat.mul_le_mul_left (3 * X) hpow) _
          _ = 939 * X * Y ^ 8 := by ring
  have hfirstNumerator : firstNumerator.value.natAbs ≤
      975 * X * Y ^ 8 := by
    change (afterSecond.value - scaledThirdFirst.value).natAbs ≤ _
    calc
      (afterSecond.value - scaledThirdFirst.value).natAbs ≤
          afterSecond.value.natAbs + scaledThirdFirst.value.natAbs :=
        Int.natAbs_sub_le _ _
      _ ≤ 939 * X * Y ^ 8 + 36 * X * Y ^ 4 :=
        Nat.add_le_add hafterSecond hscaledThirdFirst
      _ ≤ 975 * X * Y ^ 8 := by
        have hpow : Y ^ 4 ≤ Y ^ 8 :=
          pow_le_pow_right' hY (by norm_num)
        calc
          939 * X * Y ^ 8 + 36 * X * Y ^ 4 ≤
              939 * X * Y ^ 8 + 36 * X * Y ^ 8 :=
            Nat.add_le_add_left (Nat.mul_le_mul_left (36 * X) hpow) _
          _ = 975 * X * Y ^ 8 := by ring
  have hnormFirstNe : (normFirst.value : Int) ≠ 0 := by
    have hnormNe : integerPointSquaredNorm basis.first ≠ 0 := by
      intro hzero
      have hvector :=
        (integerPointSquaredNorm_eq_zero_iff_internal basis.first).mp hzero
      apply hfull
      simp [IntegerBasis3.determinant, integerPointDot, hvector]
    simpa [normFirst] using hnormNe
  have hfirstCoefficient : firstCoefficient.value.natAbs ≤
      1950 * X * Y ^ 8 := by
    change (nearestIntegerCoefficient firstNumerator.value
      (normFirst.value : Int)).natAbs ≤ _
    calc
      (nearestIntegerCoefficient firstNumerator.value
          (normFirst.value : Int)).natAbs ≤
          2 * firstNumerator.value.natAbs :=
        nearestIntegerCoefficient_natAbs_le_two_mul _ _ hnormFirstNe
      _ ≤ 2 * (975 * X * Y ^ 8) :=
        Nat.mul_le_mul_left 2 hfirstNumerator
      _ = 1950 * X * Y ^ 8 := by ring
  have hnormFirstEnvelope : normFirst.value ≤ envelope :=
    hnormFirst.trans (by
      simpa only [one_mul, pow_one] using
        (hbasisMonomial (coefficient := 1) (exponent := 1)
          (by norm_num) (by norm_num)))
  have htargetSecondEnvelope : targetSecond.value.natAbs ≤ envelope :=
    htargetSecond.trans (by
      simpa only [pow_one] using
        (hmonomial (coefficient := 3) (exponent := 1)
          (by norm_num) (by norm_num)))
  have htargetFirstEnvelope : targetFirst.value.natAbs ≤ envelope :=
    htargetFirst.trans (by
      simpa only [pow_one] using
        (hmonomial (coefficient := 3) (exponent := 1)
          (by norm_num) (by norm_num)))
  have hfirstSecondAreaEnvelope : firstSecondArea.value ≤ envelope :=
    hfirstSecondArea.trans
      (hbasisMonomial (coefficient := 12) (exponent := 4)
        (by norm_num) (by norm_num))
  have hthreeYSquaredEnvelope : 3 * Y ^ 2 ≤ envelope :=
    hbasisMonomial (coefficient := 3) (exponent := 2)
      (by norm_num) (by norm_num)
  have hthreeXYEnvelope : 3 * X * Y ≤ envelope := by
    simpa only [pow_one] using
      (hmonomial (coefficient := 3) (exponent := 1)
        (by norm_num) (by norm_num))
  have hcrossCoordinateSucc : 2 * Y ^ 2 + 1 ≤ 3 * Y ^ 2 := by
    have hYTwo : 1 ≤ Y ^ 2 := one_le_pow₀ hY
    calc
