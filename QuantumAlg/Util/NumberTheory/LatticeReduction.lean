private theorem firstPairExecution3_arithmetic_operandsLe
    (basis : IntegerBasis3) (bound : Nat) (hfull : basis.FullRank)
    (hcurrent : basis.SquaredNormsLe bound)
    (hreduced : basis.sizeReduceFirstPair.1.SquaredNormsLe bound) :
    ∀ event ∈ (firstPairExecution3 basis).arithmetic,
      event.OperandsLe (256 * (bound + 1) ^ 8) := by
  let magnitude := 256 * (bound + 1) ^ 8
  have hbase : 1 ≤ bound + 1 := by omega
  have hpowTwoEight : (bound + 1) ^ 2 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  have hpowThreeEight : (bound + 1) ^ 3 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  have hpowOneThree : bound + 1 ≤ (bound + 1) ^ 3 := by
    simpa only [pow_one] using
      (pow_le_pow_right' hbase (show 1 ≤ 3 by norm_num))
  have hsmall : 3 * (bound + 1) ^ 2 ≤ magnitude := by
    dsimp only [magnitude]
    exact Nat.mul_le_mul (by norm_num) hpowTwoEight
  have hdotEventSmall : 3 * (bound + 1) * (bound + 1) ≤ magnitude := by
    simpa [pow_two, Nat.mul_assoc] using hsmall
  have hcoordinate : bound ≤ magnitude := by
    have hlinear : bound ≤ (bound + 1) ^ 2 := by
      nlinarith [Nat.zero_le bound]
    exact hlinear.trans (hpowTwoEight.trans
      (Nat.le_mul_of_pos_left _ (by norm_num)))
  have htwo : 2 ≤ magnitude := by
    have hpowPos : 0 < (bound + 1) ^ 8 := by positivity
    dsimp only [magnitude]
    exact (by norm_num : 2 ≤ 256).trans
      (Nat.le_mul_of_pos_right 256 hpowPos)
  have htwice : 2 * bound ≤ magnitude := by
    have hlinear : 2 * bound ≤ 2 * (bound + 1) ^ 2 := by
      nlinarith [Nat.zero_le bound]
    calc
      2 * bound ≤ 2 * (bound + 1) ^ 2 := hlinear
      _ ≤ 3 * (bound + 1) ^ 2 :=
        Nat.mul_le_mul_right _ (by norm_num)
      _ ≤ magnitude := hsmall
  have hcurrentFirst :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.first hcurrent.1
  have hcurrentSecond :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.second hcurrent.2.1
  have hreducedFirst :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le
      basis.sizeReduceFirstPair.1.first hreduced.1
  have hreducedSecond :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le
      basis.sizeReduceFirstPair.1.second hreduced.2.1
  have hdot : (integerPointDot basis.second basis.first).natAbs ≤
      3 * bound ^ 2 := by
    simpa [pow_two, Nat.mul_assoc] using
      integerPointDot_natAbs_le_of_coordinatesLe
        hcurrentSecond hcurrentFirst
  have hdotMagnitude : 3 * bound ^ 2 ≤ magnitude := by
    exact (Nat.mul_le_mul_left 3
      (Nat.pow_le_pow_left (Nat.le_succ bound) 2)).trans hsmall
  have hdenominatorPos : 1 ≤
      (integerPointSquaredNorm basis.first : Int) := by
    have hnormNe : integerPointSquaredNorm basis.first ≠ 0 := by
      intro hzero
      have hvector :=
        (integerPointSquaredNorm_eq_zero_iff_internal basis.first).mp hzero
      apply hfull
      simp [IntegerBasis3.determinant, integerPointDot, hvector]
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hnormNe
  have hcoefficient : basis.firstReductionCoefficient.natAbs ≤
      6 * bound ^ 2 := by
    have hround := nearestIntegerCoefficient_natAbs_le_two_mul
      (integerPointDot basis.second basis.first)
      (integerPointSquaredNorm basis.first) (by omega)
    calc
      basis.firstReductionCoefficient.natAbs ≤
          2 * (integerPointDot basis.second basis.first).natAbs := hround
      _ ≤ 2 * (3 * bound ^ 2) := Nat.mul_le_mul_left 2 hdot
      _ = 6 * bound ^ 2 := by ring
  have hreduceMagnitude :
      (bound + 1) + (6 * bound ^ 2 + 1) * (bound + 1) ≤
        magnitude := by
    have hcoefficientTerm : 6 * bound ^ 2 + 1 ≤
        7 * (bound + 1) ^ 2 := by
      nlinarith [Nat.zero_le bound]
    calc
      (bound + 1) + (6 * bound ^ 2 + 1) * (bound + 1) ≤
          (bound + 1) + (7 * (bound + 1) ^ 2) * (bound + 1) :=
        Nat.add_le_add_left (Nat.mul_le_mul_right _ hcoefficientTerm) _
      _ = (bound + 1) + 7 * (bound + 1) ^ 3 := by ring
      _ ≤ (bound + 1) ^ 3 + 7 * (bound + 1) ^ 3 :=
        Nat.add_le_add_right hpowOneThree _
      _ = 8 * (bound + 1) ^ 3 := by ring
      _ ≤ 256 * (bound + 1) ^ 8 :=
        Nat.mul_le_mul (by norm_num) hpowThreeEight
      _ = magnitude := rfl
  intro event hevent
  simp only [firstPairExecution3, List.mem_append] at hevent
  rcases hevent with
      (((((((hdotEvent | hdenominatorEvent) | hcoefficientEvent) |
        hreduceEvent) | hfirstNormEvent) | hsecondNormEvent) |
        htwiceEvent) | hpassesEvent)
  · exact (integerPointDotExecution_events_operandsLe
      hcurrentSecond hcurrentFirst event hdotEvent).mono hdotEventSmall
  · exact (integerPointSquaredNormExecution_events_operandsLe
      hcurrentFirst event hdenominatorEvent).mono hsmall
  · simp only [roundedDivExecution, List.mem_singleton] at hcoefficientEvent
    subst event
    simp only [ArithmeticEvent.OperandsLe,
      integerPointDotExecution_value, integerPointSquaredNormExecution_value]
    exact ⟨hdot.trans hdotMagnitude,
      hcurrent.1.trans hcoordinate⟩
  · exact (reducePointExecution_events_operandsLe
      basis.firstReductionCoefficient hcurrentSecond hcurrentFirst
      hcoefficient event (by
        simpa [IntegerBasis3.firstReductionCoefficient,
          IntegerBasis3.sizeReduceFirstPair, roundedDivExecution] using
          hreduceEvent)).mono
        hreduceMagnitude
  · exact (integerPointSquaredNormExecution_events_operandsLe
      hreducedFirst event (by
        simpa [IntegerBasis3.sizeReduceFirstPair,
          IntegerBasis3.firstReductionCoefficient,
          IntegerBasis3.reduceSecond] using hfirstNormEvent)).mono hsmall
  · exact (integerPointSquaredNormExecution_events_operandsLe
      hreducedSecond event (by
        simpa [IntegerBasis3.sizeReduceFirstPair,
          IntegerBasis3.firstReductionCoefficient,
          IntegerBasis3.reduceSecond, roundedDivExecution] using
          hsecondNormEvent)).mono hsmall
  · simp only [natMulExecution, List.mem_singleton] at htwiceEvent
    subst event
    simp only [ArithmeticEvent.OperandsLe,
      integerPointSquaredNormExecution_value]
    exact ⟨htwo, hreduced.2.1.trans hcoordinate⟩
  · simp only [natLeExecution, List.mem_singleton] at hpassesEvent
    subst event
    simp only [ArithmeticEvent.OperandsLe, natMulExecution,
      integerPointSquaredNormExecution_value]
    exact ⟨hreduced.1.trans hcoordinate,
      (Nat.mul_le_mul_left 2 hreduced.2.1).trans htwice⟩

private structure SecondPairExecution3 where
  reduced : IntegerBasis3
  secondCoefficient : Int
  firstCoefficient : Int
  passes : Bool
  arithmetic : List ArithmeticEvent

/-- Execute second-pair size reduction and its Lovász comparison from one
operand-audited arithmetic spine. -/
private def secondPairExecution3 (basis : IntegerBasis3) :
    SecondPairExecution3 :=
  let normFirst := integerPointSquaredNormExecution basis.first
  let dotThirdSecond := integerPointDotExecution basis.third basis.second
  let scaledDotThirdSecond :=
    intMulExecution normFirst.value dotThirdSecond.value
  let dotThirdFirst := integerPointDotExecution basis.third basis.first
  let dotSecondFirst := integerPointDotExecution basis.second basis.first
  let dotProduct := intMulExecution dotThirdFirst.value dotSecondFirst.value
  let numerator := intSubExecution scaledDotThirdSecond.value dotProduct.value
  let denominator := integerPointAreaSquaredExecution basis.first basis.second
  let secondCoefficient :=
    roundedDivExecution numerator.value (denominator.value : Int)
  let reducedThirdBySecond :=
    reducePointExecution basis.third basis.second secondCoefficient.value
  let afterSecond : IntegerBasis3 :=
    { basis with third := reducedThirdBySecond.value }
  let dotAfterSecondFirst :=
    integerPointDotExecution afterSecond.third afterSecond.first
  let normAfterSecondFirst :=
    integerPointSquaredNormExecution afterSecond.first
  let firstCoefficient := roundedDivExecution dotAfterSecondFirst.value
    (normAfterSecondFirst.value : Int)
  let reducedThirdByFirst :=
    reducePointExecution afterSecond.third afterSecond.first
      firstCoefficient.value
  let reduced : IntegerBasis3 :=
    { afterSecond with third := reducedThirdByFirst.value }
  let firstArea := integerPointAreaSquaredExecution reduced.first reduced.second
  let secondArea := integerPointAreaSquaredExecution reduced.first reduced.third
  let twiceSecondArea := natMulExecution 2 secondArea.value
  let passes := natLeExecution firstArea.value twiceSecondArea.value
  { reduced := reduced
    secondCoefficient := secondCoefficient.value
    firstCoefficient := firstCoefficient.value
    passes := passes.value
    arithmetic := normFirst.events ++ dotThirdSecond.events ++
      scaledDotThirdSecond.events ++ dotThirdFirst.events ++
      dotSecondFirst.events ++ dotProduct.events ++ numerator.events ++
      denominator.events ++ secondCoefficient.events ++
      reducedThirdBySecond.events ++ dotAfterSecondFirst.events ++
      normAfterSecondFirst.events ++ firstCoefficient.events ++
      reducedThirdByFirst.events ++ firstArea.events ++ secondArea.events ++
      twiceSecondArea.events ++ passes.events }

