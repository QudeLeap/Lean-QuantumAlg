  have hreducedThird :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le
      basis.sizeReduceSecondPair.1.third hreduced.2.2
  have hdotThirdSecond :
      (integerPointDot basis.third basis.second).natAbs ≤ 3 * bound ^ 2 := by
    simpa [pow_two, Nat.mul_assoc] using
      integerPointDot_natAbs_le_of_coordinatesLe
        hcurrentThird hcurrentSecond
  have hdotThirdFirst :
      (integerPointDot basis.third basis.first).natAbs ≤ 3 * bound ^ 2 := by
    simpa [pow_two, Nat.mul_assoc] using
      integerPointDot_natAbs_le_of_coordinatesLe hcurrentThird hcurrentFirst
  have hdotSecondFirst :
      (integerPointDot basis.second basis.first).natAbs ≤ 3 * bound ^ 2 := by
    simpa [pow_two, Nat.mul_assoc] using
      integerPointDot_natAbs_le_of_coordinatesLe hcurrentSecond hcurrentFirst
  have hdotMagnitude : 3 * bound ^ 2 ≤ magnitude := by
    exact (Nat.mul_le_mul_left 3
      (Nat.pow_le_pow_left (Nat.le_succ bound) 2)).trans hsmall
  have hscaledDot :
      ((integerPointSquaredNorm basis.first : Int) *
        integerPointDot basis.third basis.second).natAbs ≤
        3 * bound ^ 3 := by
    rw [Int.natAbs_mul, Int.natAbs_natCast]
    calc
      integerPointSquaredNorm basis.first *
          (integerPointDot basis.third basis.second).natAbs ≤
        bound * (3 * bound ^ 2) :=
          Nat.mul_le_mul hcurrent.1 hdotThirdSecond
      _ = 3 * bound ^ 3 := by ring
  have hdotProduct :
      (integerPointDot basis.third basis.first *
        integerPointDot basis.second basis.first).natAbs ≤
        9 * bound ^ 4 := by
    rw [Int.natAbs_mul]
    calc
      (integerPointDot basis.third basis.first).natAbs *
          (integerPointDot basis.second basis.first).natAbs ≤
        (3 * bound ^ 2) * (3 * bound ^ 2) :=
          Nat.mul_le_mul hdotThirdFirst hdotSecondFirst
      _ = 9 * bound ^ 4 := by ring
  have hscaledToArea : 3 * bound ^ 3 ≤ 12 * (bound + 1) ^ 4 := by
    have hbasePower : bound ^ 3 ≤ (bound + 1) ^ 4 :=
      (Nat.pow_le_pow_left (Nat.le_succ bound) 3).trans
