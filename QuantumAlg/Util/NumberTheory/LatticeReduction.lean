      _ = 24 * (bound + 1) ^ 4 := by ring
  have hboundLeFifth : bound ≤ (bound + 1) ^ 5 := by
    have hboundSucc : bound ≤ bound + 1 := Nat.le_succ _
    exact hboundSucc.trans (by
      simpa only [pow_one] using
        (pow_le_pow_right' hbase (show 1 ≤ 5 by norm_num)))
  have hafterSecond : afterSecond.third.CoordinatesLe afterSecondBound := by
    have hraw := reducePoint_coordinatesLe secondCoefficient
      hcurrentThird hcurrentSecond
    have hrawBound :
        bound + secondCoefficient.natAbs * bound ≤ afterSecondBound := by
      calc
        bound + secondCoefficient.natAbs * bound ≤
            (bound + 1) ^ 5 +
              (24 * (bound + 1) ^ 4) * (bound + 1) :=
          Nat.add_le_add hboundLeFifth
            (Nat.mul_le_mul hsecondCoefficient (Nat.le_succ bound))
        _ = 25 * (bound + 1) ^ 5 := by ring
        _ = afterSecondBound := rfl
    exact hraw.mono hrawBound
  have hafterSecondFirst : afterSecond.first.CoordinatesLe bound := by
    simpa [afterSecond, IntegerBasis3.reduceThirdBySecond] using hcurrentFirst
  have hdotAfterSecond :
      (integerPointDot afterSecond.third afterSecond.first).natAbs ≤
        75 * (bound + 1) ^ 6 := by
    calc
      (integerPointDot afterSecond.third afterSecond.first).natAbs ≤
          3 * afterSecondBound * bound :=
        integerPointDot_natAbs_le_of_coordinatesLe
          hafterSecond hafterSecondFirst
      _ ≤ 3 * afterSecondBound * (bound + 1) :=
        by
          simpa [Nat.mul_assoc] using
            Nat.mul_le_mul_left 3
              (Nat.mul_le_mul_left afterSecondBound (Nat.le_succ bound))
      _ = 75 * (bound + 1) ^ 6 := by
        dsimp only [afterSecondBound]
        ring
  have hfirstDenominatorPos : 1 ≤
      (integerPointSquaredNorm afterSecond.first : Int) := by
    have hnormNe : integerPointSquaredNorm afterSecond.first ≠ 0 := by
      simpa [afterSecond, IntegerBasis3.reduceThirdBySecond] using
        (show integerPointSquaredNorm basis.first ≠ 0 from by
          intro hzero
          have hvector :=
            (integerPointSquaredNorm_eq_zero_iff_internal basis.first).mp hzero
          apply hfull
          simp [IntegerBasis3.determinant, integerPointDot, hvector])
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hnormNe
  have hfirstCoefficient : firstCoefficient.natAbs ≤
      150 * (bound + 1) ^ 6 := by
    dsimp only [firstCoefficient]
    calc
      (nearestIntegerCoefficient
          (integerPointDot afterSecond.third afterSecond.first)
          (integerPointSquaredNorm afterSecond.first)).natAbs ≤
          2 * (integerPointDot afterSecond.third afterSecond.first).natAbs :=
        nearestIntegerCoefficient_natAbs_le_two_mul _ _ (by omega)
      _ ≤ 2 * (75 * (bound + 1) ^ 6) :=
        Nat.mul_le_mul_left 2 hdotAfterSecond
      _ = 150 * (bound + 1) ^ 6 := by ring
  have hreduceSecondMagnitude :
      (bound + 1) + (24 * (bound + 1) ^ 4 + 1) * (bound + 1) ≤
        magnitude := by
    simpa only [magnitude] using secondPairReduceSecondMagnitude_le bound
  have hdotAfterEventsMagnitude :
      3 * (afterSecondBound + 1) * (bound + 1) ≤ magnitude := by
    have hafterPlus : afterSecondBound + 1 ≤
        26 * (bound + 1) ^ 5 := by
      have hpowFivePos : 1 ≤ (bound + 1) ^ 5 := by
        have : 0 < (bound + 1) ^ 5 := by positivity
        omega
      dsimp only [afterSecondBound]
      calc
        25 * (bound + 1) ^ 5 + 1 ≤
            25 * (bound + 1) ^ 5 + (bound + 1) ^ 5 :=
          Nat.add_le_add_left hpowFivePos _
        _ = 26 * (bound + 1) ^ 5 := by ring
    calc
      3 * (afterSecondBound + 1) * (bound + 1) ≤
          3 * (26 * (bound + 1) ^ 5) * (bound + 1) :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left 3 hafterPlus)
      _ = 78 * (bound + 1) ^ 6 := by ring
      _ ≤ 256 * (bound + 1) ^ 8 :=
        Nat.mul_le_mul (by norm_num) hpowSixEight
      _ = magnitude := rfl
  have hreduceFirstMagnitude :
      (afterSecondBound + 1) +
          (150 * (bound + 1) ^ 6 + 1) * (bound + 1) ≤ magnitude := by
    simpa only [magnitude, afterSecondBound] using
      secondPairReduceFirstMagnitude_le bound
  have hnormFirst := arithmeticEventsOperandsLe_mono
    (integerPointSquaredNormExecution_events_operandsLe hcurrentFirst) hsmall
  have hnormFirstOperand :
      (integerPointSquaredNorm basis.first : Int).natAbs ≤ magnitude := by
    simpa using hcurrent.1.trans hcoordinate
  have hnormAfterSecondFirstOperand :
      (integerPointSquaredNorm afterSecond.first : Int).natAbs ≤ magnitude := by
    simpa [afterSecond, IntegerBasis3.reduceThirdBySecond] using hnormFirstOperand
  have hdotThirdSecondEvents := arithmeticEventsOperandsLe_mono
    (integerPointDotExecution_events_operandsLe
      hcurrentThird hcurrentSecond) hdotEventSmall
  have hscaledDotEvents := intMulExecution_events_operandsLe
    hnormFirstOperand (hdotThirdSecond.trans hdotMagnitude)
  have hdotThirdFirstEvents := arithmeticEventsOperandsLe_mono
    (integerPointDotExecution_events_operandsLe
      hcurrentThird hcurrentFirst) hdotEventSmall
  have hdotSecondFirstEvents := arithmeticEventsOperandsLe_mono
    (integerPointDotExecution_events_operandsLe
      hcurrentSecond hcurrentFirst) hdotEventSmall
  have hdotProductEvents := intMulExecution_events_operandsLe
    (hdotThirdFirst.trans hdotMagnitude)
    (hdotSecondFirst.trans hdotMagnitude)
  have hnumeratorEvents := intSubExecution_events_operandsLe
    (hscaledDot.trans (hscaledToArea.trans hareaMagnitude))
    (hdotProduct.trans (hdotProductToArea.trans hareaMagnitude))
  have hdenominatorEvents := arithmeticEventsOperandsLe_mono
    (integerPointAreaSquaredExecution_events_operandsLe
      hcurrentFirst hcurrentSecond) hareaMagnitude
  have hareaOperand : basis.secondReductionDenominator.natAbs ≤ magnitude := by
    simpa [IntegerBasis3.secondReductionDenominator] using
      harea.trans hareaMagnitude
  have hsecondCoefficientEvents := roundedDivExecution_events_operandsLe
    (hnumerator.trans hareaMagnitude) hareaOperand
  have hreduceSecondEvents := arithmeticEventsOperandsLe_mono
    (reducePointExecution_events_operandsLe secondCoefficient
      hcurrentThird hcurrentSecond hsecondCoefficient) hreduceSecondMagnitude
  have hdotAfterEvents := arithmeticEventsOperandsLe_mono
    (integerPointDotExecution_events_operandsLe
      hafterSecond hafterSecondFirst) hdotAfterEventsMagnitude
  have hnormAfterEvents := arithmeticEventsOperandsLe_mono
    (integerPointSquaredNormExecution_events_operandsLe hafterSecondFirst) hsmall
  have hfirstCoefficientEvents := roundedDivExecution_events_operandsLe
    (hdotAfterSecond.trans (by
      dsimp only [magnitude]
      exact Nat.mul_le_mul (by norm_num) hpowSixEight))
    hnormAfterSecondFirstOperand
  have hreduceFirstEvents := arithmeticEventsOperandsLe_mono
    (reducePointExecution_events_operandsLe firstCoefficient
      hafterSecond hafterSecondFirst hfirstCoefficient) hreduceFirstMagnitude
  have hfirstAreaEvents := arithmeticEventsOperandsLe_mono
    (integerPointAreaSquaredExecution_events_operandsLe
      hreducedFirst hreducedSecond) hareaMagnitude
  have hsecondAreaEvents := arithmeticEventsOperandsLe_mono
    (integerPointAreaSquaredExecution_events_operandsLe
      hreducedFirst hreducedThird) hareaMagnitude
  have hfirstArea : integerPointAreaSquared
      basis.sizeReduceSecondPair.1.first
      basis.sizeReduceSecondPair.1.second ≤ 12 * (bound + 1) ^ 4 :=
    (integerPointAreaSquared_le_of_coordinatesLe
      hreducedFirst hreducedSecond).trans
        (Nat.mul_le_mul_left 12
          (Nat.pow_le_pow_left (Nat.le_succ bound) 4))
  have hsecondArea : integerPointAreaSquared
      basis.sizeReduceSecondPair.1.first
      basis.sizeReduceSecondPair.1.third ≤ 12 * (bound + 1) ^ 4 :=
    (integerPointAreaSquared_le_of_coordinatesLe
      hreducedFirst hreducedThird).trans
        (Nat.mul_le_mul_left 12
