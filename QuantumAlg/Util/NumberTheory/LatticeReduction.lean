private theorem secondPairNumeratorSum_le (bound : Nat) :
    3 * bound ^ 3 + 9 * bound ^ 4 ≤ 12 * (bound + 1) ^ 4 := by
  have hbase : 1 ≤ bound + 1 := by omega
  have hthree : bound ^ 3 ≤ (bound + 1) ^ 4 :=
    (Nat.pow_le_pow_left (Nat.le_succ bound) 3).trans
      (pow_le_pow_right' hbase (by norm_num))
  have hfour : bound ^ 4 ≤ (bound + 1) ^ 4 :=
    Nat.pow_le_pow_left (Nat.le_succ bound) 4
  calc
    3 * bound ^ 3 + 9 * bound ^ 4 ≤
        3 * (bound + 1) ^ 4 + 9 * (bound + 1) ^ 4 :=
      Nat.add_le_add (Nat.mul_le_mul_left 3 hthree)
        (Nat.mul_le_mul_left 9 hfour)
    _ = 12 * (bound + 1) ^ 4 := by ring

private theorem secondPairReduceSecondMagnitude_le (bound : Nat) :
    (bound + 1) + (24 * (bound + 1) ^ 4 + 1) * (bound + 1) ≤
      256 * (bound + 1) ^ 8 := by
  have hbase : 1 ≤ bound + 1 := by omega
  have hpowOneFive : bound + 1 ≤ (bound + 1) ^ 5 := by
    simpa only [pow_one] using
      (pow_le_pow_right' hbase (show 1 ≤ 5 by norm_num))
  have hpowFourPos : 1 ≤ (bound + 1) ^ 4 := one_le_pow₀ hbase
  have hcoefficientPlus :
      24 * (bound + 1) ^ 4 + 1 ≤ 25 * (bound + 1) ^ 4 := by
    calc
      24 * (bound + 1) ^ 4 + 1 ≤
          24 * (bound + 1) ^ 4 + (bound + 1) ^ 4 :=
        Nat.add_le_add_left hpowFourPos _
      _ = 25 * (bound + 1) ^ 4 := by ring
  have hpowFiveEight : (bound + 1) ^ 5 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  calc
    (bound + 1) + (24 * (bound + 1) ^ 4 + 1) * (bound + 1) ≤
        (bound + 1) ^ 5 +
          (25 * (bound + 1) ^ 4) * (bound + 1) :=
      Nat.add_le_add hpowOneFive
        (Nat.mul_le_mul_right _ hcoefficientPlus)
    _ = 26 * (bound + 1) ^ 5 := by ring
    _ ≤ 256 * (bound + 1) ^ 8 :=
      Nat.mul_le_mul (by norm_num) hpowFiveEight

private theorem secondPairReduceFirstMagnitude_le (bound : Nat) :
    (25 * (bound + 1) ^ 5 + 1) +
        (150 * (bound + 1) ^ 6 + 1) * (bound + 1) ≤
      256 * (bound + 1) ^ 8 := by
  have hbase : 1 ≤ bound + 1 := by omega
  have hpowFivePos : 1 ≤ (bound + 1) ^ 5 := one_le_pow₀ hbase
  have hpowSixPos : 1 ≤ (bound + 1) ^ 6 := one_le_pow₀ hbase
  have hafterPlus :
      25 * (bound + 1) ^ 5 + 1 ≤ 26 * (bound + 1) ^ 5 := by
    calc
      25 * (bound + 1) ^ 5 + 1 ≤
          25 * (bound + 1) ^ 5 + (bound + 1) ^ 5 :=
        Nat.add_le_add_left hpowFivePos _
      _ = 26 * (bound + 1) ^ 5 := by ring
  have hcoefficientPlus :
      150 * (bound + 1) ^ 6 + 1 ≤ 151 * (bound + 1) ^ 6 := by
    calc
      150 * (bound + 1) ^ 6 + 1 ≤
          150 * (bound + 1) ^ 6 + (bound + 1) ^ 6 :=
        Nat.add_le_add_left hpowSixPos _
      _ = 151 * (bound + 1) ^ 6 := by ring
  have hpowFiveSeven : (bound + 1) ^ 5 ≤ (bound + 1) ^ 7 :=
    pow_le_pow_right' hbase (by norm_num)
  have hpowSevenEight : (bound + 1) ^ 7 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  calc
    (25 * (bound + 1) ^ 5 + 1) +
        (150 * (bound + 1) ^ 6 + 1) * (bound + 1) ≤
      26 * (bound + 1) ^ 5 +
        (151 * (bound + 1) ^ 6) * (bound + 1) :=
      Nat.add_le_add hafterPlus
        (Nat.mul_le_mul_right _ hcoefficientPlus)
    _ = 26 * (bound + 1) ^ 5 + 151 * (bound + 1) ^ 7 := by ring
    _ ≤ 26 * (bound + 1) ^ 7 + 151 * (bound + 1) ^ 7 :=
      Nat.add_le_add_right (Nat.mul_le_mul_left 26 hpowFiveSeven) _
    _ = 177 * (bound + 1) ^ 7 := by ring
    _ ≤ 256 * (bound + 1) ^ 8 :=
      (Nat.mul_le_mul_left 177 hpowSevenEight).trans
        (Nat.mul_le_mul_right ((bound + 1) ^ 8) (by norm_num))

private theorem secondPairExecution3_arithmetic_operandsLe
    (basis : IntegerBasis3) (bound : Nat) (hfull : basis.FullRank)
    (hcurrent : basis.SquaredNormsLe bound)
    (hreduced : basis.sizeReduceSecondPair.1.SquaredNormsLe bound) :
    ∀ event ∈ (secondPairExecution3 basis).arithmetic,
