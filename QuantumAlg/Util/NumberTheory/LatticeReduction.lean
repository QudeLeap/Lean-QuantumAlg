private theorem integerPointDotExecution_events_operandsLe
    {left right : IntegerPoint3} {leftBound rightBound : Nat}
    (hleft : left.CoordinatesLe leftBound)
    (hright : right.CoordinatesLe rightBound) :
    ∀ event ∈ (integerPointDotExecution left right).events,
      event.OperandsLe (3 * (leftBound + 1) * (rightBound + 1)) := by
  let magnitude := 3 * (leftBound + 1) * (rightBound + 1)
  have hleftBound : leftBound ≤ magnitude := by
    dsimp only [magnitude]
    nlinarith [Nat.zero_le leftBound, Nat.zero_le rightBound]
  have hrightBound : rightBound ≤ magnitude := by
    dsimp only [magnitude]
    nlinarith [Nat.zero_le leftBound, Nat.zero_le rightBound]
  have hfirstProduct : (left.1 * right.1).natAbs ≤
      leftBound * rightBound := by
    rw [Int.natAbs_mul]
    exact Nat.mul_le_mul hleft.1 hright.1
  have hsecondProduct :
      (left.2.1 * right.2.1).natAbs ≤ leftBound * rightBound := by
    rw [Int.natAbs_mul]
    exact Nat.mul_le_mul hleft.2.1 hright.2.1
  have hthirdProduct :
      (left.2.2 * right.2.2).natAbs ≤ leftBound * rightBound := by
    rw [Int.natAbs_mul]
    exact Nat.mul_le_mul hleft.2.2 hright.2.2
  have hproduct : leftBound * rightBound ≤ magnitude := by
    dsimp only [magnitude]
    nlinarith [Nat.zero_le leftBound, Nat.zero_le rightBound]
  have hfirstTwo :
      (left.1 * right.1 + left.2.1 * right.2.1).natAbs ≤
        magnitude := by
    calc
      (left.1 * right.1 + left.2.1 * right.2.1).natAbs ≤
          (left.1 * right.1).natAbs +
            (left.2.1 * right.2.1).natAbs := Int.natAbs_add_le _ _
      _ ≤ leftBound * rightBound + leftBound * rightBound :=
        Nat.add_le_add hfirstProduct hsecondProduct
      _ ≤ magnitude := by
        dsimp only [magnitude]
        nlinarith [Nat.zero_le leftBound, Nat.zero_le rightBound]
  intro event hevent
  simp only [integerPointDotExecution, intMulExecution, intAddExecution,
    List.mem_append, List.mem_singleton] at hevent
  rcases hevent with (((rfl | rfl) | rfl) | rfl) | rfl <;>
    simp only [ArithmeticEvent.OperandsLe]
  · exact ⟨hleft.1.trans hleftBound, hright.1.trans hrightBound⟩
  · exact ⟨hleft.2.1.trans hleftBound,
      hright.2.1.trans hrightBound⟩
  · exact ⟨hfirstProduct.trans hproduct,
      hsecondProduct.trans hproduct⟩
  · exact ⟨hleft.2.2.trans hleftBound,
      hright.2.2.trans hrightBound⟩
  · exact ⟨hfirstTwo, hthirdProduct.trans hproduct⟩

private theorem integerPointSquaredNormExecution_events_operandsLe
    {point : IntegerPoint3} {bound : Nat}
    (hpoint : point.CoordinatesLe bound) :
    ∀ event ∈ (integerPointSquaredNormExecution point).events,
      event.OperandsLe (3 * (bound + 1) ^ 2) := by
  let magnitude := 3 * (bound + 1) ^ 2
  have hbound : bound ≤ magnitude := by
    dsimp only [magnitude]
    nlinarith [Nat.zero_le bound]
  have hfirstSquare : point.1.natAbs * point.1.natAbs ≤ bound ^ 2 := by
    rw [pow_two]
    exact Nat.mul_le_mul hpoint.1 hpoint.1
  have hsecondSquare :
      point.2.1.natAbs * point.2.1.natAbs ≤ bound ^ 2 := by
    rw [pow_two]
    exact Nat.mul_le_mul hpoint.2.1 hpoint.2.1
  have hthirdSquare :
      point.2.2.natAbs * point.2.2.natAbs ≤ bound ^ 2 := by
    rw [pow_two]
    exact Nat.mul_le_mul hpoint.2.2 hpoint.2.2
  have hproduct : bound ^ 2 ≤ magnitude := by
    dsimp only [magnitude]
    nlinarith [Nat.zero_le bound]
  have hfirstTwo :
      point.1.natAbs * point.1.natAbs +
          point.2.1.natAbs * point.2.1.natAbs ≤ magnitude := by
    calc
      point.1.natAbs * point.1.natAbs +
          point.2.1.natAbs * point.2.1.natAbs ≤
        bound ^ 2 + bound ^ 2 :=
          Nat.add_le_add hfirstSquare hsecondSquare
      _ ≤ magnitude := by
        dsimp only [magnitude]
        nlinarith [Nat.zero_le bound]
  intro event hevent
  simp only [integerPointSquaredNormExecution, natMulExecution,
    natAddExecution, List.mem_append, List.mem_singleton] at hevent
  rcases hevent with (((rfl | rfl) | rfl) | rfl) | rfl <;>
    simp only [ArithmeticEvent.OperandsLe]
  · exact ⟨hpoint.1.trans hbound, hpoint.1.trans hbound⟩
  · exact ⟨hpoint.2.1.trans hbound, hpoint.2.1.trans hbound⟩
  · exact ⟨hfirstSquare.trans hproduct,
      hsecondSquare.trans hproduct⟩
  · exact ⟨hpoint.2.2.trans hbound, hpoint.2.2.trans hbound⟩
  · exact ⟨hfirstTwo, hthirdSquare.trans hproduct⟩

private theorem integerPointCrossExecution_events_operandsLe
    {left right : IntegerPoint3} {bound : Nat}
    (hleft : left.CoordinatesLe bound)
    (hright : right.CoordinatesLe bound) :
    ∀ event ∈ (integerPointCrossExecution left right).events,
      event.OperandsLe (2 * (bound + 1) ^ 2) := by
  let magnitude := 2 * (bound + 1) ^ 2
  have hbound : bound ≤ magnitude := by
    dsimp only [magnitude]
    nlinarith [Nat.zero_le bound]
  have hproduct {a b : Int} (ha : a.natAbs ≤ bound)
      (hb : b.natAbs ≤ bound) : (a * b).natAbs ≤ magnitude := by
    rw [Int.natAbs_mul]
    calc
      a.natAbs * b.natAbs ≤ bound * bound := Nat.mul_le_mul ha hb
      _ ≤ magnitude := by
        dsimp only [magnitude]
        nlinarith [Nat.zero_le bound]
  intro event hevent
  simp only [integerPointCrossExecution, intMulExecution, intSubExecution,
    List.mem_append, List.mem_singleton] at hevent
  rcases hevent with
      (((((((rfl | rfl) | rfl) | rfl) | rfl) | rfl) | rfl) | rfl) | rfl <;>
    simp only [ArithmeticEvent.OperandsLe]
  · exact ⟨hleft.2.1.trans hbound, hright.2.2.trans hbound⟩
  · exact ⟨hleft.2.2.trans hbound, hright.2.1.trans hbound⟩
  · exact ⟨hproduct hleft.2.1 hright.2.2,
      hproduct hleft.2.2 hright.2.1⟩
  · exact ⟨hleft.2.2.trans hbound, hright.1.trans hbound⟩
  · exact ⟨hleft.1.trans hbound, hright.2.2.trans hbound⟩
  · exact ⟨hproduct hleft.2.2 hright.1,
      hproduct hleft.1 hright.2.2⟩
  · exact ⟨hleft.1.trans hbound, hright.2.1.trans hbound⟩
  · exact ⟨hleft.2.1.trans hbound, hright.1.trans hbound⟩
  · exact ⟨hproduct hleft.1 hright.2.1,
      hproduct hleft.2.1 hright.1⟩

private theorem integerPointAreaSquaredExecution_events_operandsLe
    {left right : IntegerPoint3} {bound : Nat}
    (hleft : left.CoordinatesLe bound)
    (hright : right.CoordinatesLe bound) :
    ∀ event ∈ (integerPointAreaSquaredExecution left right).events,
      event.OperandsLe (12 * (bound + 1) ^ 4) := by
  let magnitude := 12 * (bound + 1) ^ 4
  have hcrossMagnitude : 2 * (bound + 1) ^ 2 ≤ magnitude := by
    have hsquarePos : 0 < (bound + 1) ^ 2 := by positivity
    have hsquareLeFourth : (bound + 1) ^ 2 ≤ (bound + 1) ^ 4 := by
      calc
        (bound + 1) ^ 2 = (bound + 1) ^ 2 * 1 := by simp
        _ ≤ (bound + 1) ^ 2 * (bound + 1) ^ 2 :=
          Nat.mul_le_mul_left _ (Nat.succ_le_iff.mpr hsquarePos)
        _ = (bound + 1) ^ 4 := by ring
    dsimp only [magnitude]
    exact (Nat.mul_le_mul_left 2 hsquareLeFourth).trans
      (Nat.mul_le_mul_right ((bound + 1) ^ 4) (by omega))
  have hcrossCoordinates :
      (integerPointCrossExecution left right).value.CoordinatesLe
        (2 * bound * bound) := by
    simpa using integerPointCross_coordinatesLe hleft hright
  have hnormMagnitude :
      3 * (2 * bound * bound + 1) ^ 2 ≤ magnitude := by
    have hinner : 2 * bound * bound + 1 ≤ 2 * (bound + 1) ^ 2 := by
      nlinarith [Nat.zero_le bound]
    have hsquare := Nat.pow_le_pow_left hinner 2
    dsimp only [magnitude]
    calc
      3 * (2 * bound * bound + 1) ^ 2 ≤
          3 * (2 * (bound + 1) ^ 2) ^ 2 :=
        Nat.mul_le_mul_left 3 hsquare
      _ = 12 * (bound + 1) ^ 4 := by ring
  intro event hevent
  simp only [integerPointAreaSquaredExecution, List.mem_append] at hevent
  rcases hevent with hcross | hnorm
  · exact (integerPointCrossExecution_events_operandsLe hleft hright
      event hcross).mono hcrossMagnitude
  · exact (integerPointSquaredNormExecution_events_operandsLe
      hcrossCoordinates event hnorm).mono hnormMagnitude

private theorem reducePointExecution_events_operandsLe
    {point direction : IntegerPoint3}
    {pointBound directionBound coefficientBound : Nat}
    (coefficient : Int) (hpoint : point.CoordinatesLe pointBound)
    (hdirection : direction.CoordinatesLe directionBound)
    (hcoefficient : coefficient.natAbs ≤ coefficientBound) :
    ∀ event ∈ (reducePointExecution point direction coefficient).events,
      event.OperandsLe
        ((pointBound + 1) + (coefficientBound + 1) * (directionBound + 1)) := by
  let magnitude :=
    (pointBound + 1) + (coefficientBound + 1) * (directionBound + 1)
  have hpointMagnitude : pointBound ≤ magnitude := by
    dsimp only [magnitude]
    omega
  have hdirectionMagnitude : directionBound ≤ magnitude := by
    dsimp only [magnitude]
    nlinarith [Nat.zero_le pointBound, Nat.zero_le coefficientBound,
      Nat.zero_le directionBound]
  have hcoefficientMagnitude : coefficientBound ≤ magnitude := by
    dsimp only [magnitude]
    nlinarith [Nat.zero_le pointBound, Nat.zero_le coefficientBound,
      Nat.zero_le directionBound]
  have hproduct {value : Int} (hvalue : value.natAbs ≤ directionBound) :
      (coefficient * value).natAbs ≤ magnitude := by
    rw [Int.natAbs_mul]
    calc
      coefficient.natAbs * value.natAbs ≤
          coefficientBound * directionBound :=
        Nat.mul_le_mul hcoefficient hvalue
      _ ≤ magnitude := by
        dsimp only [magnitude]
        nlinarith [Nat.zero_le pointBound, Nat.zero_le coefficientBound,
          Nat.zero_le directionBound]
  intro event hevent
  simp only [reducePointExecution, intMulExecution, intSubExecution,
    List.mem_append, List.mem_singleton] at hevent
  rcases hevent with ((((rfl | rfl) | rfl) | rfl) | rfl) | rfl <;>
    simp only [ArithmeticEvent.OperandsLe]
  · exact ⟨hcoefficient.trans hcoefficientMagnitude,
      hdirection.1.trans hdirectionMagnitude⟩
  · exact ⟨hpoint.1.trans hpointMagnitude, hproduct hdirection.1⟩
  · exact ⟨hcoefficient.trans hcoefficientMagnitude,
      hdirection.2.1.trans hdirectionMagnitude⟩
  · exact ⟨hpoint.2.1.trans hpointMagnitude, hproduct hdirection.2.1⟩
  · exact ⟨hcoefficient.trans hcoefficientMagnitude,
      hdirection.2.2.trans hdirectionMagnitude⟩
  · exact ⟨hpoint.2.2.trans hpointMagnitude, hproduct hdirection.2.2⟩

private structure FirstPairExecution3 where
  reduced : IntegerBasis3
  coefficient : Int
  passes : Bool
  arithmetic : List ArithmeticEvent

/-- Execute first-pair size reduction and its Lovász comparison from one
operand-audited arithmetic spine. -/
private def firstPairExecution3 (basis : IntegerBasis3) :
    FirstPairExecution3 :=
  let dot := integerPointDotExecution basis.second basis.first
  let denominator := integerPointSquaredNormExecution basis.first
  let coefficient := roundedDivExecution dot.value denominator.value
  let reducedSecond :=
    reducePointExecution basis.second basis.first coefficient.value
  let reduced : IntegerBasis3 := { basis with second := reducedSecond.value }
  let firstNorm := integerPointSquaredNormExecution reduced.first
  let secondNorm := integerPointSquaredNormExecution reduced.second
  let twiceSecond := natMulExecution 2 secondNorm.value
  let passes := natLeExecution firstNorm.value twiceSecond.value
  { reduced := reduced
    coefficient := coefficient.value
    passes := passes.value
    arithmetic := dot.events ++ denominator.events ++ coefficient.events ++
      reducedSecond.events ++ firstNorm.events ++ secondNorm.events ++
      twiceSecond.events ++ passes.events }

