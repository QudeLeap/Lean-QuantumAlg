    exact (Nat.mul_le_mul_left 3 hbasePower).trans
      (Nat.mul_le_mul_right ((bound + 1) ^ 4) (by norm_num))
  have hdotProductToArea : 9 * bound ^ 4 ≤
      12 * (bound + 1) ^ 4 := by
    exact (Nat.mul_le_mul_left 9
