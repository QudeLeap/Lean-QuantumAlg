/-!
# Exact reduction of three-dimensional integer lattices

This module contains the executable, quantum-free lattice arithmetic used by
fixed-dimensional number-theoretic recovery algorithms.  Its reduction loop is
the exact-integer specialization of LLL with parameter `1/2`: size reduction
uses rational nearest-integer coefficients, while both Lovász tests are
cleared-denominator natural-number comparisons.  The row operations preserve
the represented lattice.

The algorithmic shape, correctness proof, and potential-decrease termination
argument follow
[KC24, Thesisbody.tex:221-268,374-637].  The downstream short-logarithm client
uses the higher-dimensional coefficient bounds described in
[E23, arxiv-v5.tex:1652-1691].

For integer inputs whose coordinate bit length grows, the relevant
intermediate-size and multiprecision running-time analysis is
[U24, alg-lll.tex:908-1173].  The `steps` recorded below are auditable padded
replay slots; they are not identified with the bit operations in that source.
-/

section

namespace QuantumAlg
namespace NumberTheory

/-- An ordered integer basis in dimension three. -/
structure IntegerBasis3 where
  /-- First ordered basis vector. -/
  first : IntegerPoint3
  /-- Second ordered basis vector. -/
  second : IntegerPoint3
  /-- Third ordered basis vector. -/
  third : IntegerPoint3
  deriving DecidableEq, Repr

-- The generated structure printer intentionally ignores outer precedence.
attribute [nolint unusedArguments] instReprIntegerBasis3.repr

/-- Coordinatewise addition of integer points. -/
def IntegerPoint3.add (left right : IntegerPoint3) : IntegerPoint3 :=
  (left.1 + right.1, left.2.1 + right.2.1, left.2.2 + right.2.2)

/-- Coordinatewise subtraction of integer points. -/
def IntegerPoint3.sub (left right : IntegerPoint3) : IntegerPoint3 :=
  (left.1 - right.1, left.2.1 - right.2.1, left.2.2 - right.2.2)

/-- Integer scaling of a three-dimensional point. -/
def IntegerPoint3.smul (coefficient : Int)
    (point : IntegerPoint3) : IntegerPoint3 :=
  (coefficient * point.1, coefficient * point.2.1,
    coefficient * point.2.2)

/-- Exact integer dot product. -/
def integerPointDot (left right : IntegerPoint3) : Int :=
  left.1 * right.1 + left.2.1 * right.2.1 + left.2.2 * right.2.2

/-- Exact squared norm as a natural number. -/
def integerPointSquaredNorm (point : IntegerPoint3) : Nat :=
  point.1.natAbs ^ 2 + point.2.1.natAbs ^ 2 + point.2.2.natAbs ^ 2

/-- The integer dot product with itself is the cast of the squared norm. -/
theorem integerPointDot_self (point : IntegerPoint3) :
    integerPointDot point point = (integerPointSquaredNorm point : Int) := by
  rcases point with ⟨first, second, third⟩
  simp [integerPointDot, integerPointSquaredNorm]
  ring

/-- Integer cross product. -/
def integerPointCross (left right : IntegerPoint3) : IntegerPoint3 :=
  (left.2.1 * right.2.2 - left.2.2 * right.2.1,
    left.2.2 * right.1 - left.1 * right.2.2,
    left.1 * right.2.1 - left.2.1 * right.1)

/-- Squared area of the parallelogram generated by two integer vectors. -/
def integerPointAreaSquared (left right : IntegerPoint3) : Nat :=
  integerPointSquaredNorm (integerPointCross left right)

/-- Three-dimensional Lagrange identity for the exact integer arithmetic used
by Gram–Schmidt reduction. -/
theorem integerPointAreaSquared_eq_gram (left right : IntegerPoint3) :
    (integerPointAreaSquared left right : Int) =
      (integerPointSquaredNorm left : Int) *
          (integerPointSquaredNorm right : Int) -
        integerPointDot left right ^ 2 := by
  rcases left with ⟨leftFirst, leftSecond, leftThird⟩
  rcases right with ⟨rightFirst, rightSecond, rightThird⟩
  simp [integerPointAreaSquared, integerPointSquaredNorm,
    integerPointCross, integerPointDot]
  ring

/-- Exchanging the two vectors does not change their squared area. -/
theorem integerPointAreaSquared_comm (left right : IntegerPoint3) :
    integerPointAreaSquared left right =
      integerPointAreaSquared right left := by
  have hcross : integerPointCross right left =
      (integerPointCross left right).smul (-1) := by
    apply Prod.ext
    · simp [integerPointCross, IntegerPoint3.smul]
      ring
    · apply Prod.ext <;> simp [integerPointCross, IntegerPoint3.smul] <;> ring
  unfold integerPointAreaSquared
  rw [hcross]
  simp [integerPointSquaredNorm, IntegerPoint3.smul]

/-- Subtracting a multiple of the left vector from the right vector preserves
their oriented cross product. -/
theorem integerPointCross_sub_smul_self (left right : IntegerPoint3)
    (coefficient : Int) :
    integerPointCross left (right.sub (left.smul coefficient)) =
      integerPointCross left right := by
  apply Prod.ext
  · simp [integerPointCross, IntegerPoint3.sub, IntegerPoint3.smul]
    ring
  · apply Prod.ext <;>
      simp [integerPointCross, IntegerPoint3.sub, IntegerPoint3.smul] <;> ring

/-- Determinant of an ordered three-dimensional integer basis. -/
def IntegerBasis3.determinant (basis : IntegerBasis3) : Int :=
  integerPointDot basis.first (integerPointCross basis.second basis.third)

/-- Cyclic form of the three-dimensional determinant. -/
theorem IntegerBasis3.determinant_eq_third_dot_cross
    (basis : IntegerBasis3) :
    basis.determinant =
      integerPointDot basis.third
        (integerPointCross basis.first basis.second) := by
  simp [IntegerBasis3.determinant, integerPointDot, integerPointCross]
  ring

/-- Full-rank ordered integer bases. -/
def IntegerBasis3.FullRank (basis : IntegerBasis3) : Prop :=
  basis.determinant ≠ 0

/-- A uniform squared-norm envelope for all three ordered basis rows. -/
def IntegerBasis3.SquaredNormsLe
    (basis : IntegerBasis3) (bound : Nat) : Prop :=
  integerPointSquaredNorm basis.first ≤ bound ∧
    integerPointSquaredNorm basis.second ≤ bound ∧
      integerPointSquaredNorm basis.third ≤ bound

/-- Positive aggregate squared height of an ordered three-dimensional basis. -/
def IntegerBasis3.squaredHeight (basis : IntegerBasis3) : Nat :=
  1 + integerPointSquaredNorm basis.first +
    integerPointSquaredNorm basis.second +
      integerPointSquaredNorm basis.third

/-- Integer linear combination represented by an ordered basis. -/
def IntegerBasis3.linearCombination (basis : IntegerBasis3)
    (coefficients : IntegerPoint3) : IntegerPoint3 :=
  (basis.first.smul coefficients.1).add <|
    (basis.second.smul coefficients.2.1).add <|
      basis.third.smul coefficients.2.2

/-- Uniform row-norm and coefficient-coordinate bounds control every
coordinate of the corresponding three-dimensional linear combination. -/
theorem IntegerBasis3.linearCombination_coordinates_le
    (basis : IntegerBasis3) (coefficients : IntegerPoint3)
    (basisBound coefficientBound : Nat)
    (hbasis : basis.SquaredNormsLe basisBound)
    (hcoefficients : coefficients.1.natAbs ≤ coefficientBound ∧
      coefficients.2.1.natAbs ≤ coefficientBound ∧
      coefficients.2.2.natAbs ≤ coefficientBound) :
    let point := basis.linearCombination coefficients
    point.1.natAbs ≤ 3 * coefficientBound * basisBound ∧
      point.2.1.natAbs ≤ 3 * coefficientBound * basisBound ∧
      point.2.2.natAbs ≤ 3 * coefficientBound * basisBound := by
  have coordinates_le (point : IntegerPoint3) (bound : Nat)
      (hpoint : integerPointSquaredNorm point ≤ bound) :
      point.1.natAbs ≤ bound ∧ point.2.1.natAbs ≤ bound ∧
        point.2.2.natAbs ≤ bound := by
    have hfirst : point.1.natAbs ^ 2 ≤ bound := by
      exact (show point.1.natAbs ^ 2 ≤ integerPointSquaredNorm point by
        simp only [integerPointSquaredNorm]
        omega).trans hpoint
    have hsecond : point.2.1.natAbs ^ 2 ≤ bound := by
      exact (show point.2.1.natAbs ^ 2 ≤ integerPointSquaredNorm point by
        simp only [integerPointSquaredNorm]
        omega).trans hpoint
    have hthird : point.2.2.natAbs ^ 2 ≤ bound := by
      exact (show point.2.2.natAbs ^ 2 ≤ integerPointSquaredNorm point by
        simp only [integerPointSquaredNorm]
        omega).trans hpoint
    exact
      ⟨(Nat.le_self_pow (by decide) _).trans hfirst,
        (Nat.le_self_pow (by decide) _).trans hsecond,
        (Nat.le_self_pow (by decide) _).trans hthird⟩
  have hfirst := coordinates_le basis.first basisBound hbasis.1
  have hsecond := coordinates_le basis.second basisBound hbasis.2.1
  have hthird := coordinates_le basis.third basisBound hbasis.2.2
  have coordinate_sum_le
      (left middle right : Int)
      (hleft : left.natAbs ≤ coefficientBound * basisBound)
      (hmiddle : middle.natAbs ≤ coefficientBound * basisBound)
      (hright : right.natAbs ≤ coefficientBound * basisBound) :
      (left + (middle + right)).natAbs ≤
        3 * coefficientBound * basisBound := by
    calc
      (left + (middle + right)).natAbs ≤
          left.natAbs + (middle.natAbs + right.natAbs) := by
        exact (Int.natAbs_add_le _ _).trans
          (Nat.add_le_add_left (Int.natAbs_add_le _ _) _)
      _ ≤ coefficientBound * basisBound +
          (coefficientBound * basisBound +
            coefficientBound * basisBound) :=
        Nat.add_le_add hleft (Nat.add_le_add hmiddle hright)
      _ = 3 * coefficientBound * basisBound := by ring
  dsimp only
  simp only [IntegerBasis3.linearCombination, IntegerPoint3.add,
    IntegerPoint3.smul]
  constructor
  · apply coordinate_sum_le
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.1 hfirst.1
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.2.1 hsecond.1
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.2.2 hthird.1
  constructor
  · apply coordinate_sum_le
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.1 hfirst.2.1
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.2.1 hsecond.2.1
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.2.2 hthird.2.1
  · apply coordinate_sum_le
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.1 hfirst.2.2
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.2.1 hsecond.2.2
    · rw [Int.natAbs_mul]
      exact Nat.mul_le_mul hcoefficients.2.2 hthird.2.2

/-- Extensional equality of the integer lattices generated by two bases. -/
def IntegerBasis3.SameLattice (left right : IntegerBasis3) : Prop :=
  ∀ point,
    (∃ coefficients, left.linearCombination coefficients = point) ↔
      ∃ coefficients, right.linearCombination coefficients = point

/-- Lattice equality is reflexive. -/
theorem IntegerBasis3.SameLattice.refl (basis : IntegerBasis3) :
    basis.SameLattice basis := by
  intro point
  rfl

/-- Lattice equality is symmetric. -/
theorem IntegerBasis3.SameLattice.symm {left right : IntegerBasis3}
    (h : left.SameLattice right) : right.SameLattice left := by
  intro point
  exact (h point).symm

/-- Lattice equality is transitive. -/
theorem IntegerBasis3.SameLattice.trans {left middle right : IntegerBasis3}
    (hleft : left.SameLattice middle)
    (hright : middle.SameLattice right) : left.SameLattice right := by
  intro point
  exact (hleft point).trans (hright point)

/-- Subtract an integer multiple of the first row from the second. -/
def IntegerBasis3.reduceSecond (basis : IntegerBasis3)
    (coefficient : Int) : IntegerBasis3 where
  first := basis.first
  second := basis.second.sub (basis.first.smul coefficient)
  third := basis.third

/-- Subtract an integer multiple of the second row from the third. -/
def IntegerBasis3.reduceThirdBySecond (basis : IntegerBasis3)
    (coefficient : Int) : IntegerBasis3 where
  first := basis.first
  second := basis.second
  third := basis.third.sub (basis.second.smul coefficient)

/-- Subtract an integer multiple of the first row from the third. -/
def IntegerBasis3.reduceThirdByFirst (basis : IntegerBasis3)
    (coefficient : Int) : IntegerBasis3 where
  first := basis.first
  second := basis.second
  third := basis.third.sub (basis.first.smul coefficient)

/-- Swap the first two ordered basis rows. -/
def IntegerBasis3.swapFirstSecond (basis : IntegerBasis3) : IntegerBasis3 where
  first := basis.second
  second := basis.first
  third := basis.third

/-- Swap the last two ordered basis rows. -/
def IntegerBasis3.swapSecondThird (basis : IntegerBasis3) : IntegerBasis3 where
  first := basis.first
  second := basis.third
  third := basis.second

private theorem integerPoint3_ext {left right : IntegerPoint3}
    (hfirst : left.1 = right.1)
    (hsecond : left.2.1 = right.2.1)
    (hthird : left.2.2 = right.2.2) : left = right := by
  apply Prod.ext hfirst
  exact Prod.ext hsecond hthird

/-- Second-row size reduction preserves the represented lattice. -/
theorem IntegerBasis3.sameLattice_reduceSecond
    (basis : IntegerBasis3) (coefficient : Int) :
    basis.SameLattice (basis.reduceSecond coefficient) := by
  intro point
  constructor
  · rintro ⟨coefficients, rfl⟩
    refine ⟨(coefficients.1 + coefficient * coefficients.2.1,
      coefficients.2.1, coefficients.2.2), ?_⟩
    apply integerPoint3_ext <;>
      simp [IntegerBasis3.linearCombination, IntegerBasis3.reduceSecond,
        IntegerPoint3.add, IntegerPoint3.sub, IntegerPoint3.smul] <;> ring
  · rintro ⟨coefficients, rfl⟩
    refine ⟨(coefficients.1 - coefficient * coefficients.2.1,
      coefficients.2.1, coefficients.2.2), ?_⟩
    apply integerPoint3_ext <;>
      simp [IntegerBasis3.linearCombination, IntegerBasis3.reduceSecond,
        IntegerPoint3.add, IntegerPoint3.sub, IntegerPoint3.smul] <;> ring

/-- Third-by-second size reduction preserves the represented lattice. -/
theorem IntegerBasis3.sameLattice_reduceThirdBySecond
    (basis : IntegerBasis3) (coefficient : Int) :
    basis.SameLattice (basis.reduceThirdBySecond coefficient) := by
  intro point
  constructor
  · rintro ⟨coefficients, rfl⟩
    refine ⟨(coefficients.1,
      coefficients.2.1 + coefficient * coefficients.2.2,
      coefficients.2.2), ?_⟩
    apply integerPoint3_ext <;>
      simp [IntegerBasis3.linearCombination,
        IntegerBasis3.reduceThirdBySecond, IntegerPoint3.add,
        IntegerPoint3.sub, IntegerPoint3.smul] <;> ring
  · rintro ⟨coefficients, rfl⟩
    refine ⟨(coefficients.1,
      coefficients.2.1 - coefficient * coefficients.2.2,
      coefficients.2.2), ?_⟩
    apply integerPoint3_ext <;>
      simp [IntegerBasis3.linearCombination,
        IntegerBasis3.reduceThirdBySecond, IntegerPoint3.add,
        IntegerPoint3.sub, IntegerPoint3.smul] <;> ring

/-- Third-by-first size reduction preserves the represented lattice. -/
theorem IntegerBasis3.sameLattice_reduceThirdByFirst
    (basis : IntegerBasis3) (coefficient : Int) :
    basis.SameLattice (basis.reduceThirdByFirst coefficient) := by
  intro point
  constructor
  · rintro ⟨coefficients, rfl⟩
    refine ⟨(coefficients.1 + coefficient * coefficients.2.2,
      coefficients.2.1, coefficients.2.2), ?_⟩
    apply integerPoint3_ext <;>
      simp [IntegerBasis3.linearCombination,
        IntegerBasis3.reduceThirdByFirst, IntegerPoint3.add,
        IntegerPoint3.sub, IntegerPoint3.smul] <;> ring
  · rintro ⟨coefficients, rfl⟩
    refine ⟨(coefficients.1 - coefficient * coefficients.2.2,
      coefficients.2.1, coefficients.2.2), ?_⟩
    apply integerPoint3_ext <;>
      simp [IntegerBasis3.linearCombination,
        IntegerBasis3.reduceThirdByFirst, IntegerPoint3.add,
        IntegerPoint3.sub, IntegerPoint3.smul] <;> ring

/-- Swapping the first two rows preserves the represented lattice. -/
theorem IntegerBasis3.sameLattice_swapFirstSecond
    (basis : IntegerBasis3) :
    basis.SameLattice basis.swapFirstSecond := by
  intro point
  constructor <;> rintro ⟨coefficients, rfl⟩ <;>
    refine ⟨(coefficients.2.1, coefficients.1, coefficients.2.2), ?_⟩ <;>
    apply integerPoint3_ext <;>
      simp [IntegerBasis3.linearCombination,
        IntegerBasis3.swapFirstSecond, IntegerPoint3.add,
        IntegerPoint3.smul] <;> ring

/-- Swapping the last two rows preserves the represented lattice. -/
theorem IntegerBasis3.sameLattice_swapSecondThird
    (basis : IntegerBasis3) :
    basis.SameLattice basis.swapSecondThird := by
  intro point
  constructor <;> rintro ⟨coefficients, rfl⟩ <;>
    refine ⟨(coefficients.1, coefficients.2.2,
      coefficients.2.1), ?_⟩ <;>
    apply integerPoint3_ext <;>
      simp [IntegerBasis3.linearCombination,
        IntegerBasis3.swapSecondThird, IntegerPoint3.add,
        IntegerPoint3.smul] <;> ring

@[simp]
theorem IntegerBasis3.determinant_reduceSecond
    (basis : IntegerBasis3) (coefficient : Int) :
    (basis.reduceSecond coefficient).determinant = basis.determinant := by
  simp only [IntegerBasis3.determinant, IntegerBasis3.reduceSecond,
    integerPointDot, integerPointCross, IntegerPoint3.sub,
    IntegerPoint3.smul]
  ring

@[simp]
theorem IntegerBasis3.determinant_reduceThirdBySecond
    (basis : IntegerBasis3) (coefficient : Int) :
    (basis.reduceThirdBySecond coefficient).determinant =
      basis.determinant := by
  simp only [IntegerBasis3.determinant, IntegerBasis3.reduceThirdBySecond,
    integerPointDot, integerPointCross, IntegerPoint3.sub,
    IntegerPoint3.smul]
  ring

@[simp]
theorem IntegerBasis3.determinant_reduceThirdByFirst
    (basis : IntegerBasis3) (coefficient : Int) :
    (basis.reduceThirdByFirst coefficient).determinant =
      basis.determinant := by
  simp only [IntegerBasis3.determinant, IntegerBasis3.reduceThirdByFirst,
    integerPointDot, integerPointCross, IntegerPoint3.sub,
    IntegerPoint3.smul]
  ring

@[simp]
theorem IntegerBasis3.determinant_swapFirstSecond
    (basis : IntegerBasis3) :
    basis.swapFirstSecond.determinant = -basis.determinant := by
  simp only [IntegerBasis3.determinant, IntegerBasis3.swapFirstSecond,
    integerPointDot, integerPointCross]
  ring

@[simp]
theorem IntegerBasis3.determinant_swapSecondThird
    (basis : IntegerBasis3) :
    basis.swapSecondThird.determinant = -basis.determinant := by
  simp only [IntegerBasis3.determinant, IntegerBasis3.swapSecondThird,
    integerPointDot, integerPointCross]
  ring

/-- Every elementary size-reduction row operation preserves full rank. -/
theorem IntegerBasis3.FullRank.reduceSecond {basis : IntegerBasis3}
    (hfull : basis.FullRank) (coefficient : Int) :
    (basis.reduceSecond coefficient).FullRank := by
  simpa [IntegerBasis3.FullRank] using hfull

/-- Third-by-second size reduction preserves full rank. -/
theorem IntegerBasis3.FullRank.reduceThirdBySecond {basis : IntegerBasis3}
    (hfull : basis.FullRank) (coefficient : Int) :
    (basis.reduceThirdBySecond coefficient).FullRank := by
  simpa [IntegerBasis3.FullRank] using hfull

/-- Third-by-first size reduction preserves full rank. -/
theorem IntegerBasis3.FullRank.reduceThirdByFirst {basis : IntegerBasis3}
    (hfull : basis.FullRank) (coefficient : Int) :
    (basis.reduceThirdByFirst coefficient).FullRank := by
  simpa [IntegerBasis3.FullRank] using hfull

/-- Swapping the first two rows preserves full rank. -/
theorem IntegerBasis3.FullRank.swapFirstSecond {basis : IntegerBasis3}
    (hfull : basis.FullRank) : basis.swapFirstSecond.FullRank := by
  simpa [IntegerBasis3.FullRank] using neg_ne_zero.mpr hfull

/-- Swapping the last two rows preserves full rank. -/
theorem IntegerBasis3.FullRank.swapSecondThird {basis : IntegerBasis3}
    (hfull : basis.FullRank) : basis.swapSecondThird.FullRank := by
  simpa [IntegerBasis3.FullRank] using neg_ne_zero.mpr hfull

/-- Exact nearest-integer coefficient used by size reduction. -/
def nearestIntegerCoefficient (numerator denominator : Int) : Int :=
  round ((numerator : Rat) / (denominator : Rat))

/-- Nearest-integer division by a positive natural denominator is Euclidean
division after doubling and adding the denominator.  This form is executable
using ordinary fixed-width addition and unsigned quotient/remainder once the
signed numerator has been normalized. -/
theorem nearestIntegerCoefficient_eq_ediv
    (numerator : Int) (denominator : Nat) (positive : 0 < denominator) :
    nearestIntegerCoefficient numerator (denominator : Int) =
      (2 * numerator + denominator) / (2 * denominator : Int) := by
  unfold nearestIntegerCoefficient
  rw [round_eq]
  have denominatorNe : (denominator : Rat) ≠ 0 := by
    positivity
  have rationalIdentity :
      (numerator : Rat) / ((denominator : Int) : Rat) + 1 / 2 =
        ((2 * numerator + denominator : Int) : Rat) /
          ((2 * denominator : Nat) : Rat) := by
    push_cast
    field_simp [denominatorNe]
  rw [rationalIdentity, Rat.floor_intCast_div_natCast]
  norm_cast

/-- The nonnegative branch of nearest-integer division is ordinary unsigned
Euclidean division after doubling both operands. -/
theorem nearestIntegerCoefficient_ofNat
    (numerator denominator : Nat) (positive : 0 < denominator) :
    nearestIntegerCoefficient (numerator : Int) (denominator : Int) =
      (((2 * numerator + denominator) / (2 * denominator) : Nat) : Int) := by
  rw [nearestIntegerCoefficient_eq_ediv _ denominator positive]
  norm_cast

/-- The negative branch of nearest-integer division uses the unsigned
magnitude numerator with the Euclidean predecessor correction. -/
theorem nearestIntegerCoefficient_neg_ofNat
    (magnitude denominator : Nat) (magnitudePositive : 0 < magnitude)
    (denominatorPositive : 0 < denominator) :
    nearestIntegerCoefficient (-(magnitude : Int)) (denominator : Int) =
      -(((2 * magnitude + denominator - 1) / (2 * denominator) : Nat) : Int) := by
  rw [nearestIntegerCoefficient_eq_ediv _ denominator denominatorPositive]
  have doubledDenominatorPositive : (0 : Int) < 2 * denominator := by
    exact_mod_cast (show 0 < 2 * denominator by omega)
  have doubledDenominatorNe : (2 * denominator : Int) ≠ 0 :=
    ne_of_gt doubledDenominatorPositive
  by_cases below : 2 * magnitude < denominator
  · have numeratorNonnegative :
        0 ≤ -(2 * (magnitude : Int)) + denominator := by
      omega
    have numeratorLt :
        -(2 * (magnitude : Int)) + denominator < 2 * denominator := by
      omega
    have quotientZero :
        (-(2 * (magnitude : Int)) + denominator) /
            (2 * denominator : Int) = 0 :=
      Int.ediv_eq_zero_of_lt numeratorNonnegative numeratorLt
    have unsignedQuotientZero :
        (2 * magnitude + denominator - 1) / (2 * denominator) = 0 := by
      apply Nat.div_eq_of_lt
      omega
    simp [quotientZero, unsignedQuotientZero]
  · have denominatorLe : denominator ≤ 2 * magnitude := Nat.le_of_not_gt below
    by_cases equal : denominator = 2 * magnitude
    · subst denominator
      have numeratorSyntax :
          2 * -(magnitude : Int) + (2 * magnitude : Nat) =
            -(2 * (magnitude : Int)) + (2 * magnitude : Nat) := by
        ring
      have numeratorZero :
          -(2 * (magnitude : Int)) + (2 * magnitude : Nat) = 0 := by
        push_cast
        ring
      have unsignedQuotientZero :
          (2 * magnitude + 2 * magnitude - 1) / (2 * (2 * magnitude)) = 0 := by
        apply Nat.div_eq_of_lt
        omega
      rw [numeratorSyntax, numeratorZero]
      simp [unsignedQuotientZero]
    · have denominatorLt : denominator < 2 * magnitude :=
        lt_of_le_of_ne denominatorLe equal
      have numeratorNegative :
          -(2 * (magnitude : Int)) + denominator < 0 := by
        omega
      have numeratorIdentity :
          -(-(2 * (magnitude : Int)) + denominator) - 1 =
            2 * (magnitude : Int) - denominator - 1 := by
        ring
      have castNumerator :
          ((2 * magnitude + denominator - 1 : Nat) : Int) =
            2 * (magnitude : Int) + denominator - 1 := by
        rw [Nat.cast_sub (by omega : 1 ≤ 2 * magnitude + denominator)]
        push_cast
        ring
      have castDenominator :
          ((2 * denominator : Nat) : Int) = 2 * (denominator : Int) := by
        push_cast
        ring
      have shiftedDivision :
          (2 * (magnitude : Int) - denominator - 1) /
              (2 * denominator : Int) + 1 =
            ((2 * magnitude + denominator - 1 : Nat) : Int) /
              ((2 * denominator : Nat) : Int) := by
        calc
          (2 * (magnitude : Int) - denominator - 1) /
              (2 * denominator : Int) + 1 =
            (2 * (magnitude : Int) - denominator - 1 +
                1 * (2 * denominator : Int)) /
              (2 * denominator : Int) := by
                rw [Int.add_mul_ediv_right _ _ doubledDenominatorNe]
          _ = ((2 * magnitude + denominator - 1 : Nat) : Int) /
              ((2 * denominator : Nat) : Int) := by
                rw [castNumerator, castDenominator]
                congr 1
                omega
      have numeratorSyntax :
          2 * -(magnitude : Int) + denominator =
            -(2 * (magnitude : Int)) + denominator := by
        ring
      rw [numeratorSyntax]
      change Int.ediv (-(2 * (magnitude : Int)) + denominator)
        (2 * (denominator : Int)) = _
      rw [Int.ediv_of_neg_of_pos numeratorNegative doubledDenominatorPositive]
      rw [numeratorIdentity, shiftedDivision]
      exact congrArg Neg.neg (Int.natCast_ediv _ _).symm

/-- First projection coefficient, rounded to its nearest integer. -/
def IntegerBasis3.firstReductionCoefficient (basis : IntegerBasis3) : Int :=
  nearestIntegerCoefficient
    (integerPointDot basis.second basis.first)
    (integerPointSquaredNorm basis.first)

/-- Size-reduce the second row against the first. -/
def IntegerBasis3.sizeReduceFirstPair (basis : IntegerBasis3) :
    IntegerBasis3 × Int :=
  let coefficient := basis.firstReductionCoefficient
  (basis.reduceSecond coefficient, coefficient)

/-- Cleared numerator of the Gram–Schmidt coefficient of the third row in
the direction of the second orthogonalized row. -/
def IntegerBasis3.secondReductionNumerator (basis : IntegerBasis3) : Int :=
  let normFirst : Int := integerPointSquaredNorm basis.first
  normFirst * integerPointDot basis.third basis.second -
    integerPointDot basis.third basis.first *
      integerPointDot basis.second basis.first

/-- Positive-denominator expression for the squared norm of the second
Gram–Schmidt row, before cancellation. -/
def IntegerBasis3.secondReductionDenominator (basis : IntegerBasis3) : Int :=
  integerPointAreaSquared basis.first basis.second

/-- Size-reduce the third row against the second orthogonalized direction and
then against the first row. -/
def IntegerBasis3.sizeReduceSecondPair (basis : IntegerBasis3) :
    IntegerBasis3 × Int × Int :=
  let secondCoefficient := nearestIntegerCoefficient
    basis.secondReductionNumerator basis.secondReductionDenominator
  let afterSecond := basis.reduceThirdBySecond secondCoefficient
  let firstCoefficient := nearestIntegerCoefficient
    (integerPointDot afterSecond.third afterSecond.first)
    (integerPointSquaredNorm afterSecond.first)
  (afterSecond.reduceThirdByFirst firstCoefficient,
    secondCoefficient, firstCoefficient)

/-- First Gram–Schmidt coefficient of an ordered basis. -/
def IntegerBasis3.firstGramSchmidtCoefficient
    (basis : IntegerBasis3) : Rat :=
  (integerPointDot basis.second basis.first : Rat) /
    (integerPointSquaredNorm basis.first : Rat)

/-- Coefficient of the third row along the second orthogonalized direction. -/
def IntegerBasis3.secondGramSchmidtCoefficient
    (basis : IntegerBasis3) : Rat :=
  (basis.secondReductionNumerator : Rat) /
    (basis.secondReductionDenominator : Rat)

/-- Coefficient of the third row along the first row. -/
def IntegerBasis3.thirdFirstGramSchmidtCoefficient
    (basis : IntegerBasis3) : Rat :=
  (integerPointDot basis.third basis.first : Rat) /
    (integerPointSquaredNorm basis.first : Rat)

/-- Subtracting an integer multiple from the second row translates the first
Gram–Schmidt coefficient by precisely that integer. -/
theorem IntegerBasis3.firstGramSchmidtCoefficient_reduceSecond
    (basis : IntegerBasis3) (coefficient : Int)
    (hnorm : integerPointSquaredNorm basis.first ≠ 0) :
    (basis.reduceSecond coefficient).firstGramSchmidtCoefficient =
      basis.firstGramSchmidtCoefficient - (coefficient : Rat) := by
  unfold IntegerBasis3.firstGramSchmidtCoefficient
  simp only [IntegerBasis3.reduceSecond]
  have hdot : integerPointDot
      (basis.second.sub (basis.first.smul coefficient)) basis.first =
      integerPointDot basis.second basis.first -
        coefficient * (integerPointSquaredNorm basis.first : Int) := by
    simp only [integerPointDot, IntegerPoint3.sub, IntegerPoint3.smul]
    rw [← integerPointDot_self basis.first]
    simp only [integerPointDot]
    ring
  rw [hdot]
  push_cast
  rw [sub_div]
  rw [mul_div_cancel_right₀ _ (by exact_mod_cast hnorm)]

/-- First-pair size reduction places its Gram–Schmidt coefficient in the
nearest-integer half interval. -/
theorem IntegerBasis3.firstGramSchmidtCoefficient_sizeReduceFirstPair
    (basis : IntegerBasis3)
    (hnorm : integerPointSquaredNorm basis.first ≠ 0) :
    |basis.sizeReduceFirstPair.1.firstGramSchmidtCoefficient| ≤
      (1 : Rat) / 2 := by
  rw [show basis.sizeReduceFirstPair.1 =
      basis.reduceSecond basis.firstReductionCoefficient by rfl]
  rw [basis.firstGramSchmidtCoefficient_reduceSecond
    basis.firstReductionCoefficient hnorm]
  exact abs_sub_round _

/-- Reducing the third row by the second translates the second orthogonalized
Gram–Schmidt numerator by the corresponding denominator multiple. -/
theorem IntegerBasis3.secondReductionNumerator_reduceThirdBySecond
    (basis : IntegerBasis3) (coefficient : Int) :
    (basis.reduceThirdBySecond coefficient).secondReductionNumerator =
      basis.secondReductionNumerator -
        coefficient * basis.secondReductionDenominator := by
  rw [show basis.secondReductionDenominator =
      (integerPointSquaredNorm basis.first : Int) *
          (integerPointSquaredNorm basis.second : Int) -
        integerPointDot basis.first basis.second ^ 2 by
    exact integerPointAreaSquared_eq_gram basis.first basis.second]
  simp only [IntegerBasis3.secondReductionNumerator,
    IntegerBasis3.reduceThirdBySecond, integerPointDot,
    IntegerPoint3.sub, IntegerPoint3.smul]
  rw [← integerPointDot_self basis.first,
    ← integerPointDot_self basis.second]
  simp only [integerPointDot]
  ring

/-- Reducing the third row by the first leaves its coefficient along the
second orthogonalized direction unchanged. -/
theorem IntegerBasis3.secondReductionNumerator_reduceThirdByFirst
    (basis : IntegerBasis3) (coefficient : Int) :
    (basis.reduceThirdByFirst coefficient).secondReductionNumerator =
      basis.secondReductionNumerator := by
  simp only [IntegerBasis3.secondReductionNumerator,
    IntegerBasis3.reduceThirdByFirst, integerPointDot,
    IntegerPoint3.sub, IntegerPoint3.smul]
  rw [← integerPointDot_self basis.first]
  simp only [integerPointDot]
  ring

/-- Reducing the third row by the second translates the corresponding
Gram–Schmidt coefficient by precisely that integer. -/
theorem IntegerBasis3.secondGramSchmidtCoefficient_reduceThirdBySecond
    (basis : IntegerBasis3) (coefficient : Int)
    (harea : basis.secondReductionDenominator ≠ 0) :
    IntegerBasis3.secondGramSchmidtCoefficient
        (basis.reduceThirdBySecond coefficient) =
      basis.secondGramSchmidtCoefficient - (coefficient : Rat) := by
  unfold IntegerBasis3.secondGramSchmidtCoefficient
  rw [basis.secondReductionNumerator_reduceThirdBySecond]
  change
    ((basis.secondReductionNumerator -
        coefficient * basis.secondReductionDenominator : Int) : Rat) /
        (basis.secondReductionDenominator : Rat) =
      (basis.secondReductionNumerator : Rat) /
          (basis.secondReductionDenominator : Rat) - (coefficient : Rat)
  push_cast
  rw [sub_div]
  rw [mul_div_cancel_right₀ _ (by exact_mod_cast harea)]

/-- Reducing the third row by the first preserves the second orthogonalized
Gram–Schmidt coefficient. -/
theorem IntegerBasis3.secondGramSchmidtCoefficient_reduceThirdByFirst
    (basis : IntegerBasis3) (coefficient : Int) :
    IntegerBasis3.secondGramSchmidtCoefficient
        (basis.reduceThirdByFirst coefficient) =
      basis.secondGramSchmidtCoefficient := by
  unfold IntegerBasis3.secondGramSchmidtCoefficient
  rw [basis.secondReductionNumerator_reduceThirdByFirst]
  rfl

/-- Reducing the third row by the first translates the direct first-row
coefficient by precisely that integer. -/
theorem IntegerBasis3.thirdFirstGramSchmidtCoefficient_reduceThirdByFirst
    (basis : IntegerBasis3) (coefficient : Int)
    (hnorm : integerPointSquaredNorm basis.first ≠ 0) :
    IntegerBasis3.thirdFirstGramSchmidtCoefficient
        (basis.reduceThirdByFirst coefficient) =
      basis.thirdFirstGramSchmidtCoefficient - (coefficient : Rat) := by
  unfold IntegerBasis3.thirdFirstGramSchmidtCoefficient
  simp only [IntegerBasis3.reduceThirdByFirst]
  have hdot : integerPointDot
      (basis.third.sub (basis.first.smul coefficient)) basis.first =
      integerPointDot basis.third basis.first -
        coefficient * (integerPointSquaredNorm basis.first : Int) := by
    simp only [integerPointDot, IntegerPoint3.sub, IntegerPoint3.smul]
    rw [← integerPointDot_self basis.first]
    simp only [integerPointDot]
    ring
  rw [hdot]
  push_cast
  rw [sub_div]
  rw [mul_div_cancel_right₀ _ (by exact_mod_cast hnorm)]

/-- Second-pair size reduction places the second orthogonalized coefficient in
the nearest-integer half interval. -/
theorem IntegerBasis3.secondGramSchmidtCoefficient_sizeReduceSecondPair
    (basis : IntegerBasis3)
    (harea : basis.secondReductionDenominator ≠ 0) :
    |basis.sizeReduceSecondPair.1.secondGramSchmidtCoefficient| ≤
      (1 : Rat) / 2 := by
  let secondCoefficient := nearestIntegerCoefficient
    basis.secondReductionNumerator basis.secondReductionDenominator
  let afterSecond := basis.reduceThirdBySecond secondCoefficient
  let firstCoefficient := nearestIntegerCoefficient
    (integerPointDot afterSecond.third afterSecond.first)
    (integerPointSquaredNorm afterSecond.first)
  change
    |IntegerBasis3.secondGramSchmidtCoefficient
        (afterSecond.reduceThirdByFirst firstCoefficient)| ≤ _
  rw [afterSecond.secondGramSchmidtCoefficient_reduceThirdByFirst]
  rw [basis.secondGramSchmidtCoefficient_reduceThirdBySecond
    secondCoefficient harea]
  exact abs_sub_round _

/-- Second-pair size reduction also places the direct first-row coefficient in
the nearest-integer half interval. -/
theorem IntegerBasis3.thirdFirstGramSchmidtCoefficient_sizeReduceSecondPair
    (basis : IntegerBasis3)
    (hnorm : integerPointSquaredNorm basis.first ≠ 0) :
    |basis.sizeReduceSecondPair.1.thirdFirstGramSchmidtCoefficient| ≤
      (1 : Rat) / 2 := by
  let secondCoefficient := nearestIntegerCoefficient
    basis.secondReductionNumerator basis.secondReductionDenominator
  let afterSecond := basis.reduceThirdBySecond secondCoefficient
  let firstCoefficient := nearestIntegerCoefficient
    (integerPointDot afterSecond.third afterSecond.first)
    (integerPointSquaredNorm afterSecond.first)
  change
    |IntegerBasis3.thirdFirstGramSchmidtCoefficient
        (afterSecond.reduceThirdByFirst firstCoefficient)| ≤ _
  rw [afterSecond.thirdFirstGramSchmidtCoefficient_reduceThirdByFirst
    firstCoefficient]
  · exact abs_sub_round _
  · simpa [afterSecond, IntegerBasis3.reduceThirdBySecond] using hnorm

/-- Second-pair size reduction leaves the first Gram–Schmidt coefficient
unchanged. -/
theorem IntegerBasis3.firstGramSchmidtCoefficient_sizeReduceSecondPair
    (basis : IntegerBasis3) :
    basis.sizeReduceSecondPair.1.firstGramSchmidtCoefficient =
      basis.firstGramSchmidtCoefficient := rfl

/-- First exact Lovász test with parameter `1/2`. -/
def IntegerBasis3.firstLovasz (basis : IntegerBasis3) : Bool :=
  integerPointSquaredNorm basis.first ≤
    2 * integerPointSquaredNorm basis.second

/-- Second exact Lovász test with parameter `1/2`, written through squared
parallelogram areas to avoid rational Gram–Schmidt values. -/
def IntegerBasis3.secondLovasz (basis : IntegerBasis3) : Bool :=
  integerPointAreaSquared basis.first basis.second ≤
    2 * integerPointAreaSquared basis.first basis.third

/-- Complete exact `δ = 1/2` LLL certificate in dimension three. -/
structure IntegerBasis3.IsReduced (basis : IntegerBasis3) : Prop where
  /-- The second row is size-reduced against the first. -/
  firstSizeReduced :
    |basis.firstGramSchmidtCoefficient| ≤ (1 : Rat) / 2
  /-- The third row is size-reduced against the second orthogonalized row. -/
  secondSizeReduced :
    |basis.secondGramSchmidtCoefficient| ≤ (1 : Rat) / 2
  /-- The third row is size-reduced against the first row. -/
  thirdFirstSizeReduced :
    |basis.thirdFirstGramSchmidtCoefficient| ≤ (1 : Rat) / 2
  /-- First adjacent pair satisfies the exact Lovász test. -/
  firstLovasz : basis.firstLovasz = true
  /-- Second adjacent pair satisfies the exact Lovász test. -/
  secondLovasz : basis.secondLovasz = true

/-- One auditable elementary operation in the fixed-dimensional reducer. -/
inductive LatticeReductionStep3 where
  /-- Size-reduce the second row by the first. -/
  | reduceSecond (coefficient : Int)
  /-- Size-reduce the third row by the second. -/
  | reduceThirdBySecond (coefficient : Int)
  /-- Size-reduce the third row by the first. -/
  | reduceThirdByFirst (coefficient : Int)
  /-- Swap the first and second rows. -/
  | swapFirstSecond
  /-- Swap the second and third rows. -/
  | swapSecondThird
  /-- Fixed-length trace padding after the reducer has terminated. -/
  | pad
  deriving DecidableEq, Repr

/-- Replay one elementary reduction step. -/
def LatticeReductionStep3.apply
    (step : LatticeReductionStep3) (basis : IntegerBasis3) : IntegerBasis3 :=
  match step with
  | .reduceSecond coefficient => basis.reduceSecond coefficient
  | .reduceThirdBySecond coefficient => basis.reduceThirdBySecond coefficient
  | .reduceThirdByFirst coefficient => basis.reduceThirdByFirst coefficient
  | .swapFirstSecond => basis.swapFirstSecond
  | .swapSecondThird => basis.swapSecondThird
  | .pad => basis

/-- Determinant magnitude is invariant under every trace step. -/
theorem LatticeReductionStep3.determinant_natAbs_apply
    (step : LatticeReductionStep3) (basis : IntegerBasis3) :
    (step.apply basis).determinant.natAbs = basis.determinant.natAbs := by
  cases step <;> simp [LatticeReductionStep3.apply]

/-- Every elementary trace step preserves the represented lattice. -/
theorem LatticeReductionStep3.sameLattice_apply
    (step : LatticeReductionStep3) (basis : IntegerBasis3) :
    basis.SameLattice (step.apply basis) := by
  cases step with
  | reduceSecond coefficient =>
      exact IntegerBasis3.sameLattice_reduceSecond basis coefficient
  | reduceThirdBySecond coefficient =>
      exact IntegerBasis3.sameLattice_reduceThirdBySecond basis coefficient
  | reduceThirdByFirst coefficient =>
      exact IntegerBasis3.sameLattice_reduceThirdByFirst basis coefficient
  | swapFirstSecond =>
      exact IntegerBasis3.sameLattice_swapFirstSecond basis
  | swapSecondThird =>
      exact IntegerBasis3.sameLattice_swapSecondThird basis
  | pad =>
      exact IntegerBasis3.SameLattice.refl basis

/-- Replay an auditable reduction trace. -/
def replayLatticeReduction3 (steps : List LatticeReductionStep3)
    (basis : IntegerBasis3) : IntegerBasis3 :=
  steps.foldl (fun current step => step.apply current) basis

/-- Replaying any elementary trace preserves the represented lattice. -/
theorem replayLatticeReduction3_sameLattice
    (steps : List LatticeReductionStep3) (basis : IntegerBasis3) :
    basis.SameLattice (replayLatticeReduction3 steps basis) := by
  induction steps generalizing basis with
  | nil => exact IntegerBasis3.SameLattice.refl basis
  | cons step rest ih =>
      exact (step.sameLattice_apply basis).trans (ih (step.apply basis))

section SealedLatticeReductionTrace

/-- An executable reduction result together with its replayable and arithmetic
traces.  The private constructor prevents clients from attaching a fabricated
low-cost event list to an unrelated output basis. -/
structure LatticeReductionTrace3 where
  private mk ::
  /-- Input ordered basis. -/
  input : IntegerBasis3
  /-- Elementary row-operation trace. -/
  steps : List LatticeReductionStep3
  /-- Arithmetic events generated by the same reduction execution. -/
  arithmetic : List ArithmeticEvent
  /-- Output ordered basis. -/
  output : IntegerBasis3
  /-- The output is obtained by replaying the recorded trace. -/
  output_eq : replayLatticeReduction3 steps input = output

/-- Every replayable trace spans the same integer lattice at both ends. -/
theorem LatticeReductionTrace3.spans (trace : LatticeReductionTrace3) :
    trace.input.SameLattice trace.output := by
  rw [← trace.output_eq]
  exact replayLatticeReduction3_sameLattice trace.steps trace.input

/-- Schoolbook charge derived only from the arithmetic events of a sealed
reduction execution.  Padded replay slots do not contribute to this value. -/
def LatticeReductionTrace3.schoolbookCharge
    (trace : LatticeReductionTrace3) : Nat :=
  arithmeticEventListCharge trace.arithmetic

/-- Largest arithmetic-operand width encountered by a sealed reduction
execution. -/
def LatticeReductionTrace3.maxOperandWidth
    (trace : LatticeReductionTrace3) : Nat :=
  arithmeticEventListMaxOperandWidth trace.arithmetic

end SealedLatticeReductionTrace

/-- Current phase of the fixed three-dimensional LLL state machine. -/
inductive LLLPhase3 where
  /-- Reduce and test the first adjacent pair. -/
  | first
  /-- Reduce and test the second adjacent pair. -/
  | second
  /-- Both adjacent pairs satisfy the reduction conditions. -/
  | done
  deriving DecidableEq, Repr

/-- Executable state of the fixed-dimensional reducer. -/
structure LLLState3 where
  /-- Current ordered basis. -/
  basis : IntegerBasis3
  /-- Adjacent pair currently being processed. -/
  phase : LLLPhase3
  /-- Forward replay trace accumulated so far. -/
  steps : List LatticeReductionStep3

/-! ### Operand-audited execution layer -/

section SealedLLLExecution

/-- Internal coordinate envelope used to audit every operand emitted by the
sealed reducer. -/
private def IntegerPoint3.CoordinatesLe
    (point : IntegerPoint3) (bound : Nat) : Prop :=
  point.1.natAbs ≤ bound ∧ point.2.1.natAbs ≤ bound ∧
    point.2.2.natAbs ≤ bound

private theorem integerPointSquaredNorm_eq_zero_iff_internal
    (point : IntegerPoint3) :
    integerPointSquaredNorm point = 0 ↔ point = (0, 0, 0) := by
  rcases point with ⟨first, second, third⟩
  simp [integerPointSquaredNorm, Prod.ext_iff, and_assoc]

/-- Internal magnitude predicate for the two operands stored in an audited
arithmetic event. -/
private def ArithmeticEvent.OperandsLe
    (event : ArithmeticEvent) (bound : Nat) : Prop :=
  match event with
  | .intAdd left right | .intSub left right | .intMul left right |
      .intLe left right | .intEq left right | .roundedDiv left right =>
      left.natAbs ≤ bound ∧ right.natAbs ≤ bound
  | .natAdd left right | .natSub left right | .natMul left right |
      .natLe left right | .natLt left right | .natEq left right |
      .natMod left right |
      .natDiv left right =>
      left ≤ bound ∧ right ≤ bound
  | .natLog2 value => value ≤ bound
  | .natShiftLeft value amount =>
      amount ≤ bound ∧ value <<< amount ≤ bound

private theorem ArithmeticEvent.operandWidth_le_size_of_operandsLe
    {event : ArithmeticEvent} {bound : Nat}
    (h : event.OperandsLe bound) :
    event.operandWidth ≤ Nat.size bound := by
  cases event <;>
    simp only [ArithmeticEvent.OperandsLe, ArithmeticEvent.operandWidth,
      integerMagnitudeBits] at h ⊢
  all_goals
    first
    | exact max_le (Nat.size_le_size h.1) (Nat.size_le_size h.2)
    | exact Nat.size_le_size h

private theorem ArithmeticEvent.OperandsLe.mono
    {event : ArithmeticEvent} {left right : Nat}
    (h : event.OperandsLe left) (hle : left ≤ right) :
    event.OperandsLe right := by
  cases event
  all_goals simp only [ArithmeticEvent.OperandsLe] at h ⊢
  all_goals
    first
    | exact ⟨h.1.trans hle, h.2.trans hle⟩
    | exact h.trans hle

private theorem arithmeticEventListMaxOperandWidth_le_size_of_operandsLe
    {events : List ArithmeticEvent} {bound : Nat}
    (h : ∀ event ∈ events, event.OperandsLe bound) :
    arithmeticEventListMaxOperandWidth events ≤ Nat.size bound :=
  arithmeticEventListMaxOperandWidth_le fun event hevent =>
    ArithmeticEvent.operandWidth_le_size_of_operandsLe (h event hevent)

private theorem arithmeticEventsOperandsLe_mono
    {events : List ArithmeticEvent} {left right : Nat}
    (h : ∀ event ∈ events, event.OperandsLe left) (hle : left ≤ right) :
    ∀ event ∈ events, event.OperandsLe right := by
  intro event hevent
  exact (h event hevent).mono hle

private theorem arithmeticEventsOperandsLe_append
    {left right : List ArithmeticEvent} {bound : Nat}
    (hleft : ∀ event ∈ left, event.OperandsLe bound)
    (hright : ∀ event ∈ right, event.OperandsLe bound) :
    ∀ event ∈ left ++ right, event.OperandsLe bound := by
  intro event hevent
  rw [List.mem_append] at hevent
  exact hevent.elim (hleft event) (hright event)

private theorem IntegerPoint3.coordinatesLe_of_squaredNorm_le
    (point : IntegerPoint3) {bound : Nat}
    (h : integerPointSquaredNorm point ≤ bound) :
    point.CoordinatesLe bound := by
  have hfirstSquare : point.1.natAbs ^ 2 ≤
      integerPointSquaredNorm point := by
    simp only [integerPointSquaredNorm]
    omega
  have hsecondSquare : point.2.1.natAbs ^ 2 ≤
      integerPointSquaredNorm point := by
    simp only [integerPointSquaredNorm]
    omega
  have hthirdSquare : point.2.2.natAbs ^ 2 ≤
      integerPointSquaredNorm point := by
    simp only [integerPointSquaredNorm]
    omega
  exact ⟨(Nat.le_self_pow (by decide) _).trans (hfirstSquare.trans h),
    (Nat.le_self_pow (by decide) _).trans (hsecondSquare.trans h),
    (Nat.le_self_pow (by decide) _).trans (hthirdSquare.trans h)⟩

private theorem IntegerPoint3.CoordinatesLe.mono
    {point : IntegerPoint3} {left right : Nat}
    (h : point.CoordinatesLe left) (hle : left ≤ right) :
    point.CoordinatesLe right :=
  ⟨h.1.trans hle, h.2.1.trans hle, h.2.2.trans hle⟩

private theorem integerPointDot_natAbs_le_of_coordinatesLe
    {left right : IntegerPoint3} {leftBound rightBound : Nat}
    (hleft : left.CoordinatesLe leftBound)
    (hright : right.CoordinatesLe rightBound) :
    (integerPointDot left right).natAbs ≤
      3 * leftBound * rightBound := by
  have hfirst : (left.1 * right.1).natAbs ≤
      leftBound * rightBound := by
    rw [Int.natAbs_mul]
    exact Nat.mul_le_mul hleft.1 hright.1
  have hsecond : (left.2.1 * right.2.1).natAbs ≤
      leftBound * rightBound := by
    rw [Int.natAbs_mul]
    exact Nat.mul_le_mul hleft.2.1 hright.2.1
  have hthird : (left.2.2 * right.2.2).natAbs ≤
      leftBound * rightBound := by
    rw [Int.natAbs_mul]
    exact Nat.mul_le_mul hleft.2.2 hright.2.2
  calc
    (integerPointDot left right).natAbs ≤
        (left.1 * right.1).natAbs +
          (left.2.1 * right.2.1).natAbs +
            (left.2.2 * right.2.2).natAbs := by
      simp only [integerPointDot]
      exact (Int.natAbs_add_le _ _).trans
        (Nat.add_le_add_right (Int.natAbs_add_le _ _) _)
    _ ≤ leftBound * rightBound + leftBound * rightBound +
          leftBound * rightBound :=
      Nat.add_le_add (Nat.add_le_add hfirst hsecond) hthird
    _ = 3 * leftBound * rightBound := by ring

private theorem integerPointSquaredNorm_le_of_coordinatesLe
    {point : IntegerPoint3} {bound : Nat}
    (h : point.CoordinatesLe bound) :
    integerPointSquaredNorm point ≤ 3 * bound ^ 2 := by
  simp only [integerPointSquaredNorm]
  have hfirst := Nat.pow_le_pow_left h.1 2
  have hsecond := Nat.pow_le_pow_left h.2.1 2
  have hthird := Nat.pow_le_pow_left h.2.2 2
  calc
    point.1.natAbs ^ 2 + point.2.1.natAbs ^ 2 +
        point.2.2.natAbs ^ 2 ≤
      bound ^ 2 + bound ^ 2 + bound ^ 2 :=
        Nat.add_le_add (Nat.add_le_add hfirst hsecond) hthird
    _ = 3 * bound ^ 2 := by ring

private theorem integerPointCross_coordinatesLe
    {left right : IntegerPoint3} {leftBound rightBound : Nat}
    (hleft : left.CoordinatesLe leftBound)
    (hright : right.CoordinatesLe rightBound) :
    (integerPointCross left right).CoordinatesLe
      (2 * leftBound * rightBound) := by
  have component {a b c d : Int}
      (ha : a.natAbs ≤ leftBound) (hb : b.natAbs ≤ rightBound)
      (hc : c.natAbs ≤ leftBound) (hd : d.natAbs ≤ rightBound) :
      (a * b - c * d).natAbs ≤ 2 * leftBound * rightBound := by
    calc
      (a * b - c * d).natAbs ≤
          (a * b).natAbs + (c * d).natAbs := Int.natAbs_sub_le _ _
      _ = a.natAbs * b.natAbs + c.natAbs * d.natAbs := by
        rw [Int.natAbs_mul, Int.natAbs_mul]
      _ ≤ leftBound * rightBound + leftBound * rightBound :=
        Nat.add_le_add (Nat.mul_le_mul ha hb) (Nat.mul_le_mul hc hd)
      _ = 2 * leftBound * rightBound := by ring
  exact ⟨component hleft.2.1 hright.2.2 hleft.2.2 hright.2.1,
    component hleft.2.2 hright.1 hleft.1 hright.2.2,
    component hleft.1 hright.2.1 hleft.2.1 hright.1⟩

private theorem reducePoint_coordinatesLe
    {point direction : IntegerPoint3} {pointBound directionBound : Nat}
    (coefficient : Int) (hpoint : point.CoordinatesLe pointBound)
    (hdirection : direction.CoordinatesLe directionBound) :
    (point.sub (direction.smul coefficient)).CoordinatesLe
      (pointBound + coefficient.natAbs * directionBound) := by
  have component {value δ : Int}
      (hvalue : value.natAbs ≤ pointBound)
      (hdelta : δ.natAbs ≤ directionBound) :
      (value - coefficient * δ).natAbs ≤
        pointBound + coefficient.natAbs * directionBound := by
    calc
      (value - coefficient * δ).natAbs ≤
          value.natAbs + (coefficient * δ).natAbs :=
        Int.natAbs_sub_le _ _
      _ = value.natAbs + coefficient.natAbs * δ.natAbs := by
        rw [Int.natAbs_mul]
      _ ≤ pointBound + coefficient.natAbs * directionBound :=
        Nat.add_le_add hvalue (Nat.mul_le_mul_left _ hdelta)
  exact ⟨component hpoint.1 hdirection.1,
    component hpoint.2.1 hdirection.2.1,
    component hpoint.2.2 hdirection.2.2⟩

private theorem integerPointAreaSquared_le_of_coordinatesLe
    {left right : IntegerPoint3} {bound : Nat}
    (hleft : left.CoordinatesLe bound)
    (hright : right.CoordinatesLe bound) :
    integerPointAreaSquared left right ≤ 12 * bound ^ 4 := by
  have hcross := integerPointCross_coordinatesLe hleft hright
  calc
    integerPointAreaSquared left right =
        integerPointSquaredNorm (integerPointCross left right) := rfl
    _ ≤ 3 * (2 * bound * bound) ^ 2 :=
      integerPointSquaredNorm_le_of_coordinatesLe hcross
    _ = 12 * bound ^ 4 := by ring

set_option maxHeartbeats 800000 in
-- Rational casts and nearest-integer comparison need additional elaboration.
/-- Nearest-integer division by a nonzero integral denominator has magnitude
at most twice that of its numerator.  The larger heartbeat allowance is local
to this cast-heavy rational/integer comparison. -/
theorem nearestIntegerCoefficient_natAbs_le_two_mul
    (numerator denominator : Int) (hdenominator : denominator ≠ 0) :
    (nearestIntegerCoefficient numerator denominator).natAbs ≤
      2 * numerator.natAbs := by
  let quotient : Rat := (numerator : Rat) / (denominator : Rat)
  have hdenominatorNatAbs : 1 ≤ denominator.natAbs :=
    Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hdenominator)
  have hdenominatorRat : (1 : Rat) ≤ |(denominator : Rat)| := by
    rw [show |(denominator : Rat)| = (denominator.natAbs : Rat) by
      simp [Nat.cast_natAbs, Int.cast_abs]]
    exact_mod_cast hdenominatorNatAbs
  have hquotient : |quotient| ≤ (numerator.natAbs : Rat) := by
    dsimp only [quotient]
    rw [abs_div]
    have hnumeratorCast : |(numerator : Rat)| =
        (numerator.natAbs : Rat) := by
      simp [Nat.cast_natAbs, Int.cast_abs]
    rw [hnumeratorCast]
    exact div_le_self (by positivity) hdenominatorRat
  have hroundError :
      |quotient - ((round quotient : Int) : Rat)| ≤ |quotient| := by
    simpa using (round_le quotient 0)
  have hround :
      |((round quotient : Int) : Rat)| ≤ 2 * |quotient| := by
    calc
      |((round quotient : Int) : Rat)| =
          |quotient - (quotient - ((round quotient : Int) : Rat))| := by
        congr 1
        ring
      _ ≤ |quotient| +
          |quotient - ((round quotient : Int) : Rat)| := abs_sub _ _
      _ ≤ |quotient| + |quotient| :=
        add_le_add_right hroundError _
      _ = 2 * |quotient| := by ring
  have hroundNat :
      |((round quotient : Int) : Rat)| ≤ (2 * numerator.natAbs : Nat) := by
    calc
      |((round quotient : Int) : Rat)| ≤
          2 * |quotient| := hround
      _ ≤ 2 * (numerator.natAbs : Rat) :=
        mul_le_mul_of_nonneg_left hquotient (by positivity)
      _ = (2 * numerator.natAbs : Nat) := by norm_num
  have hcast : (((round quotient : Int).natAbs : Nat) : Rat) =
      |((round quotient : Int) : Rat)| := by
    simp [Nat.cast_natAbs, Int.cast_abs]
  rw [← hcast] at hroundNat
  have hroundNat' :
      (round quotient : Int).natAbs ≤ 2 * numerator.natAbs := by
    exact_mod_cast hroundNat
  simpa [nearestIntegerCoefficient, quotient] using hroundNat'

/-- Internal result of one exact arithmetic computation together with the
events produced while computing that very value.  This constructor remains
private to the lattice reducer: public resource claims consume only the sealed
LLL execution traces below. -/
private structure ArithmeticExecution (α : Type) where
  value : α
  events : List ArithmeticEvent

private def intAddExecution (left right : Int) : ArithmeticExecution Int :=
  { value := left + right, events := [.intAdd left right] }

private def intSubExecution (left right : Int) : ArithmeticExecution Int :=
  { value := left - right, events := [.intSub left right] }

private def intMulExecution (left right : Int) : ArithmeticExecution Int :=
  { value := left * right, events := [.intMul left right] }

private def natAddExecution (left right : Nat) : ArithmeticExecution Nat :=
  { value := left + right, events := [.natAdd left right] }

private def natMulExecution (left right : Nat) : ArithmeticExecution Nat :=
  { value := left * right, events := [.natMul left right] }

private def natLeExecution (left right : Nat) : ArithmeticExecution Bool :=
  { value := left ≤ right, events := [.natLe left right] }

private def roundedDivExecution (numerator denominator : Int) :
    ArithmeticExecution Int :=
  { value := nearestIntegerCoefficient numerator denominator
    events := [.roundedDiv numerator denominator] }

@[simp]
private theorem intSubExecution_value (left right : Int) :
    (intSubExecution left right).value = left - right := rfl

@[simp]
private theorem intMulExecution_value (left right : Int) :
    (intMulExecution left right).value = left * right := rfl

@[simp]
private theorem natMulExecution_value (left right : Nat) :
    (natMulExecution left right).value = left * right := rfl

@[simp]
private theorem roundedDivExecution_value (numerator denominator : Int) :
    (roundedDivExecution numerator denominator).value =
      nearestIntegerCoefficient numerator denominator := rfl

/-- Audited exact integer dot product. -/
private def integerPointDotExecution (left right : IntegerPoint3) :
    ArithmeticExecution Int :=
  let first := intMulExecution left.1 right.1
  let second := intMulExecution left.2.1 right.2.1
  let firstTwo := intAddExecution first.value second.value
  let third := intMulExecution left.2.2 right.2.2
  let total := intAddExecution firstTwo.value third.value
  { value := total.value
    events := first.events ++ second.events ++ firstTwo.events ++
      third.events ++ total.events }

/-- Audited exact squared norm.  Taking `natAbs` is a representation view;
the three squarings and two additions are the charged arithmetic. -/
private def integerPointSquaredNormExecution (point : IntegerPoint3) :
    ArithmeticExecution Nat :=
  let first := natMulExecution point.1.natAbs point.1.natAbs
  let second := natMulExecution point.2.1.natAbs point.2.1.natAbs
  let firstTwo := natAddExecution first.value second.value
  let third := natMulExecution point.2.2.natAbs point.2.2.natAbs
  let total := natAddExecution firstTwo.value third.value
  { value := total.value
    events := first.events ++ second.events ++ firstTwo.events ++
      third.events ++ total.events }

/-- Audited exact cross product. -/
private def integerPointCrossExecution (left right : IntegerPoint3) :
    ArithmeticExecution IntegerPoint3 :=
  let firstLeft := intMulExecution left.2.1 right.2.2
  let firstRight := intMulExecution left.2.2 right.2.1
  let first := intSubExecution firstLeft.value firstRight.value
  let secondLeft := intMulExecution left.2.2 right.1
  let secondRight := intMulExecution left.1 right.2.2
  let second := intSubExecution secondLeft.value secondRight.value
  let thirdLeft := intMulExecution left.1 right.2.1
  let thirdRight := intMulExecution left.2.1 right.1
  let third := intSubExecution thirdLeft.value thirdRight.value
  { value := (first.value, second.value, third.value)
    events := firstLeft.events ++ firstRight.events ++ first.events ++
      secondLeft.events ++ secondRight.events ++ second.events ++
      thirdLeft.events ++ thirdRight.events ++ third.events }

/-- Audited squared area, computed by the audited cross product followed by
the audited squared norm. -/
private def integerPointAreaSquaredExecution (left right : IntegerPoint3) :
    ArithmeticExecution Nat :=
  let cross := integerPointCrossExecution left right
  let norm := integerPointSquaredNormExecution cross.value
  { value := norm.value, events := cross.events ++ norm.events }

/-- Audited row update `point - coefficient • direction`. -/
private def reducePointExecution (point direction : IntegerPoint3)
    (coefficient : Int) : ArithmeticExecution IntegerPoint3 :=
  let firstScale := intMulExecution coefficient direction.1
  let first := intSubExecution point.1 firstScale.value
  let secondScale := intMulExecution coefficient direction.2.1
  let second := intSubExecution point.2.1 secondScale.value
  let thirdScale := intMulExecution coefficient direction.2.2
  let third := intSubExecution point.2.2 thirdScale.value
  { value := (first.value, second.value, third.value)
    events := firstScale.events ++ first.events ++
      secondScale.events ++ second.events ++
      thirdScale.events ++ third.events }

@[simp]
private theorem integerPointDotExecution_value
    (left right : IntegerPoint3) :
    (integerPointDotExecution left right).value =
      integerPointDot left right := by
  rfl

@[simp]
private theorem integerPointSquaredNormExecution_value
    (point : IntegerPoint3) :
    (integerPointSquaredNormExecution point).value =
      integerPointSquaredNorm point := by
  simp [integerPointSquaredNormExecution, integerPointSquaredNorm,
    natAddExecution, natMulExecution, pow_two]

@[simp]
private theorem integerPointCrossExecution_value
    (left right : IntegerPoint3) :
    (integerPointCrossExecution left right).value =
