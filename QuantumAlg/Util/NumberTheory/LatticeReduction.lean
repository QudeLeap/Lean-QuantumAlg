  have hpowFiveEight : (bound + 1) ^ 5 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  have hpowSixEight : (bound + 1) ^ 6 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  have hpowSevenEight : (bound + 1) ^ 7 ≤ (bound + 1) ^ 8 :=
    pow_le_pow_right' hbase (by norm_num)
  have hsmall : 3 * (bound + 1) ^ 2 ≤ magnitude := by
    dsimp only [magnitude]
    exact Nat.mul_le_mul (by norm_num) hpowTwoEight
  have hdotEventSmall : 3 * (bound + 1) * (bound + 1) ≤ magnitude := by
    simpa [pow_two, Nat.mul_assoc] using hsmall
  have hareaMagnitude : 12 * (bound + 1) ^ 4 ≤ magnitude := by
    dsimp only [magnitude]
    exact Nat.mul_le_mul (by norm_num) hpowFourEight
  have htwiceAreaMagnitude : 24 * (bound + 1) ^ 4 ≤ magnitude := by
    dsimp only [magnitude]
    exact Nat.mul_le_mul (by norm_num) hpowFourEight
  have hcoordinate : bound ≤ magnitude := by
    have hlinear : bound ≤ (bound + 1) ^ 2 := by
      nlinarith [Nat.zero_le bound]
    exact hlinear.trans (hpowTwoEight.trans
      (Nat.le_mul_of_pos_left _ (by norm_num)))
  have htwo : 2 ≤ magnitude := by
    have hpowPos : 0 < (bound + 1) ^ 8 := by positivity
    dsimp only [magnitude]
    exact (by norm_num : 2 ≤ 256).trans
      (Nat.le_mul_of_pos_right 256 hpowPos)
  have hcurrentFirst :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.first hcurrent.1
  have hcurrentSecond :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.second hcurrent.2.1
  have hcurrentThird :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le basis.third hcurrent.2.2
  have hreducedFirst :=
    IntegerPoint3.coordinatesLe_of_squaredNorm_le
