  have htwiceAreaEvents := natMulExecution_events_operandsLe htwo
    (hsecondArea.trans hareaMagnitude)
  have htwiceSecondArea :
      2 * integerPointAreaSquared
          basis.sizeReduceSecondPair.1.first
          basis.sizeReduceSecondPair.1.third ≤ magnitude := by
    calc
      2 * integerPointAreaSquared
          basis.sizeReduceSecondPair.1.first
          basis.sizeReduceSecondPair.1.third ≤
          2 * (12 * (bound + 1) ^ 4) :=
        Nat.mul_le_mul_left 2 hsecondArea
      _ = 24 * (bound + 1) ^ 4 := by ring
      _ ≤ magnitude := htwiceAreaMagnitude
  have hpassesEvents := natLeExecution_events_operandsLe
    (hfirstArea.trans hareaMagnitude)
    htwiceSecondArea
  have h12 := arithmeticEventsOperandsLe_append hnormFirst hdotThirdSecondEvents
  have h123 := arithmeticEventsOperandsLe_append h12 hscaledDotEvents
  have h1234 := arithmeticEventsOperandsLe_append h123 hdotThirdFirstEvents
  have h12345 := arithmeticEventsOperandsLe_append h1234 hdotSecondFirstEvents
  have h123456 := arithmeticEventsOperandsLe_append h12345 hdotProductEvents
  have h1234567 := arithmeticEventsOperandsLe_append h123456 hnumeratorEvents
  have h12345678 := arithmeticEventsOperandsLe_append h1234567 hdenominatorEvents
  have h123456789 := arithmeticEventsOperandsLe_append
    h12345678 hsecondCoefficientEvents
  have h10 := arithmeticEventsOperandsLe_append h123456789 hreduceSecondEvents
  have h11 := arithmeticEventsOperandsLe_append h10 hdotAfterEvents
  have h12' := arithmeticEventsOperandsLe_append h11 hnormAfterEvents
  have h13 := arithmeticEventsOperandsLe_append h12' hfirstCoefficientEvents
  have h14 := arithmeticEventsOperandsLe_append h13 hreduceFirstEvents
  have h15 := arithmeticEventsOperandsLe_append h14 hfirstAreaEvents
  have h16 := arithmeticEventsOperandsLe_append h15 hsecondAreaEvents
  have h17 := arithmeticEventsOperandsLe_append h16 htwiceAreaEvents
  have h18 := arithmeticEventsOperandsLe_append h17 hpassesEvents
  simpa [secondPairExecution3, secondCoefficient, afterSecond,
    firstCoefficient, IntegerBasis3.secondReductionNumerator,
    IntegerBasis3.secondReductionDenominator,
    IntegerBasis3.sizeReduceSecondPair, roundedDivExecution,
