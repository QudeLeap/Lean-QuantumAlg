module

import QuantumAlg.Init
public import Mathlib.Algebra.QuadraticAlgebra.Basic
public import Mathlib.Algebra.Ring.Subring.Basic
public import Mathlib.Data.Rat.Cast.Defs

/-!
# Exact dyadic cyclotomic arithmetic

The coefficient ring is the subring of rational numbers generated by `1/2`.
Two quadratic extensions represent `(a + b sqrt(2)) + (c + d sqrt(2)) i`.
All four coefficients have canonical rational representations, so equality and
ring arithmetic compute without a quotient normalizer. Subring membership is
proof data and is erased by computation.

This is the representation `Z[1/sqrt(2), i]` from Ross and Selinger,
*Optimal ancilla-free Clifford+T approximation of z-rotations*, Some algebra.
-/

@[expose] public section

namespace QuantumAlg.CliffordT

/-- Dyadic rationals as a subring with canonical rational representatives. -/
def dyadicSubring : Subring ℚ := Subring.closure {(1 / 2 : ℚ)}

/-- The exact coefficient ring `Z[1/2]`. -/
abbrev Dyadic := dyadicSubring

/-- The distinguished dyadic fraction `1/2`. -/
def half : Dyadic := ⟨1 / 2, Subring.subset_closure (by simp)⟩

/-- Real quadratic dyadic numbers, with the second basis vector squaring to two. -/
abbrev DyadicSqrtTwo := QuadraticAlgebra Dyadic 2 0

/-- The exact ring `D[omega] = Z[1/sqrt(2), i]`. -/
abbrev DOmega := QuadraticAlgebra DyadicSqrtTwo (-1) 0

namespace DOmega

/-- The real generator `sqrt(2)`. -/
def sqrtTwo : DOmega := ⟨⟨0, 1⟩, 0⟩

/-- The imaginary generator. -/
def imaginary : DOmega := ⟨0, 1⟩

/-- The positive real scalar `1/sqrt(2)`. -/
def invSqrtTwo : DOmega := ⟨⟨0, half⟩, 0⟩

/-- The primitive eighth root `(1+i)/sqrt(2)`. -/
def ω : DOmega := ⟨⟨0, half⟩, ⟨0, half⟩⟩

lemma sqrtTwo_sq : sqrtTwo * sqrtTwo = 2 := by decide +kernel

lemma imaginary_sq : imaginary * imaginary = -1 := by decide +kernel

lemma invSqrtTwo_sq : invSqrtTwo * invSqrtTwo = ⟨⟨half, 0⟩, 0⟩ := by decide +kernel

lemma omega_sq : ω * ω = imaginary := by decide +kernel

lemma omega_pow_eight : ω ^ 8 = 1 := by decide +kernel

lemma star_omega : star ω = ω ^ 7 := by decide +kernel

end DOmega

end QuantumAlg.CliffordT
