module

import all QuantumAlg.Primitives.EllipticCurve.Arithmetic.P256.Point.Window.Tables.Selection
import all QuantumAlg.Primitives.EllipticCurve.Arithmetic.P256.Residue

/-!
# The actual selected original table column as its ordinary field residue

The certificate comes from the same paid builder and the same returned
Store. Its word is identified with the canonical ordinary P-256 residue
using the original modulus equality. No table or constant is generated by
this mathematical coordinate identity, and the original full row remains
symbolic, including identity row zero.
-/

namespace QuantumAlg.EllipticCurve.PrimeFieldShortWeierstrass.Arithmetic.P256.Point.Window

namespace Tables

noncomputable section

open Execution EncodedBit.WindowLookup ClassicalAlgorithms.EllipticCurve
open ClassicalRoutines.EllipticCurve.WindowTables

attribute [local implicit_reducible] capacity width
attribute [local irreducible] modulus

variable {ctx : RuntimeCtx .quantum} {stream : Fin 2} {width : Nat} {bounded : width ≤ 15}
    {curve : CurveSpec 256} {frame : TableFrame ctx 256 (2 ^ (width + 1))}
    {point : ClassicalAlgorithms.EllipticCurve.Point curve} {store : Store ctx}

/-- The original full-row group column, represented in the same ordinary physical field. -/
def selectedFieldColumn (curve : CurveSpec 256)
    (point : ClassicalAlgorithms.EllipticCurve.Point curve)
    (stream : Fin 2) (width : Nat) (bounded : width ≤ 15) (state : Raw) (column : Fin 5) :
    ZMod modulus :=
  (pointFiveColumns curve ((selectedRow stream width bounded state).val • point) column).val

/-- Every actual selected stored word is exactly the original canonical ordinary residue. -/
lemma selectedWord_residue (sameModulus : curve.field.modulus = modulus)
    (values : TableFrame.TableValue curve frame point store) (column : Fin 5) (state : Raw) :
    QueryInsertion.selectedWord stream width bounded
        (RuntimeTable.tableValue
          (store.read (.storage (frame.arrays.column column).toCStorageRef))) state =
      Residue.word (selectedFieldColumn curve point stream width bounded state column) := by
  let _ : NeZero curve.field.modulus :=
    ⟨Nat.ne_of_gt (ClassicalAlgorithms.Modular.modulusSpec_modulus_pos curve.field)⟩
  have canonical :
      (pointFiveColumns curve ((selectedRow stream width bounded state).val • point) column).val <
        modulus := by
    rw [← sameModulus]
    exact ZMod.val_lt _
  apply Fin.ext
  rw [selectedWord_value values column state]
  change (pointFiveWords curve ((selectedRow stream width bounded state).val • point)
    column).toNat =
    (((pointFiveColumns curve ((selectedRow stream width bounded state).val • point)
      column).val : ZMod modulus)).val
  rw [pointFiveWords_toNat, ZMod.val_natCast_of_lt canonical]

end

end Tables

end QuantumAlg.EllipticCurve.PrimeFieldShortWeierstrass.Arithmetic.P256.Point.Window
