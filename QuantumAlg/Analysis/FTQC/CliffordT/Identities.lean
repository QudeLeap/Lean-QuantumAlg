module

import QuantumAlg.Init
public import QuantumAlg.Analysis.FTQC.CliffordT.Ring
public import QuantumAlg.Components.Gates.SquareRootX
public import Mathlib.Data.Fintype.Pi
import all QuantumAlg.Analysis.FTQC.CliffordT.Word
import all QuantumAlg.Components.Gates
import all QuantumAlg.Components.Gates.Operator
import all QuantumAlg.Components.Gates.Rotation.Operator
import all QuantumAlg.Core.Base.Gate.Unitary

/-!
# Phase-exact elementary Clifford+T words

Words execute from left to right. The Pauli identities and adjoint phase gates
follow the standard single-qubit conventions of Nielsen and Chuang, Chapter 4.
Every realization uses the circuit generated by the very same word.
-/

@[expose] public section

namespace QuantumAlg.CliffordT

open Gate

/-- Pauli X, by Hadamard conjugation of Z. -/
def xWord : List Letter := [.h, .s, .s, .h]

/-- Pauli Z as two quarter-turn phase gates. -/
def zWord : List Letter := [.s, .s]

/-- Pauli Y as S X S-dagger, in execution order. -/
def yWord : List Letter := [.s, .s, .s] ++ xWord ++ [.s]

/-- Inverse quarter-turn phase gate. -/
def sDaggerWord : List Letter := [.s, .s, .s]

/-- Inverse eighth-turn phase gate, with one T and three S gates. -/
def tDaggerWord : List Letter := [.t, .s, .s, .s]

/-- Principal square root of X, including the phase of H S H. -/
def sqrtXWord : List Letter := [.h, .s, .h]

/-- Conjugate a word by Hadamard, retaining its execution order. -/
def hadamardConj (w : List Letter) : List Letter := [.h] ++ w ++ [.h]

noncomputable section

lemma hadamardConj_evalOp (w : List Letter) :
    evalOp (hadamardConj w) = Letter.h.op * evalOp w * Letter.h.op := by
  simp [hadamardConj, evalOp_append, mul_assoc]

lemma zWord_evalOp : evalOp zWord = ZOp := by
  simpa [zWord, evalOp, Letter.op] using SOp_mul_SOp

lemma sDaggerWord_evalOp : evalOp sDaggerWord = star SOp := by
  rw [star_SOp]
  simp [sDaggerWord, evalOp, Letter.op, pow_succ, mul_assoc]

lemma tDaggerWord_evalOp : evalOp tDaggerWord = star TOp := by
  rw [star_TOp]
  have hs : SOp = TOp ^ 2 := by rw [sq, TOp_mul_TOp]
  simp only [tDaggerWord, evalOp, Letter.op, one_mul, hs]
  simpa only [← pow_add] using (pow_succ TOp 6).symm

private lemma xWord_ring :
    evalRing xWord = (fun i j => if i = j then 0 else 1) := by
  funext i j
  fin_cases i <;> fin_cases j <;> decide +kernel

lemma xWord_evalOp : evalOp xWord = XOp := by
  apply Subtype.ext
  rw [evalOp_eq_toComplexMat, xWord_ring]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [toComplexMat, Matrix.map, XOp, UnitaryOperator.ofPerm]

lemma yWord_evalOp : evalOp yWord = YOp := by
  have hs : evalOp [.s, .s, .s] = star SOp := sDaggerWord_evalOp
  simp only [yWord, evalOp_append, evalOp_singleton, Letter.op_s, xWord_evalOp, hs]
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [SOp, XOp, YOp, UnitaryOperator.ofPerm, Matrix.mul_apply, Matrix.star_apply]

private lemma sqrtXWord_ring :
    evalRing sqrtXWord =
      (fun i j => ⟨⟨half, 0⟩, ⟨if i = j then half else -half, 0⟩⟩) := by
  funext i j
  fin_cases i <;> fin_cases j <;> decide +kernel

lemma sqrtXWord_evalOp : evalOp sqrtXWord = sqrtXOp := by
  apply Subtype.ext
  rw [evalOp_eq_toComplexMat, sqrtXWord_ring]
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [toComplexMat, Matrix.map, DOmega.toComplex, DyadicSqrtTwo.toReal,
      half, sqrtXOp, Complex.ext_iff, Complex.div_re, Complex.div_im]

/-- Convert a proved word identity into an exact strict-model realization. -/
def exactWord (oracles : OracleModel) {U : UnitaryOperator (Qubits 1)}
    (w : List Letter) (h : evalOp w = U) :
    UnitaryCircuit.ExactRealization CliffordTGate.model oracles layout
      (fun _ => physicalOperator U) where
  circuit := ofWord oracles w
  matrix_eq := by intro environment; rw [ofWord_matrix, h]

/-- Exact Clifford realization of X. -/
def xExact (oracles : OracleModel) := exactWord oracles xWord xWord_evalOp

/-- Exact Clifford realization of Y. -/
def yExact (oracles : OracleModel) := exactWord oracles yWord yWord_evalOp

/-- Exact Clifford realization of Z. -/
def zExact (oracles : OracleModel) := exactWord oracles zWord zWord_evalOp

/-- Exact Clifford realization of S-dagger. -/
def sDaggerExact (oracles : OracleModel) := exactWord oracles sDaggerWord sDaggerWord_evalOp

/-- Exact Clifford+T realization of T-dagger. -/
def tDaggerExact (oracles : OracleModel) := exactWord oracles tDaggerWord tDaggerWord_evalOp

/-- Exact Clifford realization of the phase-exact square root of X. -/
def sqrtXExact (oracles : OracleModel) := exactWord oracles sqrtXWord sqrtXWord_evalOp

end

end QuantumAlg.CliffordT
