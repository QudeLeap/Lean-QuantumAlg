module

import all QuantumAlg.Components.Encoded.BitGates.WindowLookup.OneHot.Resources
import all QuantumAlg.Components.GateModel.Algorithm.Adjoint.Resources
import all QuantumAlg.Components.GateModel.Algorithm.Adjoint.Trace
import all QuantumAlg.Core.Base.Tensor.Reference

/-!
# Actual native inverse of the binary-to-unary program

The inverse is generated by reversing the original oracle-free construction
and executing the available native inverse of every original gate. Parallel
cleanup layers remain parallel. The trace is exactly reversed, and the
operator inverse holds beside an arbitrary external reference on all inputs.
-/

namespace QuantumAlg.EncodedBit.WindowLookup.UnaryFrame

noncomputable section

open scoped Kronecker

variable {Data : Type} {encoding : BinaryLabelEncoding Data} {width : Nat}

/-- Reverse the actual pure native unary program, using the default model's actual inverses. -/
def uncomputeProgram (frame : UnaryFrame encoding width) (physical : QubitLayout encoding.width) :
    UnitaryCircuit AlgorithmGate.model .empty physical.toQuantum :=
  (frame.program physical .empty).dagger (AlgorithmGate.oracleFreeAdjoints .empty)

/-- The inverse has the exact adjoint matrix of the same original actual program. -/
lemma uncomputeProgram_matrix (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width) :
    (frame.uncomputeProgram physical).matrix OracleModel.emptyInterpretation =
      star ((frame.program physical .empty).matrix OracleModel.emptyInterpretation) :=
  UnitaryCircuit.dagger_matrix _ _ _

/-- Every native inverse occurrence is paid and retains the original reversed event trace. -/
lemma uncomputeProgram_eventTrace (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width) :
    (frame.uncomputeProgram physical).eventTrace =
      (frame.program physical .empty).eventTrace.reverse :=
  AlgorithmGate.oracleFreeAdjoints_eventTrace _

/-- The actual inverse retains every original native coordinate multiplicity. -/
lemma uncomputeProgram_event_count (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width)
    (focus : Resource.Event (.quantum AlgorithmGate.model .empty)) :
    ResourcePool.count focus (frame.uncomputeProgram physical).eventCost =
      ResourcePool.count focus (frame.program physical .empty).eventCost := by
  rw [← UnitaryCircuit.ofList_eventTrace_eq_eventCost (frame.uncomputeProgram physical),
    ← UnitaryCircuit.ofList_eventTrace_eq_eventCost (frame.program physical .empty),
    frame.uncomputeProgram_eventTrace, ResourcePool.count_ofList, ResourcePool.count_ofList,
    List.count_reverse]

/-- Native inversion preserves the original quantum duration of every dependency. -/
lemma uncomputeProgram_quantumTime (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width) :
    (frame.uncomputeProgram physical).evaluatedEventDepth Resource.Event.quantumDuration =
      (frame.program physical .empty).evaluatedEventDepth Resource.Event.quantumDuration := by
  apply UnitaryCircuit.dagger_evaluatedEventDepth
    (frame.program physical .empty) (AlgorithmGate.oracleFreeAdjoints .empty)
    Resource.Event.quantumDuration Resource.Event.quantumDuration
  · intro count layout application
    rfl
  · intro count layout application
    exact False.elim (OracleModel.Occurrence.no_empty_oracle_occurrence application.occurrence)

/-- The same inverse and preparation matrices cancel exactly, including global phase. -/
lemma uncomputeProgram_mul_program (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width) :
    ((frame.uncomputeProgram physical).matrix OracleModel.emptyInterpretation :
      HilbertOperator physical.toQuantum.register) *
        ((frame.program physical .empty).matrix OracleModel.emptyInterpretation :
          HilbertOperator physical.toQuantum.register) = 1 := by
  rw [frame.uncomputeProgram_matrix]
  exact Matrix.UnitaryGroup.star_mul_self _

/-- Extending the actual inverse by an untouched reference retains the exact inverse law. -/
lemma uncomputeProgram_reference_after_program (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width) (Reference : Register)
    (state : HilbertVector (Register.prod physical.toQuantum.register Reference)) :
    HilbertOperator.applyVec
        (((frame.uncomputeProgram physical).matrix OracleModel.emptyInterpretation :
          HilbertOperator physical.toQuantum.register) ⊗ₖ (1 : HilbertOperator Reference))
        (HilbertOperator.applyVec
          (((frame.program physical .empty).matrix OracleModel.emptyInterpretation :
            HilbertOperator physical.toQuantum.register) ⊗ₖ (1 : HilbertOperator Reference))
              state) =
      state := by
  rw [← HilbertOperator.mul_applyVec, HilbertOperator.kronecker_identity_mul,
    frame.uncomputeProgram_mul_program, Matrix.one_kronecker_one, HilbertOperator.one_applyVec]

/-- Preparing and restoring unary controls each cost the actual original non-root position count. -/
lemma uncomputeProgram_toffoli_count (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width) :
    ResourcePool.count (model := .quantum AlgorithmGate.model .empty) (.gate .toffoli)
      (frame.uncomputeProgram physical).eventCost = 2 ^ width - 1 := by
  rw [frame.uncomputeProgram_event_count, frame.program_toffoli_count]

/-- Every inverse cleanup CNOT remains an actual charged native instruction. -/
lemma uncomputeProgram_cnot_count (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width) :
    ResourcePool.count (model := .quantum AlgorithmGate.model .empty) (.gate .cnot)
      (frame.uncomputeProgram physical).eventCost = 2 ^ width - 1 := by
  rw [frame.uncomputeProgram_event_count, frame.program_cnot_count]

/-- Reversing every original dependency preserves the parallel unary preparation depth bound. -/
lemma uncomputeProgram_quantumTime_le (frame : UnaryFrame encoding width)
    (physical : QubitLayout encoding.width) :
    (frame.uncomputeProgram physical).evaluatedEventDepth Resource.Event.quantumDuration ≤
      2 ^ width + width := by
  rw [frame.uncomputeProgram_quantumTime]
  exact frame.program_quantumTime_le physical .empty

end

end QuantumAlg.EncodedBit.WindowLookup.UnaryFrame
