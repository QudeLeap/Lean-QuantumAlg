/-!
# Time evolution as an oracle

Time-independent evolution under a Hamiltonian `H` is the matrix exponential
`timeEvolutionOp H t = exp (-i t H)` [Lin22, trotter.tex:3]; for Hermitian `H`
it is unitary and bundled as `timeEvolution H t`.

Problem statements that assume access to time evolution (phase estimation,
ground-state preparation and energy estimation through `e^{-iHt}` queries)
treat it as an oracle in the same way block encodings and supplied unitaries
are treated: `TimeEvolutionOracle` owns one opaque subroutine coordinate per
register width, and `TimeEvolutionOracle.program H t` is the one-query circuit
whose matrix is `timeEvolution H t`. Costing a query in elementary gates is a
separate compilation statement (product formulas live in `QuantumAlg.Analysis`).
-/

@[expose] public section

namespace QuantumAlg

noncomputable section

/-- Raw time-evolution operator generated by a time-independent Hamiltonian. -/
def timeEvolutionOp {R : Register} (H : HilbertOperator R) (t : ℝ) : HilbertOperator R :=
  NormedSpace.exp ((-(Complex.I * (t : ℂ))) • H)

set_option maxHeartbeats 800000 in
-- Matrix-exponential unitarity needs extra simplifier/search budget here.
/-- Time evolution under a Hermitian Hamiltonian is unitary. -/
theorem timeEvolutionOp_mem_unitaryGroup {R : Register} {H : HilbertOperator R}
    (hH : H ∈ {A : HilbertOperator R | A.IsHermitian}) (t : ℝ) :
    timeEvolutionOp H t ∈ Matrix.unitaryGroup R.Index ℂ := by
  rw [timeEvolutionOp, Matrix.mem_unitaryGroup_iff]
  have hskew : ((-(Complex.I * (t : ℂ))) • H) ∈ skewAdjoint (HilbertOperator R) := by
    apply IsSelfAdjoint.smul_mem_skewAdjoint
    · rw [skewAdjoint.mem_iff]
      simp [mul_comm]
    · exact hH.isSelfAdjoint
  let A : HilbertOperator R := (-(Complex.I * (t : ℂ))) • H
  have hA : A ∈ skewAdjoint (HilbertOperator R) := by
    simpa [A] using hskew
  have hA_conjTranspose : A.conjTranspose = -A := by
    have hstar := skewAdjoint.mem_iff.mp hA
    simpa [Matrix.star_eq_conjTranspose] using hstar
  change NormedSpace.exp A * star (NormedSpace.exp A) = 1
  rw [Matrix.star_eq_conjTranspose, ← Matrix.exp_conjTranspose, hA_conjTranspose]
  rw [← Matrix.exp_add_of_commute A (-A) ((Commute.refl A).neg_right),
    add_neg_cancel, NormedSpace.exp_zero]

/-- Time evolution generated by a Hamiltonian, bundled as a unitary operator. -/
def timeEvolution {R : Register} (H : Hamiltonian R) (t : ℝ) : UnitaryOperator R :=
  UnitaryOperator.ofMatrix (timeEvolutionOp (H : HilbertOperator R) t)
    (timeEvolutionOp_mem_unitaryGroup H.2 t)

@[simp]
theorem coe_timeEvolution {R : Register} (H : Hamiltonian R) (t : ℝ) :
    ((timeEvolution H t : UnitaryOperator R) : HilbertOperator R)
      = timeEvolutionOp (H : HilbertOperator R) t :=
  rfl

/-! ## One-parameter group laws -/

@[simp]
theorem timeEvolutionOp_zero {R : Register} (H : HilbertOperator R) :
    timeEvolutionOp H 0 = 1 := by
  simp [timeEvolutionOp]

theorem timeEvolutionOp_add {R : Register} (H : HilbertOperator R) (s t : ℝ) :
    timeEvolutionOp H (s + t) = timeEvolutionOp H s * timeEvolutionOp H t := by
  unfold timeEvolutionOp
  have hsplit : (-(Complex.I * ((s + t : ℝ) : ℂ))) • H =
      (-(Complex.I * (s : ℂ))) • H + (-(Complex.I * (t : ℂ))) • H := by
    rw [← add_smul]
    congr 1
    push_cast
    ring
  rw [hsplit]
  exact Matrix.exp_add_of_commute _ _ (((Commute.refl H).smul_left _).smul_right _)

@[simp]
theorem timeEvolution_zero {R : Register} (H : Hamiltonian R) : timeEvolution H 0 = 1 :=
  Subtype.ext (timeEvolutionOp_zero (H : HilbertOperator R))

theorem timeEvolution_add {R : Register} (H : Hamiltonian R) (s t : ℝ) :
    timeEvolution H (s + t) = timeEvolution H s * timeEvolution H t :=
  Subtype.ext (timeEvolutionOp_add (H : HilbertOperator R) s t)

/-- Evolving backwards in time is the adjoint evolution. -/
theorem timeEvolution_neg {R : Register} (H : Hamiltonian R) (t : ℝ) :
    timeEvolution H (-t) = star (timeEvolution H t) := by
  rw [Unitary.star_eq_inv]
  apply eq_inv_of_mul_eq_one_right
  rw [← timeEvolution_add, add_neg_cancel, timeEvolution_zero]

theorem timeEvolution_star {R : Register} (H : Hamiltonian R) (t : ℝ) :
    star (timeEvolution H t) = timeEvolution H (-t) :=
  (timeEvolution_neg H t).symm

/-- Evolving for `n` equal periods is the `n`-th power of one period. -/
theorem timeEvolution_nat_mul {R : Register} (H : Hamiltonian R) (n : ℕ) (t : ℝ) :
    timeEvolution H (n * t) = timeEvolution H t ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, ← ih, ← timeEvolution_add]
      congr 1
      push_cast
      ring

end

end QuantumAlg

end

/-! ## The oracle declaration -/

namespace QuantumAlg.TimeEvolutionOracle

noncomputable section

/-- Declaration-owned time-evolution query label, parameterized by its system width. -/
public def label (width : Nat) : Resource.SubroutineLabel :=
  { family := "time-evolution", name := "hamiltonian", parameters := [width] }

/-- Native coordinate of one time-evolution query. -/
public def event (width : Nat) : Resource.Event .quantum :=
  .quantumSubroutine (label width).quantum

/-- Native coordinate obtained by adding an actual dimension-two control. -/
public def controlledEvent (width : Nat) : Resource.Event .quantum :=
  (event width).controlForDimension 2

/-- One time-evolution declaration at caller-supplied physical systems. -/
def leafAt {width : Nat} (H : Hamiltonian (Qubits width)) (t : ℝ) (systems : List Nat) :
    UnitaryLeaf (Qubits width) :=
  UnitaryLeaf.subroutine (label width) systems (timeEvolution H t)

/-- The time-evolution query on its complete canonical physical input word. -/
public def program {width : Nat} (H : Hamiltonian (Qubits width)) (t : ℝ) :
    UnitaryCircuit (Qubits width) :=
  UnitaryCircuit.ofLeaf (leafAt H t (List.range width)) List.nodup_range

theorem program_matrix {width : Nat} (H : Hamiltonian (Qubits width)) (t : ℝ) :
    (program H t).matrix = timeEvolution H t := rfl

theorem program_physicalIdx {width : Nat} (H : Hamiltonian (Qubits width)) (t : ℝ) :
    (program H t).physical_idx = List.range width := rfl

theorem program_eventTrace {width : Nat} (H : Hamiltonian (Qubits width)) (t : ℝ) :
    (program H t).eventTrace = [event width] := rfl

theorem program_eventCost {width : Nat} (H : Hamiltonian (Qubits width)) (t : ℝ) :
    (program H t).eventCost = ResourcePool.singleton (event width) := rfl

theorem program_event_count {width : Nat} (H : Hamiltonian (Qubits width)) (t : ℝ) :
    ResourcePool.count (event width) (program H t).eventCost = 1 := by
  rw [program_eventCost H t, ResourcePool.count_singleton_self]

end

end QuantumAlg.TimeEvolutionOracle
