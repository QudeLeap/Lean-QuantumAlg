module

public import QuantumAlg.Algorithms.FiniteCyclicDLP.Order.Oracle
import all QuantumAlg.Algorithms.FiniteCyclicDLP.Order.Oracle
import all QuantumAlg.Util.FiniteCyclicDLP
import all Mathlib.GroupTheory.OrderOfElement

/-!
# The generated finite subgroup used by the binary DLP implementation

The supplied ambient group need not have order `N`: only its chosen generator
does. The execution therefore represents the cyclic subgroup generated by that
element. Inclusion preserves the entire source action and the original secret
witness. This is an internal representation, not an extra cyclicity hypothesis
on the caller's group [Sho95, source.tex:1704-1784].
-/

namespace QuantumAlg.FiniteCyclicDLP.Binary

noncomputable section

universe u

variable {G : Type u} [Group G]

/-- The group actually visited by the identity-initialized DLP oracle. -/
public abbrev Carrier (P : KnownOrderProblem G) := Subgroup.zpowers P.generator

/-- Finite order supplies a finite carrier without enumerating the ambient group. -/
public def carrierEquiv (P : KnownOrderProblem G) : Fin P.order ≃ Carrier P :=
  (finCongr P.order_eq_orderOf).trans
    (finEquivZPowers (orderOf_ne_zero_iff.mp
      (P.order_eq_orderOf ▸ P.order_ne_zero)))

/-- The generated subgroup is finite even when no ambient enumeration is selected. -/
public instance carrierFintype (P : KnownOrderProblem G) : Fintype (Carrier P) :=
  Fintype.ofEquiv (Fin P.order) (carrierEquiv P)

/-- Its cardinality is the known generator order, including order one. -/
public lemma carrier_card (P : KnownOrderProblem G) :
    Fintype.card (Carrier P) = P.order := by
  exact (Fintype.card_congr (carrierEquiv P)).symm.trans (Fintype.card_fin P.order)

/-- The original known-order instance restricted to its invariant cyclic subgroup. -/
@[expose] public def subgroupProblem (P : KnownOrderProblem G) :
    KnownOrderProblem (Carrier P) where
  generator := ⟨P.generator, Subgroup.mem_zpowers P.generator⟩
  target := ⟨P.target, P.target_mem_zpowers⟩
  target_mem_zpowers := by
    rcases P.target_mem_zpowers with ⟨power, same⟩
    exact ⟨power, Subtype.ext same⟩
  order := P.order
  order_eq_orderOf := by simpa using P.order_eq_orderOf
  order_ne_zero := P.order_ne_zero

/-- The representation change retains the exact known order. -/
@[simp] public lemma subgroupProblem_order (P : KnownOrderProblem G) :
    (subgroupProblem P).order = P.order := rfl

/-- The subgroup generator is exactly the supplied ambient generator. -/
@[simp] public lemma subgroupProblem_generator (P : KnownOrderProblem G) :
    ((subgroupProblem P).generator : G) = P.generator := rfl

/-- The subgroup target is exactly the supplied ambient target. -/
@[simp] public lemma subgroupProblem_target (P : KnownOrderProblem G) :
    ((subgroupProblem P).target : G) = P.target := rfl

/-- Multiplication in the encoding carrier has the original full source action. -/
@[simp] public lemma subgroupProblem_multiplier (P : KnownOrderProblem G)
    (left right : Nat) :
    ((subgroupProblem P).toSourceScope.oracleMultiplier left right : G) =
      P.toSourceScope.oracleMultiplier left right := by
  simp only [SourceScope.oracleMultiplier, subgroupProblem, Subgroup.coe_mul,
    Subgroup.coe_pow, Subgroup.coe_inv]

/-- Inclusion identifies every complete subgroup oracle basis with its original meaning. -/
@[expose] public def ambientBasis (P : KnownOrderProblem G) :
    OrderOracle.LogicalBasis (subgroupProblem P) → OrderOracle.LogicalBasis P :=
  fun state => (state.1, state.2.val)

/-- Inclusion never identifies two different source states. -/
public lemma ambientBasis_injective (P : KnownOrderProblem G) :
    Function.Injective (ambientBasis P) := by
  intro left right same
  change (left.1, left.2.val) = (right.1, right.2.val) at same
  apply Prod.ext
  · exact congrArg (fun state : OrderOracle.LogicalBasis P => state.1) same
  · exact Subtype.ext
      (congrArg (fun state : OrderOracle.LogicalBasis P => state.2) same)

/-- The original and internally represented group actions commute exactly with inclusion. -/
public lemma ambientBasis_action (P : KnownOrderProblem G)
    (state : OrderOracle.LogicalBasis (subgroupProblem P)) :
    ambientBasis P (OrderOracle.logicalAction (subgroupProblem P) state) =
      OrderOracle.logicalAction P (ambientBasis P state) := by
  simp only [ambientBasis, OrderOracle.logicalAction, Subgroup.coe_mul,
    subgroupProblem_multiplier]

end

end QuantumAlg.FiniteCyclicDLP.Binary
